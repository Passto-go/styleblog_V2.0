# 复制本文件为 .env 并填入你的 Supabase 项目值
# 在 Supabase 后台 → Project Settings → API 获取
# 注意：URL 不要带 /rest/v1/ 后缀
PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# 站点对外地址（可选）：用于生成正确的 sitemap / RSS / canonical 链接
# 不填则用 astro.config.mjs 里的默认值；部署到 Cloudflare Pages 后，
# 建议在部署后台环境变量里设为 https://<项目名>.pages.dev
PUBLIC_SITE_URL=

# 文章加密功能的解锁签名密钥（服务端专用，不会进入客户端包）
# 用途：对「已解锁」cookie 做 HMAC-SHA256 签名，防止伪造解锁状态
# 生成：openssl rand -hex 32
# 注意：本地开发填在 .env；生产环境必须在 Cloudflare Pages 后台
# （设置 → 环境变量）添加同名变量，且不要加 PUBLIC_ 前缀
UNLOCK_SECRET=

# Google Analytics 4 衡量 ID（形如 G-XXXXXXXXXX）
# 留空则不加载 GA、不显示同意横幅（统计完全交给 Cloudflare Web Analytics）
# 注意：配了此变量后，访客同意前不会加载 GA 脚本；同意结果存于浏览器 localStorage
PUBLIC_GA_ID=

# 说明：站点为 SSR（Cloudflare Pages Functions）模式——
# 文章写在 Supabase，每请求现查，后台发布后即时生效，
# 因此不再需要「构建钩子 / Deploy Hook」那套触发重建的机制。
