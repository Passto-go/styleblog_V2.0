<style>
  /* 目录改为右侧抽屉后，正文回到接近全宽；860px 兼顾阅读行长与宽表格 */
  .privacy-page { max-width: 860px; }

  .privacy-head { margin-bottom: 2rem; }
  .one-liner {
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.8rem 1rem;
    color: var(--text);
    font-size: 15px;
    line-height: 1.7;
    margin: 0 0 1rem;
  }
  .updated {
    color: var(--muted);
    font-size: 0.875rem;
    margin: 0;
  }

  /* 目录触发按钮：贴右侧中部，默认只露竖排标签，不占正文空间 */
