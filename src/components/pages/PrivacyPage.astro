  /* 窄屏：表格收紧内边距与字号；宽表（如 Cookie 表）恢复自动列宽并横向滚动 */
  @media (max-width: 600px) {
    .prose table { font-size: 14px; }
    .prose th, .prose td { padding: 9px 10px; }
