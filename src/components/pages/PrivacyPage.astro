  .prose table.table-wide { table-layout: fixed; }
  .prose table.table-wide th:nth-child(1),
  .prose table.table-wide td:nth-child(1) { width: 23%; }
  .prose table.table-wide th:nth-child(2),
  .prose table.table-wide td:nth-child(2) { width: 13%; }
  .prose table.table-wide th:nth-child(3),
