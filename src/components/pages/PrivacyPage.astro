---
import Base from '../../layouts/Base.astro';

const { lang } = Astro.props;
const EMAIL = 'intl1024@outlook.com';
const MAILTO = `mailto:${EMAIL}?subject=${encodeURIComponent(lang === 'zh' ? '隐私相关事宜' : 'Privacy inquiry')}`;
const lastUpdated = lang === 'zh' ? '最后更新：2026 年 11 月 7 日' : 'Last updated: 2026-11-07';

// 目录（Table of Contents）：章节锚点中英文共用 id，标题按语言展示。
// 参考 Cloudflare 隐私政策的左固定目录 + 右正文形态。
const TOC = [
  { id: 'collect',    zh: '一、本站收集的信息',     en: '1. Information collected' },
  { id: 'use',        zh: '二、每项信息的用途',     en: '2. How each item is used' },
  { id: 'watermark',  zh: '三、关于页面水印',       en: '3. About the page watermark' },
  { id: 'cookies',    zh: '四、Cookie 与浏览器本地存储', en: '4. Cookies and local storage' },
  { id: 'thirdparty', zh: '五、涉及哪些第三方服务', en: '5. Third-party services involved' },
  { id: 'analytics',  zh: '六、关于统计与访客的选择', en: '6. Analytics and visitors’ choices' },
  { id: 'retention',  zh: '七、数据保存期限',       en: '7. Data retention periods' },
  { id: 'rights',     zh: '八、访客的权利与行使方式', en: '8. Visitors’ rights and how to exercise them' },
  { id: 'crossborder',zh: '九、跨境传输与未成年人',   en: '9. Cross-border transfers and minors' },
  { id: 'changes',    zh: '十、本说明的变更',       en: '10. Changes to this notice' },
];

const title = lang === 'zh' ? '隐私说明' : 'Privacy Policy';
const leadZh = '本站（吾道一以贯之）为个人博客。本说明载明本站处理访客个人信息的方式，包括收集的信息范围、处理目的、是否向第三方提供、保存期限，以及访客就其个人信息享有的权利。';
const leadEn = 'This site (The Way, One Thread) is a personal blog. This notice sets out how the site processes visitors’ personal information, including the categories of information collected, the purposes of processing, whether information is provided to third parties, retention periods, and the rights visitors hold in respect of their information.';
const oneLinerZh = '本站不进行跨站追踪、用户画像、广告投放或数据交易。访客信息仅在你主动发表评论时产生；页面溯源水印会在渲染时读取 IP 地址与设备时区，但该信息不写入数据库、不对外传输。此外，加密文章的解锁与部分接口的访问频率限制会将 IP 地址临时写入数据库（详见第五节），保存期限见第七节。';
const oneLinerEn = 'This site does not engage in cross-site tracking, user profiling, advertising, or data trading. Visitor information is generated only when you voluntarily post a comment. The page watermark reads your IP address and device time zone at render time, but does not store or transmit this information. Separately, unlock attempts on protected posts and rate limiting on certain endpoints write your IP address temporarily to the database (see Section 5); retention periods are set out in Section 7.';
const tocLabel = lang === 'zh' ? '目录' : 'Contents';
---

<Base lang={lang} title={title} description={lang === 'zh' ? leadZh : leadEn}>
  <section class="page privacy-page">
    <header class="privacy-head">
      <h1 class="page-title">{title}</h1>
      <p class="lead">{lang === 'zh' ? leadZh : leadEn}</p>
      <p class="one-liner">{lang === 'zh' ? oneLinerZh : oneLinerEn}</p>
      <p class="updated">{lastUpdated}</p>
    </header>

    <!-- 目录：默认隐藏，点击右侧抽屉滑出（类似 Markdown 编辑器大纲） -->
    <button class="toc-fab" type="button" aria-controls="privacy-toc" aria-expanded="false" aria-label={tocLabel}>
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2.5 4h11M2.5 8h11M2.5 12h7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      <span>{tocLabel}</span>
    </button>

    <div class="toc-overlay" data-toc-close hidden></div>

    <aside class="toc-drawer" id="privacy-toc" aria-hidden="true" aria-label={tocLabel}>
      <div class="toc-head">
        <span class="toc-head-title">{tocLabel}</span>
        <button class="toc-close" type="button" aria-label={lang === 'zh' ? '关闭' : 'Close'}>
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        </button>
      </div>
      <nav class="toc-nav">
        <ol class="toc-list">
          {TOC.map((t) => (
            <li><a href={`#${t.id}`}>{lang === 'zh' ? t.zh : t.en}</a></li>
          ))}
        </ol>
      </nav>
    </aside>

    <div class="privacy-main prose">
        {lang === 'zh' ? (
          <Fragment>
            <h2 id="collect">一、本站收集的信息</h2>
            <h3>1. 你主动提供的</h3>
            <div class="table-wrap"><table>
              <thead>
                <tr><th>信息</th><th>产生场景</th><th>是否必填</th></tr>
              </thead>
              <tbody>
                <tr><td>昵称</td><td>发表评论时</td><td>必填</td></tr>
                <tr><td>邮箱</td><td>发表评论时</td><td>必填；不在页面公开展示</td></tr>
                <tr><td>评论内容</td><td>发表评论时</td><td>必填，长度上限 1000 字</td></tr>
              </tbody>
            </table></div>
            <p>评论提交后进入待审核状态，经站长审核通过后方在页面公开展示；未通过的评论不予展示。系统同时为每条评论生成一个随机删除令牌，用于你日后自行删除该条评论。</p>
            <h3>2. 访问页面时自动读取的</h3>
            <div class="table-wrap"><table>
              <thead>
                <tr><th>信息</th><th>用途</th><th>是否存储</th></tr>
              </thead>
              <tbody>
                <tr><td>IP 地址</td><td>生成页面溯源水印；加密文章解锁与部分接口的频率限制</td><td>水印用途不存储；频率限制用途临时存储，详见第五节</td></tr>
                <tr><td>设备时区</td><td>使水印显示访客当地日期</td><td><strong>不存储</strong></td></tr>
              </tbody>
            </table></div>
            <blockquote>就水印用途而言，IP 地址与设备时区仅在服务端渲染页面时即时读取，用于生成水印文字，不写入数据库、不写入应用日志、不发送给任何第三方。频率限制用途的处理方式不同，见第五节。</blockquote>
            <h3>3. 只有博主本人涉及的</h3>
            <p>后台登录使用 Supabase 账号体系，仅博主本人持有账号。密码以单向哈希形式保存，本站无法还原明文。访客无需注册、无需登录即可阅读与评论。</p>

            <h2 id="use">二、每项信息的用途</h2>
            <div class="table-wrap"><table>
              <thead>
                <tr><th>信息</th><th>用途</th><th>会不会用于其他目的</th></tr>
              </thead>
              <tbody>
                <tr><td>昵称</td><td>在评论旁公开展示</td><td>否</td></tr>
                <tr><td>邮箱</td><td>识别评论者身份；发生争议时联系评论者</td><td><strong>不在页面公开展示、不用于营销、不向第三方提供、不出售</strong></td></tr>
                <tr><td>评论内容</td><td>审核通过后在对应文章下公开展示</td><td>否</td></tr>
                <tr><td>IP 地址</td><td>生成溯源水印；加密文章解锁与部分接口的频率限制（见第五节）</td><td>本站不用于用户画像、不保留访问历史</td></tr>
                <tr><td>设备时区</td><td><strong>仅</strong>用于计算水印所示当地日期</td><td>同上</td></tr>
              </tbody>
            </table></div>
            <p>本站不进行下列处理：用户画像、行为分析、兴趣标签、个性化推荐、广告投放、数据交易。</p>

            <h2 id="watermark">三、关于页面水印</h2>
            <p>本站页面叠加有一层低透明度的斜向文字，用作内容溯源标识。</p>
            <ul>
              <li><strong>构成</strong>：<code>IP 标识 · 访客当地日期 · 站点名称</code>
                <ul>
                  <li>IPv4 地址完整显示；IPv6 地址为控制长度仅保留前 4 段（如 <code>240e:39e:490:b5b1</code>）</li>
                </ul>
              </li>
              <li><strong>目的</strong>：在内容被整篇搬运或截图外传时，用以判断泄漏来源，作为原创内容的最低限度保护措施。</li>
              <li><strong>处理限度</strong>：不记录浏览轨迹、不建立个人档案、不与访客的其他访问数据关联、不向第三方提供（统计服务的独立处理见第六节）。</li>
              <li><strong>可见性</strong>：透明度较低，正常阅读不易察觉，不影响页面的点击与选中操作。</li>
            </ul>
            <p>访客如不希望显示该水印，可通过浏览器扩展屏蔽对应页面元素，或以无痕模式访问。本站不依赖水印实现任何功能，屏蔽后不影响内容阅读。</p>

            <h2 id="cookies">四、Cookie 与浏览器本地存储</h2>
            <p>本站不使用任何广告 Cookie，亦不进行跨站追踪。Cookie 按功能分为两类：保障网站功能所必需者（无需同意），以及在访客同意后方才设置者（Google Analytics）。</p>
            <div class="table-wrap"><table class="table-wide">
              <thead>
                <tr><th>名称</th><th>类型</th><th>作用</th><th>期限</th><th>是否需要同意</th></tr>
              </thead>
              <tbody>
                <tr><td><code>unlocked</code></td><td>Cookie</td><td>记录加密文章的解锁状态，内容为页面标识与签名的组合，<strong>不含个人信息</strong></td><td>30 天</td><td>否（网站功能必需）</td></tr>
                <tr><td><code>theme</code></td><td>浏览器本地存储</td><td>保存访客选择的深色或浅色主题</td><td>直到你清除浏览器数据</td><td>否（仅存本地）</td></tr>
                <tr><td><code>styleblog-my-comments</code></td><td>浏览器本地存储</td><td>保存访客的评论删除令牌，用于自行删除已发表的评论</td><td>同上</td><td>否（仅存本地）</td></tr>
                <tr><td><code>analytics-consent</code></td><td>浏览器本地存储</td><td>保存访客对统计的选择（<code>granted</code> / <code>denied</code>），以避免重复询问</td><td>直到你清除浏览器数据</td><td>否（仅存本地）</td></tr>
                <tr><td><code>_ga</code></td><td>Cookie</td><td>Google Analytics 用以区分访客的随机标识符</td><td>最长 2 年</td><td><strong>是</strong>；未经同意不予写入</td></tr>
                <tr><td><code>_ga_&lt;容器ID&gt;</code></td><td>Cookie</td><td>Google Analytics 4 用以维持会话状态</td><td>最长 2 年</td><td><strong>是</strong>；未经同意不予写入</td></tr>
              </tbody>
            </table></div>
            <ul>
              <li>除 <code>unlocked</code> 与 <code>_ga*</code> 会随请求发送外，其余均仅存于访客浏览器本地，不上传服务器。</li>
              <li>清除浏览器数据即可全部移除，不影响内容阅读。</li>
              <li><code>unlocked</code> 设置 <code>HttpOnly</code> 与 <code>SameSite=Lax</code> 属性，页面脚本无法读取，仅用于判断解锁状态，有效期为 30 天。</li>
              <li>关于评论删除凭证：除浏览器本地保存的副本外，其对应记录亦保存在本站数据库的评论记录中（字段名 <code>delete_token</code>），用于在服务端校验删除请求的权限。该令牌仅为随机字符串，不含访客身份信息；删除评论后随之移除。</li>
            </ul>

            <h2 id="thirdparty">五、涉及哪些第三方服务</h2>
            <p>本站自身不设独立服务器，全部请求经由以下第三方服务处理。此外，加密文章解锁及翻译、摘要接口的访问频率限制会将访客 IP 地址写入本站数据库，处理方式见本节末尾。</p>
            <div class="table-wrap"><table>
              <thead>
                <tr><th>服务</th><th>承担的角色</th><th>涉及的数据</th></tr>
              </thead>
              <tbody>
                <tr><td>Cloudflare</td><td>网站托管、全球内容分发、<strong>Web Analytics 访问统计</strong></td><td>请求转发；统计不使用 Cookie、不做设备指纹识别（平台按其自身政策处理网络层日志）</td></tr>
                <tr><td>Supabase</td><td>数据库、登录鉴权与对象存储</td><td>文章、评论（含昵称、邮箱、删除令牌）、站长账号、访问频率限制记录（含 IP 地址）</td></tr>
                <tr><td>GitHub</td><td>代码托管</td><td>不涉及访客数据</td></tr>
                <tr><td>智谱 GLM（bigmodel.cn）</td><td>站长在后台撰写与翻译文章时使用的语言模型服务</td><td>仅处理站长提交的文章文本，不涉及访客数据</td></tr>
                <tr><td><strong>Google Analytics</strong>（可选）</td><td>访问统计</td><td><strong>仅在访客点击「同意」后加载</strong>，数据传至 Google（美国）</td></tr>
              </tbody>
            </table></div>
            <p>本站不接入百度统计、友盟、51LA 等国内统计平台，亦无广告联盟、联盟营销或行为追踪脚本。</p>
            <h3>关于 IP 地址的临时存储</h3>
            <p>为防止暴力破解与接口滥用，下列操作会将访客 IP 地址写入本站数据库：</p>
            <ul>
              <li><strong>加密文章解锁</strong>：以 <code>rl:unlock:ip:&lt;IP 地址&gt;</code> 为标识，记录请求计数与失败次数，用于限制尝试频率并在连续失败后临时锁定；</li>
              <li><strong>翻译与摘要接口</strong>：按账号标识计数，不单独记录 IP 地址。</li>
            </ul>
            <p>上述解锁相关记录以明文 IP 地址作为标识键保存在 <code>rate_limit_state</code> 与 <code>unlock_fail_state</code> 两张表中，用于计数窗口的滚动判断。该类记录不与评论、邮箱等身份信息关联，不用于用户画像，保存期限见第七节。</p>

            <h2 id="analytics">六、关于统计与访客的选择</h2>
            <p>本站接入访问统计的目的限于了解网站流量，以及与内容相关的互动与留存情况，即判断文章的实际阅读情况、访客来源、跨篇阅读行为与回访比例。上述信息仅用于决定内容方向与改进方式，不作其他用途。</p>
            <p>本站同时使用两套统计工具，其性质不同，应分别理解：</p>
            <h3>1. Cloudflare Web Analytics（始终启用，无需同意）</h3>
            <ul>
              <li>不使用 Cookie、不使用本地存储、不进行设备指纹识别。</li>
              <li>记录的为页面级聚合指标，包括浏览量、来源、国家或地区、页面性能。</li>
              <li>据 Cloudflare 说明，其 Web Analytics 不收集或使用访客个人数据，亦不使用 Cookie 或设备指纹进行统计。该服务与可选启用的 Google Analytics 相互独立，本站未对其提供单独开关。</li>
            </ul>
            <h3>2. Google Analytics（默认不加载，须经同意）</h3>
            <ul>
              <li>首次访问时页面底部显示告知横幅，询问是否允许加载 Google Analytics。</li>
              <li>「同意」与「拒绝」两个选项均不预设选中，样式同等突出。</li>
              <li>在访客点击「同意」之前，Google Analytics 的脚本不会被下载或请求，而非加载后再行拦截上报。</li>
              <li>点击「拒绝」后，Google Analytics 始终不加载，站点功能不受影响。</li>
              <li>无论作何选择，该选择均记录于浏览器本地，之后不再重复询问；清除浏览器数据后将重新询问。</li>
              <li>同意后衡量的指标包括页面浏览量、会话数、平均互动时长、跳出情况、新老访客比例与回访情况。本站已启用 IP 匿名化（<code>anonymize_ip</code>）配置；Google Analytics 在收集数据时使用 IP 地址以提供基础服务与粗略地理位置判断，但不记录或存储完整 IP 地址。相关数据不用于广告投放或跨站定向。</li>
            </ul>
            <h3>3. 中国大陆网络环境下的实际情况</h3>
            <p>Google Analytics 的脚本位于 <code>googletagmanager.com</code>，在中国大陆部分网络环境下可能无法加载或加载缓慢。此时即使访客已选择「同意」，亦不会产生数据上报，此属网络条件限制，非本站行为。这也是本站保留 Cloudflare Web Analytics 的原因：该服务是中国大陆访客可被稳定统计的渠道。</p>
            <h3>4. 更改统计选择</h3>
            <p>清除浏览器本地存储或使用无痕窗口访问，即可重新触发询问。若此前选择「同意」而希望撤回，可清除 <code>analytics-consent</code> 存储项后刷新页面，重新选择「拒绝」。</p>

            <h2 id="retention">七、数据保存期限</h2>
            <div class="table-wrap"><table>
              <thead>
                <tr><th>数据</th><th>保存期限</th></tr>
              </thead>
              <tbody>
                <tr><td>评论（昵称、邮箱、内容、删除令牌）</td><td>长期保存，直至访客或站长请求删除，或本站停止运营</td></tr>
                <tr><td>IP 地址（用于页面水印）</td><td><strong>不保存</strong></td></tr>
                <tr><td>IP 地址（用于解锁频率限制）</td><td>计数记录按 60 秒滚动窗口更新；连续失败产生的锁定状态最长保留 10 分钟，到期失效。相关记录不另行归档</td></tr>
                <tr><td>设备时区</td><td><strong>不保存</strong></td></tr>
                <tr><td>统计 Cookie（<code>_ga*</code>）</td><td>最长 2 年，随浏览器数据一并清除</td></tr>
                <tr><td>浏览器本地存储</td><td>由访客自行控制，清除即移除</td></tr>
              </tbody>
            </table></div>

            <h2 id="rights">八、访客的权利与行使方式</h2>
            <ul>
              <li><strong>查阅</strong>：可通过邮件询问本站是否留存其评论数据。</li>
              <li><strong>删除</strong>：发表评论后，浏览器会保存删除令牌，可凭其在页面上自行删除该评论；亦可邮件请求删除。</li>
              <li><strong>撤回</strong>：清除浏览器数据即可移除主题偏好与删除令牌。如需删除数据库中的评论与邮箱，请以邮件提出，站长核实身份后处理。</li>
              <li><strong>拒绝</strong>：如不希望 IP 被读取用于水印，可使用代理或屏蔽对应页面元素，本站不会因此限制访问。</li>
              <li><strong>变更统计选择</strong>：清除 <code>analytics-consent</code> 存储项后刷新页面，可重新选择同意或拒绝。</li>
            </ul>
            <p>联系方式：<a href={MAILTO}>{EMAIL}</a></p>
            <blockquote>点击邮箱地址将调起系统默认邮件客户端；若设备未设置默认客户端则无响应，可复制地址后通过网页版邮箱发送。</blockquote>

            <h2 id="crossborder">九、跨境传输与未成年人</h2>
