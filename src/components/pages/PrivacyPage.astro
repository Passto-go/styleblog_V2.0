            <h2 id="collect">1. Information collected</h2>
            <h3>Provided by you</h3>
            <div class="table-wrap"><table>
              <thead>
                <tr><th>Data</th><th>Occasion</th><th>Required</th></tr>
              </thead>
              <tbody>
                <tr><td>Display name</td><td>Posting a comment</td><td>Required</td></tr>
                <tr><td>Email address</td><td>Posting a comment</td><td>Required; not displayed publicly on any page</td></tr>
                <tr><td>Comment text</td><td>Posting a comment</td><td>Required; maximum 1,000 characters</td></tr>
