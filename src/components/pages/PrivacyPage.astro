    position: fixed;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    z-index: 80;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 0.7rem;
    border: 1px solid var(--border);
    border-right: 0;
    border-radius: 10px 0 0 10px;
    background: var(--surface);
    color: var(--text-strong);
    font: inherit;
    font-size: 0.85rem;
    cursor: pointer;
    box-shadow: 0 1px 6px rgba(0, 0, 0, 0.08);
    writing-mode: vertical-rl;
    letter-spacing: 0.12em;
    transition: background .15s, color .15s;
  }
  .toc-fab svg { writing-mode: horizontal-tb; }
  .toc-fab:hover { background: var(--bg-soft); color: var(--accent); }

  /* 抽屉背后的遮罩 */
  .toc-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.32);
    opacity: 0;
    pointer-events: none;
    transition: opacity .22s ease;
    z-index: 85;
  }
  .toc-overlay.open { opacity: 1; pointer-events: auto; }

  /* 右侧抽屉：默认移出屏幕右侧，打开时滑入 */
  .toc-drawer {
    position: fixed;
    top: 0;
    right: 0;
    height: 100%;
    width: 320px;
    max-width: 86vw;
