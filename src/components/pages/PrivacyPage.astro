      justify-content: center;
      border-right: 1px solid var(--border);
      border-radius: 50%;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.18);
    }
    .toc-fab span { display: none; }
    .toc-fab svg { width: 18px; height: 18px; }
  }

  /* 窄屏：表格按内容排布——短内容列不拆词，长内容列折行，整体超宽时横向滚动 */
  @media (max-width: 600px) {
    .prose table {
      font-size: 13.5px;
      table-layout: auto;
    }
    .prose th, .prose td { padding: 8px 10px; max-width: 220px; }
    /* 首列（信息 / 名称 / 数据）多为短标识，禁止拆词，避免「发表评论时」被拆成两行 */
    .prose td:first-child, .prose th:first-child { white-space: nowrap; }
    /* 3 列及以上：给足最小宽度，短内容不拆词，超出部分横向滚动（:where 降低优先级，宽表规则可覆盖） */
    .prose table:where(:has(thead th:nth-child(3))) { min-width: 480px; }
    /* 宽表（Cookie 5 列）恢复自动列宽，整体至少 560px，超出横向滚动 */
    .prose table.table-wide { min-width: 560px; }
    .prose table.table-wide th, .prose table.table-wide td { width: auto; }
    /* 宽表首列是 styleblog-my-comments 这类长标识，不能沿用上面的 nowrap，
       否则会溢出单元格、压到第二列文字上；这里允许按词/字符断行 */
    .prose table.table-wide td:first-child,
    .prose table.table-wide th:first-child { white-space: normal; min-width: 118px; }
    .prose table.table-wide td:first-child code { white-space: normal; word-break: normal; overflow-wrap: break-word; }
  }
</style>

<script>
  // 目录抽屉：默认隐藏，点击按钮/遮罩/关闭/ESC 开合；点条目跳转后自动收起
  const fab = document.querySelector('.toc-fab');
  const drawer = document.querySelector('.toc-drawer');
  const overlay = document.querySelector('.toc-overlay');
  const closeBtn = document.querySelector('.toc-close');

  function openToc() {
    drawer.classList.add('open');
    overlay.classList.add('open');
    overlay.hidden = false;
    drawer.setAttribute('aria-hidden', 'false');
    fab.setAttribute('aria-expanded', 'true');
    document.body.classList.add('toc-open');
    document.body.style.overflow = 'hidden';
    closeBtn.focus();
  }
  function closeToc() {
    drawer.classList.remove('open');
    overlay.classList.remove('open');
    drawer.setAttribute('aria-hidden', 'true');
    fab.setAttribute('aria-expanded', 'false');
    document.body.classList.remove('toc-open');
    document.body.style.overflow = '';
    setTimeout(() => { overlay.hidden = true; }, 220);
    fab.focus();
  }

  // 表格横向溢出时显示边缘渐隐，提示可左右滑动
  document.querySelectorAll('.table-wrap').forEach((wrap) => {
    const update = () => {
      const max = wrap.scrollWidth - wrap.clientWidth;
      const scrollable = max > 2;
      wrap.classList.toggle('is-scroll', scrollable && wrap.scrollLeft < max - 2);
      wrap.classList.toggle('is-scroll-left', scrollable && wrap.scrollLeft > 2);
    };
    update();
    wrap.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
  });

  // 滚动时淡化目录按钮，减少对正文的遮挡
  let tocScrollTimer;
  window.addEventListener('scroll', () => {
    fab?.classList.add('scrolling');
    clearTimeout(tocScrollTimer);
    tocScrollTimer = setTimeout(() => fab?.classList.remove('scrolling'), 600);
  }, { passive: true });

  fab?.addEventListener('click', openToc);
  closeBtn?.addEventListener('click', closeToc);
  overlay?.addEventListener('click', closeToc);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer.classList.contains('open')) closeToc();
  });

  // 目录：点击平滑滚动到锚点（并收起抽屉），高亮当前所在章节
  const links = Array.from(document.querySelectorAll('.toc-list a'));
  if (links.length) {
    const map = new Map(links.map((l) => [l.getAttribute('href')?.slice(1) || '', l]));
    links.forEach((l) => {
      l.addEventListener('click', (e) => {
        const id = l.getAttribute('href')?.slice(1);
        if (!id) return;
        const el = document.getElementById(id);
        if (el) {
          e.preventDefault();
          closeToc();
          el.scrollIntoView({ behavior: 'smooth', block: 'start' });
          history.replaceState(null, '', '#' + id);
        }
      });
    });
    const obs = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            links.forEach((l) => l.classList.remove('active'));
            const link = map.get(entry.target.id);
            if (link) link.classList.add('active');
          }
        });
      },
      { rootMargin: '-80px 0px -65% 0px', threshold: 0 }
    );
    document.querySelectorAll('h2[id]').forEach((h) => obs.observe(h));

    // L-05：离开页面时断开观察器（bfcache 回退时重新观察）
    window.addEventListener('pagehide', () => obs.disconnect());
    window.addEventListener('pageshow', (e) => {
      if (e.persisted) document.querySelectorAll('h2[id]').forEach((h) => obs.observe(h));
    });
  }
</script>
