---
import Base from '../../layouts/Base.astro';
import PostCard from '../PostCard.astro';
import ProfileCard from '../ProfileCard.astro';
import TodayQuote from '../TodayQuote.astro';
import Countdown from '../Countdown.astro';
import { getPosts, getCategories, toCategoryMap, getAvatar } from '../../lib/posts.js';
import { useTranslations } from '../../i18n/ui.js';

const { lang } = Astro.props;
const t = useTranslations(lang);
// 【性能】三个查询互不依赖，并行发出。
// 原先三条 await 串行，每次 Supabase 往返 270～370ms（还有实例抖动），
// 串行累加后首页 TTFB 实测 2.0～4.4s。并行后取最慢一条即可。
// avatar：后台设置优先，未配置回退源码里的 /avatar.png
const [posts, cats, avatar] = await Promise.all([
  getPosts(lang),
  getCategories(lang),
  getAvatar(),
]);
const catMap = toCategoryMap(cats);
---
<Base lang={lang} title={t('home.hero.title')} description={t('site.tagline')}>
  <div class="home">
    <aside class="sidebar">
      <ProfileCard lang={lang} postsCount={posts.length} catsCount={cats.length} avatar={avatar} />
      <TodayQuote lang={lang} />
      <Countdown lang={lang} />
    </aside>
    <section class="content">
      <h2 class="section-title">{t('home.latest')}</h2>
      {posts.length === 0 ? (
        <p class="empty">{t('home.empty')}</p>
      ) : (
        <div class="post-list">
          {posts.map((p) => <PostCard post={p} lang={lang} categories={catMap} />)}
        </div>
      )}
    </section>
  </div>
</Base>
