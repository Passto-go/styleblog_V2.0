---
import Base from '../../layouts/Base.astro';

const { lang } = Astro.props;
const year = new Date().getFullYear();
const EMAIL = 'intl1024@outlook.com';
const MAILTO = `mailto:${EMAIL}?subject=${encodeURIComponent(lang === 'zh' ? '版权相关事宜' : 'Copyright inquiry')}`;
const WEBMAIL = `https://outlook.live.com/mail/0/deeplink/compose?to=${EMAIL}`;

// B 方案版权说明：自定义、非 CC、零域名。
// 署名用作者身份（老一贯 / Lao Yiguan）与品牌名（吾道一以贯之 / The Way, One Thread），
// 不出现站点域名；年份动态生成；出链一律走相对路径 /copyright，跟随域名变化。
const CONTENT = {
  zh: {
    title: '版权与转载说明',
    lead: '本站内容的著作权归属与转载规则。',
    blocks: [
      { tag: 'p', html: '本站（吾道一以贯之）全部原创文章、图片与代码的著作权归 <strong>老一贯</strong> 所有。' },
      { tag: 'h2', text: '欢迎的做法' },
      { tag: 'p', html: '非商业用途的引用与分享：引用片段请注明作者与原文链接；分享至社交平台请保留出处。' },
      { tag: 'h2', text: '未经许可，禁止' },
      { tag: 'p', html: '1. 整篇或实质性转载（含镜像、聚合、转码后发布）；' },
      { tag: 'p', html: '2. 任何形式的商业化使用（付费墙、广告变现、二次出售）；' },
      { tag: 'p', html: '3. 去除署名或篡改内容后重新发布。' },
      { tag: 'h2', text: '关于 AI 与数据挖掘' },
      { tag: 'p', html: '未经授权，请勿将本站内容用于模型训练、数据挖掘或类似自动化抓取。' },
      { tag: 'h2', text: '侵权举报' },
      { tag: 'p', html: '如发现未经授权的转载或滥用，请通过邮件联系站长，并附上侵权页面链接，我们将在核实后处理：' },
      { tag: 'contact' },
      { tag: 'p', html: `© ${year} 老一贯（吾道一以贯之）。保留署名权。` },
    ],
  },
  en: {
    title: 'Copyright & Republishing',
    lead: 'How the content on this site is licensed and may be shared.',
    blocks: [
      { tag: 'p', html: 'All original articles, images, and code on this site (The Way, One Thread) are the intellectual property of <strong>Lao Yiguan</strong>.' },
      { tag: 'h2', text: 'What you may do' },
      { tag: 'p', html: 'Quote short excerpts for non-commercial purposes, with clear attribution and a link to the original; sharing on social platforms is welcome with credit kept intact.' },
      { tag: 'h2', text: 'Without permission, you may not' },
      { tag: 'p', html: '1. Repost entire posts or substantial portions (including mirroring, aggregation, or republishing after transcoding);' },
      { tag: 'p', html: '2. Use the content commercially in any form (paywalls, ad monetization, resale);' },
      { tag: 'p', html: '3. Strip attribution or alter and redistribute the content.' },
      { tag: 'h2', text: 'AI & data mining' },
      { tag: 'p', html: 'Automated scraping or training of models on this content is not permitted without authorization.' },
      { tag: 'h2', text: 'Report infringement' },
      { tag: 'p', html: 'To report unauthorized use, email the site owner with a link to the infringing page. We will act upon verification:' },
      { tag: 'contact' },
      { tag: 'p', html: `© ${year} Lao Yiguan (The Way, One Thread). Attribution rights reserved.` },
    ],
  },
};

const c = CONTENT[lang] || CONTENT.en;
const T = lang === 'zh'
  ? { copy: '复制邮箱', copied: '已复制', web: '用网页版 Outlook 写信 →', hint: '点击地址将打开你的邮件客户端；若没有反应，可复制邮箱或使用网页版。' }
  : { copy: 'Copy email', copied: 'Copied', web: 'Compose in Outlook web →', hint: 'Clicking the address opens your mail app. If nothing happens, copy it or use the web version.' };
---
<Base lang={lang} title={c.title} description={c.lead}>
  <section class="page">
    <h1 class="page-title">{c.title}</h1>
    <p class="lead">{c.lead}</p>
    <div class="prose">
      {c.blocks.map((b) =>
        b.tag === 'h2'
          ? <h2>{b.text}</h2>
          : b.tag === 'contact'
            ? (
              <div class="contact-card">
                <a class="contact-mail" href={MAILTO}>{EMAIL}</a>
                <button type="button" class="contact-copy" data-copy={EMAIL} data-label-copy={T.copy} data-label-copied={T.copied}>{T.copy}</button>
                <a class="contact-web" href={WEBMAIL} target="_blank" rel="noopener">{T.web}</a>
                <p class="contact-hint">{T.hint}</p>
              </div>
            )
            : <p set:html={b.html} />
      )}
    </div>
  </section>
</Base>

<style>
  .contact-card {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.625rem 0.875rem;
    margin: 1.125rem 0 1.5rem;
    padding: 1rem 1.125rem;
    border: 1px solid var(--border, #e5e5e5);
    border-radius: 0.75rem;
    background: var(--bg-soft, rgba(0, 0, 0, 0.02));
  }
  .contact-mail {
    font-size: 1.0625rem; font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
  }
  .contact-copy {
    font: inherit; font-size: 0.8125rem;
    padding: 0.25rem 0.6875rem;
    border: 1px solid var(--border, #d8d8d8);
    border-radius: 999px;
    background: transparent; color: inherit;
    cursor: pointer;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }
  .contact-copy:hover { background: var(--bg-hover, rgba(0, 0, 0, 0.06)); }
  .contact-copy[data-done] { border-color: currentColor; }
  .contact-web { font-size: 0.8125rem; opacity: 0.8; }
  .contact-hint { flex-basis: 100%; margin: 0; font-size: 0.75rem; opacity: 0.6; }
</style>

<script is:inline>
  document.querySelectorAll('.contact-copy').forEach(function (btn) {
    btn.addEventListener('click', async function () {
      var text = btn.getAttribute('data-copy') || '';
      try {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          await navigator.clipboard.writeText(text);
        } else {
          // 兜底：非安全上下文或旧浏览器
          var ta = document.createElement('textarea');
          ta.value = text; ta.setAttribute('readonly', ''); ta.style.position = 'fixed'; ta.style.opacity = '0';
          document.body.appendChild(ta); ta.select(); document.execCommand('copy'); document.body.removeChild(ta);
        }
        btn.textContent = btn.getAttribute('data-label-copied') || 'Copied';
        btn.setAttribute('data-done', '');
        setTimeout(function () {
          btn.textContent = btn.getAttribute('data-label-copy') || 'Copy email';
          btn.removeAttribute('data-done');
        }, 1600);
      } catch (e) {
        window.prompt('Copy this email:', text);
      }
    });
  });
</script>
