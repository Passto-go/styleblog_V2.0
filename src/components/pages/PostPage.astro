---
import Base from '../../layouts/Base.astro';
import { getAllPosts, getAllPostsEveryLang, titleResolver, getCategories, toCategoryMap, getAvatar, renderMarkdown, findTranslation, baseSlug } from '../../lib/posts.js';
import { useTranslations, localizePath, languages } from '../../i18n/ui.js';
import { formatDate } from '../../lib/format.js';
import { readingMinutes } from '../../lib/reading-time.js';
import ProfileCard from '../ProfileCard.astro';
import Toc from '../Toc.astro';
import TodayQuote from '../TodayQuote.astro';
import Countdown from '../Countdown.astro';
import Comments from '../Comments.astro';
import Share from '../Share.astro';

const { lang, post, versions } = Astro.props;
const t = useTranslations(lang);
const { html, headings } = renderMarkdown(post.content || '');
const dateStr = formatDate(post.published_at, lang);
const catHref = post.categorySlug ? localizePath(`/categories/${post.categorySlug}/`, lang) : null;

// 上下篇导航：相邻关系按「当前语言视图」的文章顺序取（每篇只含该语言最匹配的版本），
// 避免跳到另一语言的同名文章；标题则用该文章在目标语言下的译文（无译文才保留原文），
// 否则英文/日文页会直接露出中文标题。
const allPosts = await getAllPosts(lang);
const displayTitle = titleResolver(await getAllPostsEveryLang(), lang);
// 分类名以注册表为准：按 post.category_slug 反查当前语言名称，缺行才回退中文快照
const cats = await getCategories(lang, { skipPosts: true });
const catMap = toCategoryMap(cats);
const postCatName = catMap.get(post.categorySlug)?.name || post.category;
const avatar = await getAvatar();
const wordCount = (post.content || '').replace(/\s+/g, '').length;
const readMinutes = readingMinutes(post.content);
const idx = allPosts.findIndex((p) => p.slug === post.slug);
const pagePath = localizePath(`/posts/${post.slug}/`, lang);
// 基准 slug（去掉 -en/-ja 语言后缀）：用于给正文容器打「文章身份」标记，
// 使仅针对某一篇文章的样式规则在它的所有语言版本上一致生效。
const postBaseSlug = baseSlug(post.slug);
// 分享需要绝对地址（社交平台不接受相对路径）
const shareUrl = Astro.site ? new URL(pagePath, Astro.site).href : pagePath;
const prevPost = idx > 0 ? allPosts[idx - 1] : null;
const nextPost = idx > -1 && idx < allPosts.length - 1 ? allPosts[idx + 1] : null;

// 语言切换目标地址：直接用「替换 URL 前缀」会跳到不存在的页面（404），
// 因此按文章基准 slug 找到其他语言下的对应版本，用其 slug 生成链接。
// 该语言没有译文时，findTranslation 返回中文原文 → 链接仍指向当前文章，
// 用户留在本页（UI 变目标语言，正文回退中文）；仅当文章完全不存在时才回退该语言首页。
const langHrefs = {};
for (const code of Object.keys(languages)) {
  if (code === lang) continue;
  const tr = await findTranslation(post.slug, code);
  langHrefs[code] = tr ? localizePath(`/posts/${tr.slug}/`, code) : localizePath('/', code);
}

// 无译文提示横幅：当前语言缺「已发布译文」时告知读者现状。
// 判定条件与优先级（与 lib/posts.js 的 pickDisplayLang 级联保持一致）：
//   · en 页：无英文译文 → 提示；有日文译文时附日文版链接（正文此时为中文兜底）
//   · ja 页：无日文译文 → 提示；正文此时为英文兜底（有英文译文）或中文兜底
//   · zh 页：不展示——中文即原文，且中文页不存在「缺中文译文」的业务场景
// 适用边界：versions.available 只认 published=true 的版本，草稿译文对读者视为不存在。
const missingNotice = (() => {
  if (!versions || lang === 'zh') return null;
  if (lang === 'en') {
    if (versions.available.en) return null;
    return {
      text: versions.available.ja ? t('article.missingEn') : t('article.missingEnJa'),
      note: t('article.showingZh'),
      link: versions.siblings.ja
        ? { href: localizePath(`/posts/${versions.siblings.ja}/`, 'ja'), label: t('article.readJa') }
        : null,
    };
  }
  if (versions.available.ja) return null;
  return {
    text: versions.available.en ? t('article.missingJa') : t('article.missingJaEn'),
    note: versions.displayLang === 'en' ? t('article.showingEn') : t('article.showingZh'),
    link: null,
  };
})();
---
<Base lang={lang} title={post.title} description={post.excerpt || ''} langHrefs={langHrefs} image={post.cover || ''} type="article">
  <div class="reading-bar" aria-hidden="true"><div class="reading-bar-fill" id="reading-fill"></div></div>
  <div class="post-head">
    <div class="post-head-inner">
      <h1 class="post-title">{post.title}</h1>
      <div class="post-meta">
        <span>{dateStr}</span>
        {postCatName && catHref && <a href={catHref} class="post-cat">{postCatName}</a>}
        <span>{t('post.words', { n: wordCount })}</span>
        <span>{t('post.readTime', { n: readMinutes })}</span>
      </div>
    </div>
    {post.cover && (
      <div class="post-cover">
        <img src={post.cover} alt={post.title} loading="lazy" />
      </div>
    )}
  </div>

  <div class="post-layout">
    <aside class="post-aside post-aside-left">
      <Toc headings={headings} lang={lang} />
      <ProfileCard lang={lang} postsCount={allPosts.length} catsCount={cats.length} avatar={avatar} />
      <TodayQuote lang={lang} />
      <Countdown lang={lang} />
    </aside>

    <article class="post-main">
      {missingNotice && (
        <aside class="translation-notice" role="note">
          <p class="translation-notice-text">{missingNotice.text}</p>
          {missingNotice.note && <p class="translation-notice-note">{missingNotice.note}</p>}
          {missingNotice.link && (
            <a class="translation-notice-link" href={missingNotice.link.href}>{missingNotice.link.label}</a>
          )}
        </aside>
      )}
      {post.excerpt && <p class="post-lead">{post.excerpt}</p>}
      {/* data-post：暴露文章基准 slug，供「仅对指定文章生效」的样式/脚本作用域钩子使用 */}
      <div class="content" data-post={postBaseSlug} set:html={html} />
      <Share lang={lang} url={shareUrl} title={post.title} />
      <Comments lang={lang} page={pagePath} />
      <p class="back"><a href={localizePath('/', lang)}>{t('post.back')}</a></p>
    </article>
  </div>

  {(prevPost || nextPost) && (
    <nav class="post-nav" aria-label={t('post.navLabel')}>
      {prevPost ? (
        <a class="post-nav-item prev" href={localizePath(`/posts/${prevPost.slug}/`, lang)}>
          <span class="post-nav-dir">{t('post.prev')}</span>
          <span class="post-nav-title">{displayTitle(prevPost)}</span>
        </a>
      ) : <span class="post-nav-item prev disabled"></span>}
      {nextPost ? (
        <a class="post-nav-item next" href={localizePath(`/posts/${nextPost.slug}/`, lang)}>
          <span class="post-nav-dir">{t('post.next')}</span>
          <span class="post-nav-title">{displayTitle(nextPost)}</span>
        </a>
      ) : <span class="post-nav-item next disabled"></span>}
    </nav>
  )}
</Base>

<script>
  (function () {
    var fill = document.getElementById('reading-fill');
    if (!fill) return;
    function upd() {
      var d = document.documentElement;
      var max = d.scrollHeight - d.clientHeight;
      var p = max > 0 ? (d.scrollTop || document.body.scrollTop) / max * 100 : 0;
      fill.style.width = Math.min(100, Math.max(0, p)) + '%';
    }
    window.addEventListener('scroll', upd, { passive: true });
    window.addEventListener('resize', upd);
    upd();
  })();

  // 文章表格统一包进横向滚动容器 .wb-table-scroll ——
  //  旧做法靠 .content table{display:block;overflow-x:auto} 自身滚动，但块盒化的表
  //  在 iOS Safari 上手指滑动常被识别成整页滚动（表格自身滚不动），且边框圆角被切。
  //  改为「外层 div 负责滚动、内层 table 保持表格语义」，两端行为一致。
  //  · vacation_cost-of-japan：display:table + width:100% 铺满，宽表由 wrapper 横向滚动
  //  · cost-of-travelling-Japan：CSS 定宽列（合计超容器宽），由 wrapper 承担横向滚动
  //  · 其余文章：所有表格一律包裹，窄表不受影响（不产生滚动条），宽表自动可滚
  //  幂等：已包裹过（父节点即 wrapper）则跳过，避免重复嵌套。
  (function () {
    var contents = document.querySelectorAll('.content');
    for (var c = 0; c < contents.length; c++) {
      var tables = contents[c].querySelectorAll('table');
      for (var i = 0; i < tables.length; i++) {
        var t = tables[i];
        if (t.parentNode && t.parentNode.classList && t.parentNode.classList.contains('wb-table-scroll')) continue;
        var wrap = document.createElement('div');
        wrap.className = 'wb-table-scroll';
        t.parentNode.insertBefore(wrap, t);
        wrap.appendChild(t);
      }
    }
  })();
</script>