---
// Cookie / 统计同意横幅（Consent Banner）
//
// 目的：满足 GDPR 等法规对「非必要 Cookie」的要求——在访客明确同意之前，
// 绝不加载第三方统计分析脚本（Google Analytics / Microsoft Clarity），也不写入其 Cookie。
//
// 工作方式：
//   ① 页面加载时先读 localStorage 里的选择（granted / denied）
//   ② 只有 granted 时才注入对应统计脚本；denied 或未选择时完全不加载
//   ③ 未选择时在页面底部展示横幅，提供「同意」与「拒绝」两个同等权重的按钮
//   ④ 选择结果持久化，之后不再打扰
//
// 配置来源：后台「其他功能 → 第三方统计」（site_settings.analytics）。未配置时沿用默认
// （GA4 开、Clarity 关）。任何经同意才加载的服务都由本组件统一门控；Cloudflare Web
// Analytics 不使用 Cookie、由 Cloudflare 边缘自动注入，不在此列（见隐私说明第六节）。
import { useTranslations, localizePath } from '../i18n/ui.js';
import { getAnalytics, activeAnalyticsServices } from '../lib/posts.js';

const { lang = 'zh' } = Astro.props;
const t = useTranslations(lang);

// 当前生效的统计分析服务（各自未启用或未填 ID 则不含在内）
const cfg = await getAnalytics();
const services = activeAnalyticsServices(cfg);
const privacyHref = localizePath('/privacy', lang);

// 文案里的 {names} 是当前已启用服务的名称（如「Google Analytics、Microsoft Clarity」或仅其一），
// {link} 是隐私说明链接占位符：拆成前后两段，把 <a> 插在中间。
const serviceNames = {
  ga: 'Google Analytics',
  clarity: 'Microsoft Clarity',
};
const names = services.map((s) => serviceNames[s.type]).join(lang === 'zh' ? '、' : ', ');
const consentParts = t('consent.text').replace('{names}', names).split('{link}');
---

{services.length > 0 && (
  <div id="consent-banner" class="consent-banner" hidden>
    <div class="consent-inner">
      <p class="consent-text">
        {consentParts[0]}<a href={privacyHref} class="consent-link">{t('consent.more')}</a>{consentParts[1] ?? ''}
      </p>
      <div class="consent-actions">
        <button type="button" class="consent-btn consent-reject" data-consent="denied">{t('consent.reject')}</button>
        <button type="button" class="consent-btn consent-accept" data-consent="granted">{t('consent.accept')}</button>
      </div>
    </div>
  </div>
)}

{services.length > 0 && (
  <script is:inline define:vars={{ services, lang }}>
    (function () {
      var KEY = 'analytics-consent';   // 值：'granted' | 'denied'
      var banner = document.getElementById('consent-banner');
      if (!banner) return;

      var loaded = false;

      // 单个服务的加载器
      function loadService(svc) {
        if (svc.type === 'ga') {
          var g = document.createElement('script');
          g.async = true;
          g.src = 'https://www.googletagmanager.com/gtag/js?id=' + svc.id;
          document.head.appendChild(g);
          window.dataLayer = window.dataLayer || [];
          function gtag() { window.dataLayer.push(arguments); }
          window.gtag = gtag;
          gtag('js', new Date());
          // 同意模式下不发送广告相关信号，仅保留基础分析
          gtag('config', svc.id, { anonymize_ip: true });
        } else if (svc.type === 'clarity') {
          (function (c, l, a, r, i, t, y) {
            c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
            t = l.createElement(r); t.async = 1; t.src = 'https://www.clarity.ms/tag/' + i;
            y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
          })(window, document, 'clarity', 'script', svc.id);
        }
      }

      function loadAll() {
        if (loaded) return;
        loaded = true;
        (services || []).forEach(loadService);
      }

      function read() {
        try { return localStorage.getItem(KEY); } catch (e) { return null; }
      }
      function write(v) {
        try { localStorage.setItem(KEY, v); } catch (e) {}
      }

      var choice = read();

      if (choice === 'granted') {
        loadAll();                      // 已同意：直接加载，不显示横幅
      } else if (choice === 'denied') {
        // 已拒绝：什么也不做
      } else {
        banner.hidden = false;          // 尚未选择：展示横幅
      }

      banner.addEventListener('click', function (e) {
        var btn = e.target.closest('[data-consent]');
        if (!btn) return;
        var v = btn.getAttribute('data-consent');
        write(v);
        banner.hidden = true;
        if (v === 'granted') loadAll();
      });
    })();
  </script>
)}

<style>
  .consent-banner {
    position: fixed;
    left: 0; right: 0; bottom: 0;
    z-index: 10000;                /* 仅高于水印与后台弹层；分享 toast(120)/二维码(130) 不再被压住（M-10） */
    background: var(--bg, #fff);
    border-top: 1px solid var(--border, #d0d7de);
    box-shadow: 0 -2px 12px rgba(0, 0, 0, 0.06);
  }
  .consent-inner {
    max-width: 980px;
    margin: 0 auto;
    padding: 0.875rem 1.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
  }
  .consent-text {
    flex: 1 1 320px;
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--text, #1f2328);
    opacity: 0.88;
  }
  /* 链接已嵌在句子内部，不再需要额外的左侧间距（中文「详见」后不应有空格） */
  .consent-link {
    text-decoration: underline;
    white-space: nowrap;
  }
  .consent-actions {
    display: flex;
    gap: 0.5rem;
    flex-shrink: 0;
  }
  .consent-btn {
    font: inherit;
    font-size: 0.8125rem;
    padding: 0.375rem 0.9375rem;
    border-radius: 0.375rem;
    cursor: pointer;
    border: 1px solid var(--border, #d0d7de);
    background: transparent;
    color: var(--text, #1f2328);
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }
  .consent-btn:hover { background: var(--bg-soft, #f6f8fa); }
  /* 同意与拒绝视觉权重一致，避免暗黑模式（dark pattern） */
  .consent-accept {
    border-color: var(--accent, #0969da);
    color: var(--accent, #0969da);
  }
  .consent-accept:hover { background: var(--accent-soft, #ddf4ff); }

  @media (max-width: 600px) {
    .consent-inner { padding: 0.75rem 1rem 0.875rem; }
    .consent-actions { width: 100%; }
    .consent-btn { flex: 1; }
  }
</style>
