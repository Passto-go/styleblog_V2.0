---
import Icon from './Icon.astro';
import { useTranslations } from '../i18n/ui.js';

const { lang = 'zh', page } = Astro.props;
const t = useTranslations(lang);
// 运行时读浏览器内联的公开 key（构建时由 .env / 部署平台环境变量注入）
const configured = Boolean(import.meta.env.PUBLIC_SUPABASE_URL && import.meta.env.PUBLIC_SUPABASE_ANON_KEY);
---
{configured ? (
  <section class="comments" id="comments" data-page={page} data-lang={lang}
    data-required={t('post.commentRequired')}
    data-sending={t('post.commentSending')}
    data-error={t('post.commentError')}
    data-name-required={t('post.commentNameRequired')}
    data-email-invalid={t('post.commentEmailInvalid')}
    data-load-failed={t('post.commentLoadFailed')}
    data-retry={t('post.commentRetry')}
    data-pending={t('post.commentPending')}
    data-my-title={t('post.commentMyTitle')}
    data-mine-hint={t('post.commentMineHint')}
    data-status-pending={t('post.commentStatusPending')}
    data-status-approved={t('post.commentStatusApproved')}
    data-status-rejected={t('post.commentStatusRejected')}
    data-status-rejected-note={t('post.commentStatusRejectedNote')}
    data-del={t('post.commentDelete')}
    data-del-confirm={t('post.commentDeleteConfirm')}
    data-token-missing={t('post.commentTokenMissing')}
    data-deleted={t('post.commentDeleted')}>
    <h2 class="comments-title">
      <Icon name="comment" size={18} />
      <span>{t('post.comments')}</span>
      <span class="comments-count" id="comments-count">0</span>
    </h2>

    <form class="comments-form" id="comments-form" autocomplete="off">
      <div class="comments-row">
        <input
          class="comments-name"
          id="comments-name"
          type="text"
          maxlength="40"
          placeholder={t('post.commentName')}
          aria-label={t('post.commentName')}
          required
        />
        <input
          class="comments-email"
          id="comments-email"
          type="email"
          maxlength="120"
          placeholder={t('post.commentEmail')}
          aria-label={t('post.commentEmail')}
          required
        />
      </div>
      <!-- 蜜罐：正常用户看不到也填不了，机器人若填了则静默丢弃 -->
      <input class="comments-hp" id="comments-hp" type="text" tabindex="-1" aria-hidden="true" autocomplete="off" />
      <textarea
        class="comments-input"
        id="comments-text"
        maxlength="1000"
        rows="4"
        placeholder={t('post.commentPlaceholder')}
        aria-label={t('post.commentPlaceholder')}
        required
      ></textarea>
      <div class="comments-actions">
        <span class="comments-msg" id="comments-msg" role="status" aria-live="polite"></span>
        <button class="comments-submit" id="comments-submit" type="submit">{t('post.commentSubmit')}</button>
      </div>
    </form>

    <ul class="comments-list" id="comments-list" aria-live="polite"></ul>

    <!-- 我的评论：仅当前浏览器提交过评论时才显示，凭本地令牌读取并管理本人评论 -->
    <section class="my-comments" id="my-comments" hidden>
      <div class="my-comments-head">
        <strong id="my-comments-title"></strong>
        <span class="my-comments-hint" id="my-comments-hint"></span>
      </div>
      <ul class="my-comments-list" id="my-comments-list"></ul>
    </section>

    <p class="comments-empty" id="comments-empty" hidden>{t('post.commentEmpty')}</p>
    <p class="comments-error" id="comments-error" hidden role="alert"></p>
  </section>
) : (
  <section class="comments comments-disabled">
    <p class="comments-note">{t('post.commentDisabled')}</p>
  </section>
)}

<script>
  import { createClient } from '@supabase/supabase-js';

  const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
  const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

  // 本人评论令牌存储：[{ id, page, token }]，仅存于当前浏览器
  const STORE_KEY = 'styleblog-my-comments';
  function loadStore() {
    try { return JSON.parse(localStorage.getItem(STORE_KEY) || '[]'); } catch { return []; }
  }
  function saveStore(arr) {
    try { localStorage.setItem(STORE_KEY, JSON.stringify(arr)); } catch {}
  }

  function fmtDate(iso, lang) {
    const locale = lang === 'zh' ? 'zh-CN' : 'en-US';
    try {
      return new Date(iso).toLocaleString(locale, {
        year: 'numeric', month: '2-digit', day: '2-digit',
        hour: '2-digit', minute: '2-digit',
      });
    } catch (e) { return iso; }
  }

  async function main() {
    const root = document.getElementById('comments');
    if (!root) return;
    const page = root.dataset.page || '';
    const lang = root.dataset.lang || 'zh';
    const tRequired = root.dataset.required || '评论内容不能为空。';
    const tSending = root.dataset.sending || '发送中…';
    const tError = root.dataset.error || '评论发送失败，请稍后重试。';
    const tNameRequired = root.dataset.nameRequired || '昵称不能为空。';
    const tEmailInvalid = root.dataset.emailInvalid || '请输入有效的邮箱地址。';
    const tLoadFailed = root.dataset.loadFailed || '评论加载失败';
    const tRetry = root.dataset.retry || '重试';
    const tPending = root.dataset.pending || '评论已提交，审核通过后会展示。';
    const tMyTitle = root.dataset.myTitle || '我的评论';
    const tMineHint = root.dataset.mineHint || '';
    const tStatusPending = root.dataset.statusPending || '待审核';
    const tStatusApproved = root.dataset.statusApproved || '已通过';
    const tStatusRejected = root.dataset.statusRejected || '未通过';
    const tStatusRejectedNote = root.dataset.statusRejectedNote || '';
    const tDel = root.dataset.del || '删除';
    const tDelConfirm = root.dataset.delConfirm || '确定删除？';
    const tDeleted = root.dataset.deleted || '已删除';
    const tTokenMissing = root.dataset.tokenMissing || '';
    const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    const form = document.getElementById('comments-form');
    const nameEl = document.getElementById('comments-name');
    const emailEl = document.getElementById('comments-email');
    const hpEl = document.getElementById('comments-hp');
    const textEl = document.getElementById('comments-text');
    const submitBtn = document.getElementById('comments-submit');
    const msgEl = document.getElementById('comments-msg');
    const listEl = document.getElementById('comments-list');
    const emptyEl = document.getElementById('comments-empty');
    const errEl = document.getElementById('comments-error');
    const countEl = document.getElementById('comments-count');

    const mySection = document.getElementById('my-comments');
    const myTitleEl = document.getElementById('my-comments-title');
    const myHintEl = document.getElementById('my-comments-hint');
    const myListEl = document.getElementById('my-comments-list');

    // 本人评论 id 集合：公开列表中命中者追加内联删除按钮（身份=本地令牌匹配过）
    let myIds = new Set();

    // 渲染一条「公开」评论（已通过）。isReply=true 表示为管理员回复，缩进展示。
    // 已通过的本人评论「毕业」进入公开列表，但仍可在此自助删除：
    // 前端仅凭 myIds 决定「是否显示按钮」，真正的权限校验在服务端
    // delete_own_comment(p_id, p_token)——id 与令牌双条件匹配，非本人删不动。
    function renderPublicItem(list, c, isReply) {
      const li = document.createElement('li');
      li.className = 'comment-item' + (isReply ? ' comment-reply' : '');
      li.dataset.id = c.id;

      const head = document.createElement('div');
      head.className = 'comment-head';

      const name = document.createElement('span');
      name.className = 'comment-author';
      name.textContent = c.author || '匿名';
      head.appendChild(name);

      // 管理员身份徽标
      if (c.is_admin) {
        const badge = document.createElement('span');
        badge.className = 'comment-badge comment-badge--admin';
        badge.textContent = lang === 'en' ? 'Admin' : '管理员';
        head.appendChild(badge);
      }

      const time = document.createElement('span');
      time.className = 'comment-time';
      time.textContent = fmtDate(c.created_at, lang);
      head.appendChild(time);

      // 本人评论：内联删除入口（他人看不到这个按钮）
      if (myIds.has(c.id)) {
        const del = document.createElement('button');
        del.type = 'button';
        del.className = 'comment-del comment-del--inline';
        del.textContent = tDel;
        del.setAttribute('aria-label', tDel);
        del.addEventListener('click', () => deleteMine(c.id));
        head.appendChild(del);
      }

      const body = document.createElement('p');
      body.className = 'comment-body';
      body.textContent = c.content || '';

      li.appendChild(head);
      li.appendChild(body);
      list.appendChild(li);
      return li;
    }

    const supabase = createClient(SUPABASE_URL, SUPABASE_ANON_KEY, {
      auth: { persistSession: false },
    });

    function showListError(msg) {
      if (!errEl) return;
      emptyEl.hidden = true;
      errEl.hidden = false;
      errEl.textContent = tLoadFailed + (msg ? '：' + msg : '');
      const retry = document.createElement('button');
      retry.type = 'button';
      retry.className = 'comments-retry';
      retry.textContent = tRetry;
      retry.addEventListener('click', function () { loadPublic(); });
      errEl.appendChild(document.createTextNode(' '));
      errEl.appendChild(retry);
    }
    function hideListError() {
      if (errEl) { errEl.hidden = true; errEl.textContent = ''; }
    }

    function statusOf(c) {
      if (c.approved) return 'approved';
      if (c.rejected) return 'rejected';
      return 'pending';
    }

    // 渲染一条「我的评论」（含状态徽标与删除按钮）
    function renderMyItem(c) {
      const li = document.createElement('li');
      li.className = 'comment-item comment-mine';
      li.dataset.id = c.id;

      const head = document.createElement('div');
      head.className = 'comment-head';

      const name = document.createElement('span');
      name.className = 'comment-author';
      name.textContent = c.author || '匿名';

      const time = document.createElement('span');
      time.className = 'comment-time';
      time.textContent = fmtDate(c.created_at, lang);

      const badge = document.createElement('span');
      const st = statusOf(c);
      badge.className = 'comment-status comment-status--' + st;
      badge.textContent =
        st === 'approved' ? tStatusApproved : st === 'rejected' ? tStatusRejected : tStatusPending;

      head.appendChild(name);
      head.appendChild(time);
      head.appendChild(badge);

      const body = document.createElement('p');
      body.className = 'comment-body';
      body.textContent = c.content || '';

      li.appendChild(head);
      li.appendChild(body);

      // 未通过时补充说明
      if (st === 'rejected' && tStatusRejectedNote) {
        const note = document.createElement('p');
        note.className = 'comment-note';
        note.textContent = tStatusRejectedNote;
        li.appendChild(note);
      }

      const del = document.createElement('button');
      del.type = 'button';
      del.className = 'comment-del';
      del.textContent = tDel;
      del.addEventListener('click', () => deleteMine(c.id));
      li.appendChild(del);

      return li;
    }

    // 凭本地令牌取回「本人」评论（可能多条、跨多个令牌）
    async function loadMine() {
      const store = loadStore().filter((s) => s.page === page);
      if (!store.length) { toggleMy(false); return []; }
      const tokens = [...new Set(store.map((s) => s.token))];
      const all = [];
      for (const tk of tokens) {
        try {
          const { data } = await supabase.rpc('list_my_comments', { p_page: page, p_token: tk });
          if (data) all.push(...data);
        } catch (e) { console.warn('[comments] loadMine failed', e); }
      }
      const seen = new Set();
      const unique = all.filter((c) => c.id && !seen.has(c.id) ? (seen.add(c.id), true) : false);
      myIds = new Set(unique.map((c) => c.id));
      toggleMy(renderMine(unique) > 0);
      return unique;
    }

    function renderMine(list) {
      // 已通过的评论「毕业」进入公开列表（那里带内联删除按钮），
      // 本面板只保留待审核 / 未通过的评论，避免同一条评论两处出现。
      const visible = list.filter((c) => !c.approved);
      myListEl.innerHTML = '';
      visible.forEach((c) => myListEl.appendChild(renderMyItem(c)));
      return visible.length;
    }

    function toggleMy(show) {
      if (!mySection) return;
      mySection.hidden = !show;
      if (show) {
        myTitleEl.textContent = tMyTitle;
        myHintEl.textContent = tMineHint;
      }
    }

    async function deleteMine(id) {
      const store = loadStore();
      const entry = store.find((s) => s.id === id && s.page === page);
      if (!entry) return;
      if (!confirm(tDelConfirm)) return;
      try {
        const { error } = await supabase.rpc('delete_own_comment', { p_id: id, p_token: entry.token });
        if (error) { alert(tError + '：' + error.message); return; }
      } catch (e) {
        alert(tError + '：' + ((e && e.message) || String(e)));
        return;
      }
      // 本地令牌移除；该评论若曾在公开列表展示（已通过）则也一并移除
      saveStore(store.filter((s) => s.id !== id));
      const pub = listEl.querySelector('[data-id="' + id + '"]');
      if (pub) { pub.remove(); recountPublic(); }
      await loadMine();
      msgEl.textContent = tDeleted;
      msgEl.className = 'comments-msg';
    }

    async function loadPublic() {
      try {
        const { data, error } = await supabase
          .from('comments')
          .select('id, author, content, created_at, parent_id, is_admin')
          .eq('page', page)
          .eq('approved', true)
          .order('created_at', { ascending: true });
        if (error) {
          console.warn('[comments] load failed', error.message);
          showListError(error.message);
          return;
        }
        hideListError();
        listEl.innerHTML = '';
        // 本人评论不再从此过滤——已通过的评论属于公开内容，本人凭 myIds
        // 在行内看到删除按钮；「我的评论」面板只保留未通过/待审的。
        const rows = data || [];

        // 顶层评论（无 parent_id）；回复按 parent_id 归组
        const tops = rows.filter((c) => !c.parent_id);
        const topIds = new Set(tops.map((c) => c.id));
        const repliesByParent = {};
        const orphans = []; // 父评论不在公开列表（如本人评论）的回复，单独置顶展示
        rows.forEach((c) => {
          if (!c.parent_id) return;
          if (topIds.has(c.parent_id)) {
            (repliesByParent[c.parent_id] = repliesByParent[c.parent_id] || []).push(c);
          } else {
            orphans.push(c);
          }
        });

        let total = 0;
        tops.forEach((c) => {
          total++;
          const li = renderPublicItem(listEl, c, false);
          const reps = repliesByParent[c.id] || [];
          if (reps.length) {
            const ulRep = document.createElement('ul');
            ulRep.className = 'comment-replies';
            reps.forEach((r) => { total++; renderPublicItem(ulRep, r, true); });
            li.appendChild(ulRep);
          }
        });
        // 孤儿回复：父评论不可见时，仍独立展示（带缩进，标明是回复）
        orphans.forEach((c) => { total++; renderPublicItem(listEl, c, true); });

        countEl.textContent = String(total);
        emptyEl.hidden = total > 0;
      } catch (e) {
        console.warn('[comments] load threw', e);
        showListError((e && e.message) || String(e));
      }
    }

    function recountPublic() {
      const n = listEl.querySelectorAll('.comment-item').length;
      countEl.textContent = String(n);
      emptyEl.hidden = n > 0;
    }

    // 实时：审核通过的评论自动出现（仅已通过；订阅失败不影响展示）
    try {
      const channel = supabase
        .channel('comments:' + page)
        .on('postgres_changes', {
          event: 'INSERT', schema: 'public', table: 'comments',
          filter: 'page=eq.' + page,
        }, () => { loadPublic(); })
        .on('postgres_changes', {
          event: 'UPDATE', schema: 'public', table: 'comments',
          filter: 'page=eq.' + page,
        }, () => { loadPublic(); })
        .subscribe(function (status) {
          if (status === 'CHANNEL_ERROR' || status === 'TIMED_OUT') {
            console.warn('[comments] realtime 订阅失败（不影响显示，刷新页面即可）');
          }
        });
    } catch (e) {
      console.warn('[comments] realtime 订阅异常（不影响显示）', e);
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      msgEl.textContent = '';
      msgEl.className = 'comments-msg';
      // 蜜罐命中：假装成功，直接丢弃
      if (hpEl.value) { form.reset(); return; }

      const content = (textEl.value || '').trim();
      const author = (nameEl.value || '').trim();
      const email = (emailEl.value || '').trim();

      if (!author) {
        msgEl.textContent = tNameRequired;
        msgEl.className = 'comments-msg comments-msg-err';
        return;
      }
      if (!emailRe.test(email)) {
        msgEl.textContent = tEmailInvalid;
        msgEl.className = 'comments-msg comments-msg-err';
        return;
      }
      if (!content) {
        msgEl.textContent = tRequired;
        msgEl.className = 'comments-msg comments-msg-err';
        return;
      }

      submitBtn.disabled = true;
      const original = submitBtn.textContent;
      submitBtn.textContent = tSending;

      try {
        // 走 RPC 提交：服务端固定写入 approved=false（先审后放），并回传 delete_token 供本人删除
        const { data, error } = await supabase.rpc('add_comment', {
          p_page: page,
          p_author: author.slice(0, 40),
          p_email: email.slice(0, 120),
          p_content: content.slice(0, 1000),
        });

        if (error) {
          console.warn('[comments] add_comment failed', error.message);
          msgEl.textContent = tError + (error.message ? '：' + error.message : '');
          msgEl.className = 'comments-msg comments-msg-err';
          return;
        }
        const row = data && data[0];
        var tokenMissing = false;
        if (row && row.id) {
          if (row.delete_token) {
            const store = loadStore();
            store.push({ id: row.id, page, token: row.delete_token });
            saveStore(store);
          } else {
            // 防御：服务端未回传删除令牌（RPC 已保证生成，正常不应发生）。
            // 评论仍会进入审核流程，但没有本地凭证日后无法自助删除，明确提示。
            tokenMissing = true;
            console.warn('[comments] add_comment 未返回 delete_token，评论将无法自助删除');
          }
        }
      } catch (e) {
        console.warn('[comments] add_comment threw', e);
        msgEl.textContent = tError + '：' + ((e && e.message) || String(e));
        msgEl.className = 'comments-msg comments-msg-err';
        return;
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = original;
      }
      textEl.value = '';
      msgEl.textContent = tokenMissing ? tPending + ' ' + tTokenMissing : tPending;
      msgEl.className = 'comments-msg' + (tokenMissing ? ' comments-msg-warn' : '');
      // 待审核：不进入公开列表，仅刷新「我的评论」面板展示状态
      await loadMine();
    });

    // 先取本人评论（得到 myIds 用于去重），再加载公开列表
    await loadMine();
    await loadPublic();
  }

  main().catch(function (e) {
    console.warn('[comments] main threw', e);
    var root = document.getElementById('comments');
    if (!root) return;
    var errEl = document.getElementById('comments-error');
    var emptyEl = document.getElementById('comments-empty');
    if (errEl) {
      if (emptyEl) emptyEl.hidden = true;
      errEl.hidden = false;
      errEl.textContent = (root.dataset.loadFailed || '评论加载失败') +
        '：' + ((e && e.message) || String(e));
    }
  });
</script>
