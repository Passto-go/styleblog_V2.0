---
import Icon from './Icon.astro';
import { site } from '../data/site.js';
import { getSetting } from '../lib/posts.js';
import { useTranslations } from '../i18n/ui.js';

const { lang = 'zh' } = Astro.props;
const t = useTranslations(lang);

// 优先用后台设置的倒计时；表未建 / 未设置时回退到 site.js 默认值
const setting = await getSetting('countdown');
const cfg = setting && setting.target ? setting : site.countdown;
const name = cfg.name || cfg.label || '';
const target = cfg.target;

// 倒计时统一按北京时间（UTC+8）锚定，避免「同一设置、不同结果」：
//   1) 存量朴素 ISO（无时区后缀）按 +08:00 解释，而非访客本地时区；
//   2) 已带 Z / ±HH:MM 后缀的值尊重原样，不重复拼接。
function normalizeTz(iso) {
  const s = String(iso || '').trim();
  if (!s) return s;
  if (/[zZ]$/.test(s) || /[+-]\d{2}:?\d{2}$/.test(s)) return s;
  return s + '+08:00';
}
const tzTarget = normalizeTz(target);

const labels = lang === 'en' ? ['Days', 'Hrs', 'Min', 'Sec'] : ['天', '时', '分', '秒'];
const units = ['d', 'h', 'm', 's'];

function fmtDate(iso, l) {
  const d = new Date(normalizeTz(iso));
  if (Number.isNaN(d.getTime())) return '';
  // 服务端运行时 TZ 为 UTC，必须显式锁定 Asia/Shanghai 取日期分量
  const opts = { timeZone: 'Asia/Shanghai', year: 'numeric', day: 'numeric' };
  if (l === 'en') {
    return d.toLocaleDateString('en-US', { ...opts, month: 'short' });
  }
  return d.toLocaleDateString('zh-CN', { ...opts, month: 'long' });
}
const dateStr = fmtDate(target, lang);
const fullLabel = name ? `${name}（${dateStr}）` : dateStr;
---
<section class="widget">
  <h4 class="widget-title">
    <Icon name="clock" size={15} /> {t('widget.countdown')}
    <span class="countdown-tz">{t('widget.countdownTz')}</span>
  </h4>
  <p class="countdown-label">{t('widget.countdownTo', { label: fullLabel })}</p>
  <div class="countdown-grid" id="countdown">
    {units.map((u, i) => (
      <div class="cd-cell">
        <div class="cd-num" data-cd={u}>--</div>
        <div class="cd-lbl">{labels[i]}</div>
      </div>
    ))}
  </div>
</section>

<script define:vars={{ target: tzTarget }}>
  (function () {
    var el = document.getElementById('countdown');
    if (!el) return;
    // target 已在服务端归一化为带 +08:00 的 ISO，本地解析即北京时间终点
    var end = new Date(target).getTime();
    function p2(n) { return String(n).padStart(2, '0'); }
    function tick() {
      var diff = end - Date.now();
      if (diff < 0) diff = 0;
      var d = Math.floor(diff / 86400000);
      var h = Math.floor((diff % 86400000) / 3600000);
      var m = Math.floor((diff % 3600000) / 60000);
      var s = Math.floor((diff % 60000) / 1000);
      el.querySelector('[data-cd="d"]').textContent = d;
      el.querySelector('[data-cd="h"]').textContent = p2(h);
      el.querySelector('[data-cd="m"]').textContent = p2(m);
      el.querySelector('[data-cd="s"]').textContent = p2(s);
    }
    tick();
    setInterval(tick, 1000);
  })();
</script>
