---
import Icon from './Icon.astro';
import { site } from '../data/site.js';
import { getSetting } from '../lib/posts.js';
import { useTranslations } from '../i18n/ui.js';

const { lang = 'zh' } = Astro.props;
const t = useTranslations(lang);

// 优先用后台设置的倒计时；表未建 / 未设置时回退到 site.js 默认值
const setting = await getSetting('countdown');
const cfg = setting && setting.target ? setting : site.countdown;
const name = cfg.name || cfg.label || '';
const target = cfg.target;

// 倒计时统一按北京时间（UTC+8）锚定，避免「同一设置、不同结果」：
//   1) 存量朴素 ISO（无时区后缀）按 +08:00 解释，而非访客本地时区；
//   2) 已带 Z / ±HH:MM 后缀的值尊重原样，不重复拼接。
function normalizeTz(iso) {
  const s = String(iso || '').trim();
  if (!s) return s;
  if (/[zZ]$/.test(s) || /[+-]\d{2}:?\d{2}$/.test(s)) return s;
  return s + '+08:00';
}
const tzTarget = normalizeTz(target);

// units / labels 在 isPast 判定后按模式定义（见下方），此处仅占位

function fmtDate(iso, l) {
  const d = new Date(normalizeTz(iso));
  if (Number.isNaN(d.getTime())) return '';
  // 服务端运行时 TZ 为 UTC，必须显式锁定 Asia/Shanghai 取日期分量
  const opts = { timeZone: 'Asia/Shanghai', year: 'numeric', day: 'numeric' };
  if (l === 'en') {
    return d.toLocaleDateString('en-US', { ...opts, month: 'short' });
  }
  return d.toLocaleDateString('zh-CN', { ...opts, month: 'long' });
}
const dateStr = fmtDate(target, lang);
// L-04：目标时间非法（后台填错格式 / 空值）时，服务端先校验；
// 非法则整块不渲染，避免页面上出现「NaN 天 NaN 时」和一个永远在跑的定时器。
const isValidTarget = !!tzTarget && !Number.isNaN(new Date(tzTarget).getTime());
const fullLabel = name ? `${name}（${dateStr}）` : dateStr;
// 模式自动判定：目标时刻已过去 → 纪念日（展示已过去天数）；否则 → 倒计时。
// 沿用北京时间锚定（target 已归一化为 +08:00），与现有设计口径一致。
const isPast = isValidTarget && new Date(tzTarget).getTime() <= Date.now();
const subLabel = isPast
  ? t('widget.countdownSince', { label: fullLabel })
  : t('widget.countdownTo', { label: fullLabel });
// 模式分支：过去态 → 年/月/天（纪念日）；未来态 → 天/时/分/秒（倒计时）
const units = isPast ? ['y', 'm', 'd'] : ['d', 'h', 'm', 's'];
const labels = isPast
  ? (lang === 'en' ? ['Yrs', 'Mo', 'Days'] : ['年', '个月', '天'])
  : (lang === 'en' ? ['Days', 'Hrs', 'Min', 'Sec'] : ['天', '时', '分', '秒']);
---
{isValidTarget && (
<section class="widget">
  <h4 class="widget-title">
    <Icon name="clock" size={15} /> {t('widget.countdown')}
    <span class="countdown-tz">{t('widget.countdownTz')}</span>
  </h4>
  <p class="countdown-label">{subLabel}</p>
  <div class="countdown-grid" id="countdown">
    {units.map((u, i) => (
      <div class="cd-cell">
        <div class="cd-num" data-cd={u}>--</div>
        <div class="cd-lbl">{labels[i]}</div>
      </div>
    ))}
  </div>
</section>
)}

<script define:vars={{ target: tzTarget, isPast }}>
  (function () {
    var el = document.getElementById('countdown');
    if (!el) return;
    // target 已在服务端归一化为带 +08:00 的 ISO，本地解析即北京时间终点
    // isPast 由服务端按北京时间锚定判定（未来=倒计时 / 过去=纪念日）
    var endMs = new Date(target).getTime();
    var past = isPast;
    // L-04 双保险：服务端已过滤非法目标，这里再判一次 NaN
    if (!isFinite(endMs)) {
      el.querySelectorAll('[data-cd]').forEach(function (n) { n.textContent = '--'; });
      return;
    }
    function pad(n) { return String(n).padStart(2, '0'); }
    // 按北京时间（Asia/Shanghai）取日历分量，与全站时区口径一致，避免本地时区导致跨月/跨年差 1
    function shParts(date) {
      var s = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Shanghai', year: 'numeric', month: '2-digit', day: '2-digit' }).format(date);
      var p = s.split('-');
      return { y: +p[0], m: +p[1], d: +p[2] };
    }
    // 过去态：算 年/月/天（纪念日风格），处理借位与大小月
    function ymd(from, to) {
      var y = to.y - from.y, m = to.m - from.m, d = to.d - from.d;
      if (d < 0) { m -= 1; d += new Date(to.y, to.m - 1, 0).getDate(); }
      if (m < 0) { y -= 1; m += 12; }
      return [y, m, d];
    }
    var endParts = shParts(new Date(target));
    // 数字自适应：位数变多（如天数跨 1000）时缩小字号，防止顶破底色框
    function fit() {
      var nums = el.querySelectorAll('.cd-num');
      nums.forEach(function (n) { n.style.fontSize = ''; });
      nums.forEach(function (n) {
        var cell = n.closest('.cd-cell');
        if (!cell) return;
        var avail = cell.clientWidth - 8;
        if (n.scrollWidth > avail) {
          var base = parseFloat(getComputedStyle(n).fontSize);
          n.style.fontSize = (base * (avail / n.scrollWidth) * 0.98) + 'px';
        }
      });
    }
    function tick() {
      if (past) {
        // 过去态：年 / 月 / 天（纪念日），按北京时间日历计算
        var parts = ymd(endParts, shParts(new Date()));
        el.querySelector('[data-cd="y"]').textContent = parts[0];
        el.querySelector('[data-cd="m"]').textContent = parts[1];
        el.querySelector('[data-cd="d"]').textContent = parts[2];
      } else {
        // 未来态：天 / 时 / 分 / 秒（倒计时，递减到 0）
        var diff = endMs - Date.now();
        if (!isFinite(diff) || diff < 0) diff = 0;
        var d = Math.floor(diff / 86400000);
        var h = Math.floor((diff % 86400000) / 3600000);
        var m = Math.floor((diff % 3600000) / 60000);
        var s = Math.floor((diff % 60000) / 1000);
        el.querySelector('[data-cd="d"]').textContent = d;
        el.querySelector('[data-cd="h"]').textContent = pad(h);
        el.querySelector('[data-cd="m"]').textContent = pad(m);
        el.querySelector('[data-cd="s"]').textContent = pad(s);
      }
      fit();
    }
    tick();
    var timer = setInterval(tick, 1000);
    // L-05：页面进入 bfcache / 离开时清掉定时器，回来再重启，避免后台空转
    window.addEventListener('pagehide', function () { clearInterval(timer); });
    window.addEventListener('pageshow', function (e) {
      if (e.persisted) { clearInterval(timer); tick(); timer = setInterval(tick, 1000); }
    });
  })();
</script>
