---
// 页面溯源水印：全站前端页面叠加一层半透明、平铺重复的标识，
// 截图外泄时可按「访客 IP · 日期 · 品牌名」反向溯源。
// 标识来源：服务端取 CF-Connecting-IP（匿名访客即可溯源，无需登录态）；
// 叠加访问者当地日期与品牌名（吾道一以贯之 / The Way, One Thread，零域名）。
//
// 日期口径（三层降级，优先级从高到低）：
//   ① 浏览器时区 —— 客户端读 Intl.DateTimeFormat().resolvedOptions().timeZone，精确到设备，免费；
//   ② IP 国家   —— 服务端 CF-IPCountry 映射该国代表时区，用于 JS 禁用等场景兜底；
//   ③ 北京时间  —— 两者都不可得时的最终兜底（保持原有行为）。
// 服务端先按 ② 算出初始日期，保证即便禁用 JS 也不会留空；客户端能拿到时区时再替换为 ①。
import { site, pickI18n } from '../data/site.js';

const { lang = 'zh' } = Astro.props;
const rawIp = Astro.request?.headers?.get?.('cf-connecting-ip') || '';

// IPv6 地址极长（最长 39 字符），整串画进 canvas 会把日期和品牌名挤出画布。
// 这里保留前 4 段（如 240e:39e:490:b5b1），长度稳定且仍能溯源到具体网络；
// IPv4 保持完整。
function shortenIp(ip) {
  if (!ip) return 'guest';
  if (!ip.includes(':')) return ip;
  return ip.split(':').filter(Boolean).slice(0, 4).join(':');
}
const who = shortenIp(rawIp);

// IP 国家 → 代表时区。仅用于「拿不到浏览器时区」时的兜底，
// 跨多时区的大国（美/俄/澳/加/巴西）只能取一个国家代表时区，会存在偏差。
const COUNTRY_TZ = {
  CN: 'Asia/Shanghai', HK: 'Asia/Hong_Kong', MO: 'Asia/Macau', TW: 'Asia/Taipei',
  JP: 'Asia/Tokyo', KR: 'Asia/Seoul', SG: 'Asia/Singapore', MY: 'Asia/Kuala_Lumpur',
  TH: 'Asia/Bangkok', VN: 'Asia/Ho_Chi_Minh', ID: 'Asia/Jakarta', PH: 'Asia/Manila',
  IN: 'Asia/Kolkata', PK: 'Asia/Karachi', BD: 'Asia/Dhaka', NP: 'Asia/Kathmandu',
  AE: 'Asia/Dubai', SA: 'Asia/Riyadh', IL: 'Asia/Jerusalem', TR: 'Europe/Istanbul',
  GB: 'Europe/London', IE: 'Europe/Dublin', FR: 'Europe/Paris', DE: 'Europe/Berlin',
  NL: 'Europe/Amsterdam', ES: 'Europe/Madrid', IT: 'Europe/Rome', CH: 'Europe/Zurich',
  SE: 'Europe/Stockholm', NO: 'Europe/Oslo', PL: 'Europe/Warsaw', RU: 'Europe/Moscow',
  UA: 'Europe/Kyiv', US: 'America/New_York', CA: 'America/Toronto', MX: 'America/Mexico_City',
  BR: 'America/Sao_Paulo', AR: 'America/Argentina/Buenos_Aires', CL: 'America/Santiago',
  AU: 'Australia/Sydney', NZ: 'Pacific/Auckland', ZA: 'Africa/Johannesburg',
  EG: 'Africa/Cairo', NG: 'Africa/Lagos', KE: 'Africa/Nairobi',
};

function formatDateIn(tz) {
  try {
    return new Intl.DateTimeFormat('en-CA', {
      timeZone: tz, year: 'numeric', month: '2-digit', day: '2-digit',
    }).format(new Date());
  } catch {
    // 时区名非法时退回北京时间
    return new Intl.DateTimeFormat('en-CA', {
      timeZone: 'Asia/Shanghai', year: 'numeric', month: '2-digit', day: '2-digit',
    }).format(new Date());
  }
}

const country = (Astro.request?.headers?.get?.('cf-ipcountry') || '').toUpperCase();
// ② IP 国家兜底；③ 无国家信息时用北京时间
const serverTz = COUNTRY_TZ[country] || 'Asia/Shanghai';
const date = formatDateIn(serverTz);

const brand = pickI18n(site.name, lang);
const mark = `${who} · ${date} · ${brand}`;
---
<div id="wm" class="site-watermark" aria-hidden="true" data-mark={mark}></div>

<script is:inline>
  (function () {
    var el = document.getElementById('wm');
    if (!el) return;

    // ① 浏览器时区优先：精确到访问设备，不受代理/VPN 出口影响。
    // 拿到后重算日期，替换服务端（IP 国家）算出的日期部分，再绘制。
    function localDate() {
      try {
        var tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
        if (!tz) return '';
        return new Intl.DateTimeFormat('en-CA', {
          timeZone: tz, year: 'numeric', month: '2-digit', day: '2-digit',
        }).format(new Date());
      } catch (e) {
        return '';
      }
    }

    var mark = el.getAttribute('data-mark') || '';
    if (!mark) return;

    // mark 形如 "IP · YYYY-MM-DD · 品牌名"，中间那段是日期
    var parts = mark.split(' · ');
    if (parts.length >= 3) {
      var d = localDate();
      if (d && d !== parts[1]) {
        parts[1] = d;
        mark = parts.join(' · ');
        el.setAttribute('data-mark', mark);
      }
    }

    var text = mark;
    var FONT = '13px system-ui, -apple-system, "Segoe UI", sans-serif';
    var ANGLE = -Math.PI / 6;   // 斜向 -30°
    var PADDING = 24;           // 单个水印块四周留白，避免文字被裁

    // 用离屏画布量出文字实际宽度，再按旋转 -30° 后的包围盒动态定尺寸。
    // 之前写死 260x150，IPv6 访客的长文本会溢出画布被直接裁掉。
    var probe = document.createElement('canvas').getContext('2d');
    probe.font = FONT;
    var textW = probe.measureText(text).width;

    var cos = Math.abs(Math.cos(ANGLE));
    var sin = Math.abs(Math.sin(ANGLE));
    var boxW = textW * cos + 14 * sin;
    var boxH = textW * sin + 14 * cos;

    var c = document.createElement('canvas');
    c.width = Math.ceil(boxW + PADDING * 2);
    c.height = Math.ceil(boxH + PADDING * 2);

    var ctx = c.getContext('2d');
    ctx.font = FONT;
    ctx.fillStyle = 'rgba(128,128,128,0.10)'; // 浅灰、低透明，几乎无感
    // 居中后旋转，保证整行文字完整落在画布内（不再从左侧溢出）
    ctx.translate(c.width / 2, c.height / 2);
    ctx.rotate(ANGLE);
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText(text, 0, 0);

    el.style.backgroundImage = 'url(' + c.toDataURL() + ')';
    el.style.backgroundSize = c.width + 'px ' + c.height + 'px';
  })();
</script>

<style>
  .site-watermark {
    position: fixed;
    inset: 0;
    /* 必须低于所有交互浮层：分享二维码(130)、复制 toast(120)、抽屉(90)、
       后台弹层(9999)、同意横幅(10000)。此前用 9998 会把二维码/
       toast 压在灰纹下面，暗色模式尤其影响扫码（M-08）。 */
    z-index: 1;
    pointer-events: none;       /* 不拦截任何点击 / 选中 */
    background-repeat: repeat;
  }
  /* 深色主题下把灰字提亮，保持可见但不刺眼 */
  :global([data-theme='dark']) .site-watermark {
    filter: invert(1) opacity(0.45);
  }
</style>
