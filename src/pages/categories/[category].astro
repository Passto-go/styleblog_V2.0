---
import CategoryPage from '../../components/pages/CategoryPage.astro';
import FourOhFour from '../404.astro';
import {
  getCategories,
  getRegisteredCategorySlugs,
  getCategoryAlias,
  slugify,
} from '../../lib/posts.js';

// SSR：每请求现查 Supabase，新分类/新文章发布后即刻可访问，无需重新构建
const { category } = Astro.params;
const cats = await getCategories('zh');
let cat = cats.find((c) => c.slug === category) || null;

// 兼容层：分类改名后，旧 slug 不再精确匹配。
// 若请求的 slug 恰好等于某分类「显示名 slugify」的衍生值，则 301 跳转到正确 slug（覆盖仅改显示名的场景）。
if (!cat) {
  // 严格 301：旧 slug 映射到新 slug（重命名分类改 slug 后写入 category_aliases）
  const alias = await getCategoryAlias(category);
  if (alias) return Astro.redirect(`/categories/${alias}`, 301);
  // 兼容层：仅改了显示名、slug 随之变（未手动改 slug）的场景。
  // 旧逻辑用「当前显示名」反推 slug，会误判：未注册在 categories 表、但文章里存在的 slug
  // （历史脏数据）经过这里会被跳到「按文章分类名 slugify」猜出来的地址，可能 404。
  // 现在只对「请求的 slug 确实属于某个已注册分类的中文名 slugify」的情况放行。
  const registered = new Set(await getRegisteredCategorySlugs());
  const byName = cats.find((c) => registered.has(c.slug) && slugify(c.name) === category);
  if (byName) return Astro.redirect(`/categories/${byName.slug}`, 301);
  Astro.response.status = 404;
}
---
{cat ? <CategoryPage lang="zh" slug={cat.slug} /> : <FourOhFour lang="zh" />}
