---
import CategoryPage from '../../../components/pages/CategoryPage.astro';
import FourOhFour from '../../404.astro';
import { getCategories } from '../../../lib/posts.js';

// SSR：每请求现查 Supabase，新分类/新文章发布后即刻可访问，无需重新构建
// 常量路径优先（如 /en/categories/travelogues/）：Astro 会先匹配静态文件，所以带尾斜杠的
// 规范地址仍由常量页渲染（与改动前完全一致）；不带尾斜杠的同一 slug 会落到这里，
// 统一 301 到规范地址，避免同一分类出现两个可访问 URL。
// 注意：exploration 没有常量页，不能放进这个集合，否则会被跳到不存在的地址。
const CONSTANT_SLUGS = new Set(['travelogues', 'thoughts', 'techstack']);
const { category } = Astro.params;

if (CONSTANT_SLUGS.has(category)) {
  const canonical = `/en/categories/${category}/`;
  if (Astro.url.pathname !== canonical) return Astro.redirect(canonical, 301);
}

// 只为「已注册分类」渲染；注册表里没有的 slug 一律 404，避免与常量页重复内链
const cat = (await getCategories('en', { skipPosts: true }))
  .find((c) => c.slug === category && c.fromRegistry) || null;
if (!cat) Astro.response.status = 404;
---
{cat ? <CategoryPage lang="en" slug={cat.slug} /> : <FourOhFour lang="en" />}
