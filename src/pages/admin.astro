---
import AdminLayout from '../layouts/AdminLayout.astro';

// 后台是纯客户端应用（数据全部由浏览器直连 Supabase），本身无 SSR 数据需求。
// 但必须按请求渲染 + no-store：若预渲染为静态 HTML，边缘/浏览器会缓存页面与
// hoisted JS bundle，部署更新后已打开的标签页仍跑旧代码（翻译文案不更新、
// 旧 bug 不修复的根因之一）。
export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store');
---

<AdminLayout title="后台管理界面" description="登录后在线撰写与发布文章">
  <div class="wb">

    <!-- ============ 未登录 ============ -->
    <section id="login-view" class="wb-login" hidden>
      <form id="login-form" class="wb-login-card">
        <h1>后台管理界面</h1>
        <p class="wb-sub">登录后即可撰写、发布文章</p>

        <div id="cfg-note" class="wb-alert" hidden>
          未检测到 Supabase 配置。请在部署平台的环境变量中填入
          <code>PUBLIC_SUPABASE_URL</code> 与 <code>PUBLIC_SUPABASE_ANON_KEY</code> 后重新部署。
        </div>

        <label for="email">邮箱</label>
        <input id="email" type="email" autocomplete="username" placeholder="you@example.com" required />
        <label for="password">密码</label>
        <input id="password" type="password" autocomplete="current-password" placeholder="••••••••" required />

        <button class="btn" type="submit">登录</button>
        <span id="login-msg" class="wb-hint"></span>
      </form>
    </section>

    <!-- ============ 工作台 ============ -->
    <section id="workbench" class="wb-bench" hidden>
      <header class="wb-top">
        <div class="wb-top-left">
          <strong>后台管理界面</strong>
          <span id="wb-user" class="wb-user"></span>
        </div>
        <div class="wb-top-right">
          <a class="wb-mini-link" href="/" target="_blank" rel="noopener" title="在新标签页打开站点首页">查看站点 ↗</a>
          <button id="logout-btn" class="wb-mini-btn" type="button">退出</button>
        </div>
      </header>

      <!-- 模块导航：文章管理 / 评论管理 / 其他功能 -->
      <nav class="wb-modnav" id="wb-modnav">
        <button type="button" data-mod="write" class="on">文章管理</button>
        <button type="button" data-mod="files">文件管理</button>
        <button type="button" data-mod="comments">评论管理</button>
        <button type="button" data-mod="misc">其他功能</button>
      </nav>

      <!-- ============ 模块一：文章管理 ============ -->
      <section id="mod-write" class="wb-module">
        <div class="wb-grid">
          <!-- ---------- 编辑列 ---------- -->
          <div class="wb-main">
            <div class="wb-card wb-editor-card">
              <button id="editor-close" class="wb-editor-close" type="button" title="关闭，返回文章列表" aria-label="关闭">✕</button>
              <input id="f-title" class="wb-title" placeholder="文章标题" />

              <div class="wb-meta">
                <div class="wb-seg" id="f-lang" role="group" aria-label="语言">
                  <button type="button" data-v="zh" class="on">中文</button>
                  <button type="button" data-v="en">EN</button>
                </div>
                <select id="f-category" class="wb-cat" aria-label="分类"></select>
                <div id="new-cat-box" class="wb-cat-new" hidden>
                  <span class="wb-cat-new-label">新建分类</span>
                  <input id="new-cat-name" class="wb-cat" placeholder="显示名，如：技术随笔" />
                  <input id="new-cat-slug" class="wb-cat" placeholder="slug（留空自动生成）" />
                  <span id="new-cat-preview" class="wb-cat-slug-preview"></span>
                  <span class="wb-hint wb-cat-new-hint">名称＝前台显示的分类名；Slug＝网址里的英文后缀（仅小写字母/数字/-）。</span>
                </div>
                <div class="wb-seg" id="f-status" role="group" aria-label="状态">
                  <button type="button" data-v="draft" class="on">草稿</button>
                  <button type="button" data-v="published">已发布</button>
                </div>
                <input id="f-author" class="wb-author-input" type="text" placeholder="作者" aria-label="作者" autocomplete="off" />
              </div>

              <div class="wb-tabs" id="wb-tabs">
                <button type="button" data-tab="edit" class="on">编辑</button>
                <button type="button" data-tab="preview">预览</button>
                <button type="button" data-tab="split">分屏</button>
              </div>

              <div class="wb-editor" id="wb-editor" data-tab="edit">
                <textarea id="f-content" placeholder="用 Markdown 写作…&#10;&#10;# 二级标题&#10;正文、**加粗**、`代码`、![图片](https://…)"></textarea>
                <div id="preview" class="wb-preview content"></div>
              </div>

              <div class="wb-toolbar">
                <label class="wb-upload" title="上传图片插入正文（正文插图）">
                  插入图片
                  <input id="f-image" type="file" accept="image/*" multiple hidden />
                </label>
                <label class="wb-upload wb-upload-att" title="上传文件作为文章附件：展示在正文页底部「附件」区，仅文件名、点击下载，不进正文">
                  上传附件
                  <input id="f-attach" type="file" accept=".pdf,.doc,.docx,.ppt,.pptx,.xls,.xlsx,.csv,.txt,.md,.zip,image/*" multiple hidden />
                </label>
                <span id="upload-msg" class="wb-hint"></span>
                <span id="attach-msg" class="wb-hint"></span>
              </div>

              <div class="wb-trbar">
                <span class="wb-trbar-label">一键翻译</span>
                <button id="tr-en-btn" class="wb-tr-btn" type="button" title="把当前文章译成英文并填入编辑器，检查后发布即创建/更新英文版">译成英文</button>
                <span id="lang-state" class="wb-langstate"></span>
                <span id="tr-msg" class="wb-hint"></span>
              </div>

              <details class="wb-more">
                <summary>更多设置（发布时间 / Slug / 摘要 / 封面 / 访问加密）</summary>
                <div class="wb-more-body">
                  <label>发布时间<input id="f-published-at" type="datetime-local" /><small id="published-at-hint" class="wb-hint">修改已发布文章的展示与排序时间；留空则保持原时间</small></label>
                  <label>Slug<input id="f-slug" placeholder="留空自动生成" /><small id="slug-hint" class="wb-hint"></small></label>
                  <div class="wb-more-field">
                    <label for="f-excerpt">摘要</label>
                    <div class="wb-excerpt-row">
                      <input id="f-excerpt" placeholder="留空则发布时按正文自动生成" />
                      <button id="ai-excerpt-btn" class="btn btn-ghost" type="button" title="调用 AI 按正文生成摘要，不自动保存">✨ AI 生成</button>
                    </div>
                    <small id="excerpt-hint" class="wb-hint">用于列表卡片、文章首段、搜索、RSS 与分享卡片。留空发布时自动按正文截取；点右侧按钮可用 AI 生成</small>
                  </div>
                  <label>封面 URL<input id="f-cover" placeholder="https://…" /></label>
                  <div class="wb-more-field wb-enc">
                    <label class="wb-enc-toggle" for="f-encrypted"><input type="checkbox" id="f-encrypted" /> 启用访问加密</label>
                    <small class="wb-hint">开启后前台文章页先显示密码框，密码正确才展示正文；文章不进列表/归档/搜索/sitemap，搜索引擎不收录。多语言版本共享同一密码（按文章基准 slug）。</small>
                    <div id="enc-fields" class="wb-enc-fields" hidden>
                      <input id="f-enc-pw" type="password" placeholder="设置访问密码（留空 = 不修改原密码）" autocomplete="new-password" />
                      <input id="f-enc-hint" type="text" placeholder="密码提示语（可选，如：生日八位）" maxlength="60" />
                      <small class="wb-hint">密码在数据库端哈希保存，后台与前台均不可见；取消勾选并保存即解除加密。</small>
                    </div>
                  </div>
                </div>
              </details>

              <details class="wb-more" id="attach-details">
                <summary>附件（显示在文章底部，可下载，不进正文）</summary>
                <div class="wb-more-body">
                  <ul id="attach-list" class="wb-attach-list"></ul>
                  <small class="wb-hint">用工具栏「上传附件」添加；附件出现在正文页底部「附件」区，仅显示文件名、点击下载，与正文插图互不干扰。保存文章后此处才会列出该文的附件。</small>
                </div>
              </details>

              <div class="wb-actions">
                <button id="save-draft-btn" class="btn btn-ghost" type="button">存草稿</button>
                <button id="publish-btn" class="btn" type="button">发布并上线</button>
                <button id="delete-btn" class="btn btn-danger" type="button" hidden>删除</button>
                <span id="save-msg" class="wb-hint"></span>
              </div>
            </div>
          </div>

          <!-- ---------- 列表列 ---------- -->
          <aside class="wb-side">
            <div class="wb-card">
              <div class="wb-side-head">
                <strong>文章</strong>
                <span id="wb-count" class="wb-hint"></span>
                <button id="new-article-btn" class="wb-new-article" type="button" title="新建一篇空白文章">＋ 新建文章</button>
              </div>
              <input id="wb-search" class="wb-search" type="search" placeholder="搜索标题…" />
              <div class="wb-filter" id="wb-filter">
                <button type="button" data-f="all" class="on">全部</button>
                <button type="button" data-f="published">已发布</button>
                <button type="button" data-f="draft">草稿</button>
                <button type="button" data-f="trash">垃圾箱<span id="trash-count" class="wb-filter-badge" hidden></span></button>
              </div>
              <ul id="post-list" class="wb-list"></ul>
            </div>
          </aside>
        </div>
      </section>

      <!-- ============ 模块二：文件管理 ============ -->
      <section id="mod-files" class="wb-module" hidden>
        <div class="wb-card" id="fm-card">
          <div class="wb-side-head">
            <strong>文件管理</strong>
            <span id="fm-count" class="wb-hint"></span>
          </div>
          <p class="wb-hint wb-cat-note">
            这里管理所有已上传的图片与附件。删除文章时会自动清理其名下文件；
            「孤儿文件」指已上传但没有任何文章引用它们——正文、封面都算引用，附件只要归属了文章（上传时带文章上下文）也不算孤儿，可一键清理。
          </p>

          <div class="wb-fm-actions">
            <label class="btn btn-ghost wb-upload">
              上传文件
              <input id="fm-upload-input" type="file" multiple hidden />
            </label>
            <button id="fm-clean-orphans" class="btn btn-ghost" type="button">清理孤儿文件</button>
            <button id="fm-refresh" class="btn btn-ghost" type="button">刷新</button>
            <span id="fm-msg" class="wb-hint"></span>
          </div>

          <div class="wb-filter" id="fm-filter">
            <button type="button" data-f="all" class="on">全部</button>
            <button type="button" data-f="images">图片</button>
            <button type="button" data-f="attachments">附件</button>
            <button type="button" data-f="orphan">孤儿文件</button>
          </div>
          <input id="fm-search" class="wb-search" type="search" placeholder="搜索文件名或所属文章…" />
          <ul id="fm-list" class="wb-list wb-fm-list"></ul>
        </div>
      </section>

      <!-- ============ 模块三：评论管理 ============ -->
      <section id="mod-comments" class="wb-module" hidden>
        <div class="wb-card" id="cm-card">
          <div class="wb-side-head">
            <strong>评论管理</strong>
            <span id="cm-count" class="wb-hint"></span>
          </div>
          <div class="wb-filter" id="cm-filter">
            <button type="button" data-f="all" class="on">全部</button>
            <button type="button" data-f="pending">待审核</button>
            <button type="button" data-f="approved">已通过</button>
            <button type="button" data-f="rejected">未通过</button>
          </div>
          <ul id="cm-list" class="wb-list"></ul>
        </div>
      </section>

      <!-- ============ 模块三：其他功能 ============ -->
      <section id="mod-misc" class="wb-module" hidden>
        <div class="wb-grid-misc">
          <div class="wb-misc-col">
            <div class="wb-card" id="cd-card">
              <div class="wb-side-head"><strong>首页倒计时</strong></div>
              <label class="wb-field">名称<input id="cd-name" placeholder="如：元旦" /></label>
              <label class="wb-field">日期<input id="cd-date" type="date" /></label>
              <button id="cd-save" class="btn" type="button">保存倒计时</button>
              <span id="cd-msg" class="wb-hint"></span>
            </div>

            <div class="wb-card" id="ex-card">
              <div class="wb-side-head"><strong>摘要自动生成</strong></div>
              <p class="wb-hint wb-cat-note">发布时若摘要留空，按下列设置从正文自动截取；列表卡片、搜索、RSS、分享卡片均使用该摘要。</p>
              <label class="wb-field">长度上限
                <select id="ex-maxlen">
                  <option value="100">100 字</option>
                  <option value="150">150 字</option>
                  <option value="200">200 字（推荐）</option>
                  <option value="300">300 字</option>
                </select>
              </label>
              <label class="wb-field">AI 生成风格
                <select id="ex-style">
                  <option value="plain">陈述式（客观概括）</option>
                  <option value="points">要点式（信息密度优先）</option>
                  <option value="hook">悬念式（引发兴趣）</option>
                </select>
              </label>
              <button id="ex-save" class="btn" type="button">保存设置</button>
              <span id="ex-msg" class="wb-hint"></span>
            </div>

            <div class="wb-card" id="avatar-card">
              <div class="wb-side-head">
                <strong>头像</strong>
                <span id="avatar-src" class="wb-hint"></span>
                <button id="avatar-hist-btn" class="wb-avatar-hist-btn" type="button"
                        aria-expanded="false" aria-controls="avatar-hist-panel">
                  历史头像 <span id="avatar-hist-n">(0)</span>
                  <span class="wb-avatar-hist-arrow" aria-hidden="true">⌄</span>
                </button>
              </div>
              <p class="wb-hint wb-cat-note">显示在首页与文章页的资料卡上。支持 PNG / JPG / WebP / GIF，单张不超过 2 MB；建议正方形（如 512×512），非正方形会自动居中裁切。</p>
              <div class="wb-avatar-row">
                <div class="wb-avatar-preview" id="avatar-preview">
                  <span class="wb-avatar-fallback">贯</span>
                </div>
                <div class="wb-avatar-acts">
                  <button id="avatar-pick" class="btn" type="button">选择图片</button>
                  <button id="avatar-remove" class="wb-cat-act wb-cat-del" type="button" hidden>删除头像</button>
                  <span id="avatar-file" class="wb-hint">未选择文件</span>
                </div>
              </div>
              <input id="avatar-input" type="file" accept="image/png,image/jpeg,image/webp,image/gif" hidden />
              <div id="avatar-msg" class="wb-hint" role="status" aria-live="polite"></div>

              <!-- 历史头像（默认收起；高度+透明度过渡，见 styles.css .wb-avatar-hist-panel） -->
              <div id="avatar-hist-panel" class="wb-avatar-hist-panel" hidden>
                <div class="wb-avatar-hist-inner">
                  <div class="wb-avatar-hist-head">
                    <strong>历史头像</strong>
                    <span class="wb-hint">单击放大预览，双击切换为当前头像</span>
                  </div>
                  <div id="avatar-hist-grid" class="wb-avatar-hist-grid"></div>
                  <div class="wb-avatar-hist-foot">
                    <span id="avatar-hist-stat" class="wb-hint"></span>
                    <button id="avatar-hist-clear" class="wb-avatar-hist-clear" type="button">清空历史</button>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="wb-misc-col">
            <div class="wb-card" id="cat-card">
              <div class="wb-side-head">
                <strong>分类管理</strong>
                <span id="cat-count" class="wb-hint"></span>
              </div>
              <p class="wb-hint wb-cat-note">重命名会同步修改该分类下所有文章的分类名与 URL（slug）；改名后旧的分类链接将失效。合并/删除同理会同步文章。</p>
              <button id="cat-add-btn" class="wb-cat-add" type="button">＋ 新增分类</button>
              <ul id="cat-list-manage" class="wb-list"></ul>
              <div id="cat-add-box" class="wb-cat-new wb-cat-new--manage" hidden>
                <input id="cat-add-name" class="wb-cat" placeholder="中文名（必填），如：技术随笔" />
                <input id="cat-add-name-en" class="wb-cat" placeholder="English name（可选，如 Tech Notes）" />
                <input id="cat-add-slug" class="wb-cat" placeholder="slug（留空自动生成，仅小写字母/数字/连字符）" />
                <span id="cat-add-preview" class="wb-cat-slug-preview"></span>
                <span class="wb-hint wb-cat-new-hint">中文名必填；EN 留空则英文前台回退显示中文名。Slug＝网址里的后缀，中英共用同一个。</span>
                <button id="cat-add-save" class="wb-cat-act" type="button">保存</button>
                <button id="cat-add-cancel" class="wb-cat-act wb-cat-cancel" type="button">取消</button>
                <span id="cat-add-msg" class="wb-cat-rename-msg"></span>
              </div>
            </div>
          </div>
        </div>
      </section>
    </section>
  </div>
</AdminLayout>

<script>
  import { createClient } from '@supabase/supabase-js';
  import { marked } from 'marked';
  import { localExcerpt } from '../lib/excerpt.js';
  import { site } from '../data/site.js';

  // 注意：不要命名成 URL，会遮蔽全局的 URL 构造器（createObjectURL/revokeObjectURL）
  const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
  const KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
  const DRAFT_KEY = 'wb-local-draft';
  const $ = (id) => document.getElementById(id);

  // 必须在模块作用域声明：下方各函数（loadList / persist / uploadImages 等）
  // 均在顶层定义，若把 client 关在 else 块内会因词法作用域取不到而抛 ReferenceError
  let supabase = null;

  // 当前编辑态
  const state = { id: '', slug: '', lang: 'zh', status: 'draft', filter: 'all', query: '', saving: false, catSlug: '', catName: '', dirty: false, wasEncrypted: false, passHint: '' };

  // 本会话上传、但上传时文章尚无 slug 的附件 path：保存成功后按最终 slug 补关联 post_slug
  const pendingAttach = new Set();

  const LANGS = { zh: '中文', en: 'EN' };

  // 一键翻译提示行当前对应的版本 { id, lang }：切版本后用它判断旧提示是否已过期
  let trMsgFor = { id: '', lang: '' };

  // slug 自动派生开关：新建文章为 true（slug 随标题/语言联动），
  // 一旦用户手动改过 slug 即置 false，避免被标题输入或语言切换覆盖。
  let slugAuto = true;

  // 编辑器弹窗：文章管理默认只显示列表；点「新建文章」或行内「编辑」时才弹出编辑器
  // （通过给 #mod-write 加 .editing，把 .wb-main 变成遮罩弹窗，见 styles.css）
  function openEditor(post) {
    setForm(post && post.id ? post : (post || {}));
    $('mod-write').classList.add('editing');
    document.body.style.overflow = 'hidden';
    try { $('f-title').focus(); } catch {}
  }
  function closeEditor() {
    $('mod-write').classList.remove('editing');
    document.body.style.overflow = '';
  }

  function slugify(str) {
    return String(str).trim().toLowerCase().replace(/\s+/g, '-').replace(/[^\w\-\u4e00-\u9fa5]/g, '');
  }

  function setMsg(text, kind = '') {
    const el = $('save-msg');
    el.textContent = text;
    el.dataset.kind = kind;
  }

  // ---------- 视图切换 ----------
  function showLogin(msg) {
    $('login-view').hidden = false;
    $('workbench').hidden = true;
    if (msg) $('login-msg').textContent = msg;
  }

  async function showWorkbench() {
    $('login-view').hidden = true;
    $('workbench').hidden = false;
    const { data } = await supabase.auth.getUser();
    $('wb-user').textContent = data?.user?.email || '';
    await loadList();
    loadCountdown();
    loadExcerptSettings();
    loadComments();
  }

  // ---------- 模块切换（文章管理 / 评论管理 / 其他功能） ----------
  const MODULES = ['write', 'files', 'comments', 'misc'];
  function switchModule(name) {
    if (!MODULES.includes(name)) return;
    closeEditor(); // 切换模块时收起编辑器弹窗，避免遮罩/滚动锁残留
    MODULES.forEach((m) => { $('mod-' + m).hidden = m !== name; });
    document.querySelectorAll('#wb-modnav [data-mod]').forEach((b) => {
      b.classList.toggle('on', b.dataset.mod === name);
    });
    if (name === 'comments') loadComments();
    if (name === 'files') loadMedia();
    if (name === 'misc') { loadCountdown(); loadExcerptSettings(); loadCatManage(); loadAvatar(); }
  }

  // ---------- 首页倒计时（存于 site_settings） ----------
  async function loadCountdown() {
    try {
      const { data, error } = await supabase
        .from('site_settings').select('value').eq('key', 'countdown').maybeSingle();
      if (!error && data?.value) {
        $('cd-name').value = data.value.name || data.value.label || '';
        const t = (data.value.target || '').slice(0, 10);
        if (t) $('cd-date').value = t;
      }
    } catch {}
  }

  async function saveCountdown() {
    const name = $('cd-name').value.trim();
    const date = $('cd-date').value;
    const msg = $('cd-msg');
    if (!name || !date) { msg.textContent = '请填写名称和日期'; msg.dataset.kind = 'err'; return; }
    msg.textContent = '保存中…'; msg.dataset.kind = '';
    // 固定锚定北京时间（UTC+8）：date 来自 <input type="date">，值为 YYYY-MM-DD
    const target = date + 'T00:00:00+08:00';
    const { error } = await supabase
      .from('site_settings')
      .upsert({ key: 'countdown', value: { name, target }, updated_at: new Date().toISOString() });
    if (error) { msg.textContent = '保存失败：' + error.message; msg.dataset.kind = 'err'; }
    else { msg.textContent = '已保存 ✓ 首页刷新即生效'; msg.dataset.kind = 'ok'; }
  }

  // ---------- 摘要自动生成设置（存 site_settings，键 excerpt_settings） ----------
  // 与倒计时同款存储机制；读取失败/未配置时用默认值，不影响发布兜底。
  const excerptSettings = { maxLen: 200, style: 'plain' };

  async function loadExcerptSettings() {
    try {
      const { data, error } = await supabase
        .from('site_settings').select('value').eq('key', 'excerpt_settings').maybeSingle();
      if (!error && data?.value) {
        excerptSettings.maxLen = Number(data.value.maxLen) || 200;
        excerptSettings.style = data.value.style || 'plain';
      }
    } catch {}
    $('ex-maxlen').value = String(excerptSettings.maxLen);
    $('ex-style').value = excerptSettings.style;
  }

  async function saveExcerptSettings() {
    const msg = $('ex-msg');
    excerptSettings.maxLen = Number($('ex-maxlen').value) || 200;
    excerptSettings.style = $('ex-style').value || 'plain';
    const { error } = await supabase
      .from('site_settings')
      .upsert({
        key: 'excerpt_settings',
        value: { maxLen: excerptSettings.maxLen, style: excerptSettings.style },
        updated_at: new Date().toISOString(),
      });
    if (error) { msg.textContent = '保存失败：' + error.message; msg.dataset.kind = 'err'; return; }
    msg.textContent = '已保存 ✓ 对之后留空摘要的发布生效'; msg.dataset.kind = 'ok';
  }

  // ---------- 站点设置 → 头像 ----------
  // 存储：Supabase Storage 公开桶 avatars + site_settings 键 avatar（{ url, path, updated_at, history }）。
  // 前台 SSR 每请求读 site_settings（getAvatar），所以保存后刷新前台立刻生效，无需发版。
  // 双写顺序刻意如此：先传文件 → 再写设置。写设置失败时只回滚刚传的新文件，
  // 绝不删除旧头像——宁可留着无用文件，也不能让线上头像变空。
  //
  // 历史头像：value.history 数组按时间倒序，history[0] 恒等于当前头像。
  // 上传新图不再删旧图（改为归档）；仅两种删除：超上限裁掉最旧的、用户点「清空历史」。
  const AVATAR_BUCKET = 'avatars';
  const AVATAR_MAX_BYTES = 2 * 1024 * 1024;          // 2 MB
  const AVATAR_HISTORY_MAX = 12;                     // 历史最多保留 12 张（含当前）
  const AVATAR_CLICK_DELAY = 250;                    // 单击延迟，用于与双击区分
  const AVATAR_EXTS = ['png', 'jpg', 'jpeg', 'webp', 'gif'];
  const AVATAR_MIMES = ['image/png', 'image/jpeg', 'image/webp', 'image/gif'];
  const AVATAR_FALLBACK_SRC = site.avatar || '';
  let avatarState = { url: '', path: '' };            // 当前生效头像（来自 site_settings）
  let avatarHistory = [];                            // [{ url, path, size, name, uploaded_at }]
  let avatarBusy = false;
  let avatarHistOpen = false;                        // 本次会话的展开状态（刷新后回到收起）
  let clickTimer = null;                             // 单击/双击判定计时器
  let previewOverlay = null;                         // 放大预览浮层（单例）

  function setAvatarMsg(text, kind = '') {
    const el = $('avatar-msg');
    if (!el) return;
    el.textContent = text;
    el.dataset.kind = kind;
  }

  function paintAvatarPreview(url) {
    const box = $('avatar-preview');
    if (!box) return;
    const fb = box.querySelector('.wb-avatar-fallback');
    const old = box.querySelector('img');
    if (old) old.remove();
    if (!url) { if (fb) fb.hidden = false; return; }
    if (fb) fb.hidden = true;
    const img = document.createElement('img');
    img.alt = '头像预览';
    img.decoding = 'async';
    // 预览失败（文件被删/URL 失效）时退回兜底字，并提示，避免出现破图
    img.onerror = () => { img.remove(); if (fb) fb.hidden = false; setAvatarMsg('预览加载失败：文件可能已被删除', 'err'); };
    img.src = url;
    box.appendChild(img);
  }

  // ---------- 历史头像：数据规整 ----------
  // 老数据没有 history 字段、或字段被手工改坏时，一律当空数组处理，绝不抛错。
  function normalizeHistory(v) {
    const list = v && typeof v === 'object' && Array.isArray(v.history) ? v.history : [];
    return list
      .filter((it) => it && typeof it === 'object' && String(it.url || '').trim() && String(it.path || '').trim())
      .map((it) => ({
        url: String(it.url).trim(),
        path: String(it.path).trim(),
        size: Number(it.size) || 0,
        name: String(it.name || ''),
        uploaded_at: String(it.uploaded_at || ''),
      }))
      .sort((a, b) => String(b.uploaded_at).localeCompare(String(a.uploaded_at)));   // 时间倒序
  }

  // 把当前头像作为最新一条并入历史（用于兼容老数据：只有 url/path、没有 history 的情况）
  function mergeCurrentIntoHistory(cur, hist) {
    if (!cur || !cur.url || !cur.path) return hist;
    const rest = hist.filter((h) => h.path !== cur.path);
    return [{ url: cur.url, path: cur.path, size: Number(cur.size) || 0,
              name: String(cur.name || ''), uploaded_at: String(cur.uploaded_at || '') }, ...rest];
  }

  function fmtStat(n, bytes) {
    const kb = bytes / 1024;
    const size = kb >= 1024 ? `${(kb / 1024).toFixed(1)} MB` : `${Math.round(kb)} KB`;
    return `共 ${n} 张 · 占用 ${size}`;
  }

  function fmtTime(iso) {
    const d = new Date(iso);
    if (isNaN(d.getTime())) return ['--', '--:--'];
    const p2 = (x) => String(x).padStart(2, '0');
    return [`${p2(d.getMonth() + 1)}-${p2(d.getDate())}`, `${p2(d.getHours())}:${p2(d.getMinutes())}`];
  }

  // ---------- 历史头像：渲染 ----------
  function renderAvatarHistory() {
    const grid = $('avatar-hist-grid');
    const btn = $('avatar-hist-btn');
    if (!grid || !btn) return;
    const n = avatarHistory.length;
    $('avatar-hist-n').textContent = `(${n})`;
    // 无历史：按钮禁用但不隐藏（避免按钮突然消失造成困惑）
    btn.disabled = n === 0;
    btn.title = n === 0 ? '还没有历史头像' : '展开/收起历史头像';
    if (n === 0 && avatarHistOpen) toggleAvatarHistory(false);

    grid.innerHTML = '';
    avatarHistory.forEach((it, i) => {
      const cell = document.createElement('button');
      cell.type = 'button';
      cell.className = 'wb-avatar-hist-item' + (i === 0 ? ' is-current' : '');
      cell.dataset.path = it.path;
      cell.setAttribute('aria-label',
        `历史头像 ${it.path}${i === 0 ? '（当前使用）' : ''}，单击预览，双击切换`);

      const thumb = document.createElement('span');
      thumb.className = 'wb-avatar-hist-thumb';
      const img = document.createElement('img');
      img.src = it.url;
      img.alt = '';
      img.loading = 'lazy';
      img.decoding = 'async';
      img.onerror = () => { thumb.classList.add('is-broken'); img.remove(); };
      thumb.appendChild(img);
      if (i === 0) {
        const dot = document.createElement('span');
        dot.className = 'wb-avatar-hist-dot';
        dot.setAttribute('aria-hidden', 'true');
        thumb.appendChild(dot);
      }

      const [date, time] = fmtTime(it.uploaded_at);
      const meta = document.createElement('span');
      meta.className = 'wb-avatar-hist-meta';
      meta.innerHTML = `<span class="d">${date}</span><span class="t">${time}</span>`
        + (i === 0 ? '<span class="cur">当前</span>' : '');

      cell.appendChild(thumb);
      cell.appendChild(meta);

      // 单击延迟 250ms；期间来第二次点击则取消单击、执行双击。
      cell.addEventListener('click', (e) => {
        e.preventDefault();
        if (clickTimer) { clearTimeout(clickTimer); clickTimer = null; switchToAvatar(it); return; }
        clickTimer = setTimeout(() => { clickTimer = null; openAvatarPreview(it); }, AVATAR_CLICK_DELAY);
      });
      grid.appendChild(cell);
    });

    const total = avatarHistory.reduce((s, it) => s + (Number(it.size) || 0), 0);
    $('avatar-hist-stat').textContent = n ? fmtStat(n, total) : '还没有历史头像';
    $('avatar-hist-clear').disabled = n <= 1;   // 只剩当前一张时无可清理
  }

  // ---------- 历史头像：展开/收起 ----------
  function toggleAvatarHistory(force) {
    const panel = $('avatar-hist-panel');
    const btn = $('avatar-hist-btn');
    if (!panel || !btn) return;
    const open = typeof force === 'boolean' ? force : !avatarHistOpen;
    avatarHistOpen = open;
    btn.setAttribute('aria-expanded', String(open));
    btn.classList.toggle('is-open', open);

    if (open) {
      panel.hidden = false;
      // 先量出目标高度再过渡：0 → scrollHeight
      panel.style.height = '0px';
      panel.style.opacity = '0';
      const h = panel.scrollHeight;
      requestAnimationFrame(() => {
        panel.style.height = h + 'px';
        panel.style.opacity = '1';
      });
    } else {
      panel.style.height = panel.scrollHeight + 'px';
      requestAnimationFrame(() => {
        panel.style.height = '0px';
        panel.style.opacity = '0';
      });
      // 等过渡结束后再 hidden，避免过渡被 display:none 打断
      setTimeout(() => { if (!avatarHistOpen) panel.hidden = true; }, 220);
    }
  }

  // ---------- 历史头像：放大预览浮层 ----------
  function openAvatarPreview(it) {
    closeAvatarPreview();
    const mask = document.createElement('div');
    mask.className = 'wb-avatar-zoom';
    mask.setAttribute('role', 'dialog');
    mask.setAttribute('aria-modal', 'true');
    mask.setAttribute('aria-label', '头像放大预览');

    const box = document.createElement('div');
    box.className = 'wb-avatar-zoom-box';
    const img = document.createElement('img');
    img.src = it.url;
    img.alt = '头像放大预览';
    const [date, time] = fmtTime(it.uploaded_at);
    const cap = document.createElement('div');
    cap.className = 'wb-avatar-zoom-cap';
    cap.textContent = `${date} ${time}${it.path === avatarState.path ? ' · 当前使用' : ''}　（双击缩略图可切换为这张）`;
    const x = document.createElement('button');
    x.type = 'button';
    x.className = 'wb-avatar-zoom-x';
    x.setAttribute('aria-label', '关闭预览');
    x.textContent = '✕';

    box.appendChild(img);
    box.appendChild(cap);
    box.appendChild(x);
    mask.appendChild(box);
    document.body.appendChild(mask);
    previewOverlay = mask;

    mask.addEventListener('click', (e) => { if (e.target === mask || e.target === x) closeAvatarPreview(); });
    document.addEventListener('keydown', onAvatarZoomKey);
    x.focus();
  }

  function onAvatarZoomKey(e) {
    if (e.key === 'Escape') { e.preventDefault(); closeAvatarPreview(); }
  }

  function closeAvatarPreview() {
    if (!previewOverlay) return;
    previewOverlay.remove();
    previewOverlay = null;
    document.removeEventListener('keydown', onAvatarZoomKey);
  }

  // ---------- 历史头像：写回配置 ----------
  // 统一走这里：url/path 跟随 history[0]，保证「配置」与「列表」永不脱节。
  async function persistAvatar(history, newCurrent) {
    const cur = newCurrent || history[0] || null;
    const value = {
      url: cur ? cur.url : '',
      path: cur ? cur.path : '',
      updated_at: new Date().toISOString(),
      history,
    };
    if (cur) { value.size = cur.size; value.name = cur.name; value.uploaded_at = cur.uploaded_at; }
    const { error } = await supabase.from('site_settings').upsert({
      key: 'avatar', value, updated_at: new Date().toISOString(),
    });
    if (error) throw error;
    return value;
  }

  function applyAvatarValue(v) {
    const cur = v && v.url ? { url: v.url, path: v.path } : { url: '', path: '' };
    avatarState = cur;
    avatarHistory = normalizeHistory(v);
    if (v && v.url && v.path) avatarHistory = mergeCurrentIntoHistory(v, avatarHistory);
    paintAvatarPreview(cur.url || AVATAR_FALLBACK_SRC);
    $('avatar-src').textContent = cur.url ? '当前：已上传（存于 Storage）' : '当前：默认 /avatar.png';
    $('avatar-remove').hidden = !cur.url;
    renderAvatarHistory();
  }

  async function readAvatarSetting() {
    // 与 loadCountdown 同款读法，直接走浏览器端的 supabase 客户端（始终实时，无快照缓存）
    try {
      const { data, error } = await supabase
        .from('site_settings').select('value').eq('key', 'avatar').maybeSingle();
      if (error) return null;
      return data?.value || null;
    } catch { return null; }
  }

  async function loadAvatar() {
    const v = await readAvatarSetting();
    applyAvatarValue(v);
    $('avatar-file').textContent = '未选择文件';
    $('avatar-input').value = '';
    // 展开态在本次会话内保持（切模块回来不重置）；首次进入为收起
    if (avatarHistOpen && avatarHistory.length) toggleAvatarHistory(true);
  }

  // ---------- 历史头像：切换 / 清空 ----------
  async function switchToAvatar(it) {
    // 先判「已是当前」再判忙碌：否则忙碌期间的点击会被静默吞掉，用户以为按钮坏了
    if (it.path === avatarState.path) {
      closeAvatarPreview();
      setAvatarMsg('已经是当前头像', '');
      return;
    }
    if (avatarBusy) { setAvatarMsg('正在处理上一步操作，请稍候…', ''); return; }
    closeAvatarPreview();
    avatarBusy = true;
    setAvatarMsg('切换中…', '');
    try {
      const nextHistory = mergeCurrentIntoHistory(it, avatarHistory);
      const prev = avatarState;
      const v = await persistAvatar(nextHistory, it);
      applyAvatarValue(v);
      const [date, time] = fmtTime(it.uploaded_at);
      setAvatarMsg(`已切换为 ${date} ${time} 的头像 ✓ 前台刷新即生效`, 'ok');
      // 切换不动文件，不删任何东西；失败则完全回滚到原状态
      if (!v) { avatarState = prev; }
    } catch (e) {
      setAvatarMsg('切换失败：' + (e?.message || e) + '（当前头像未变）', 'err');
      await loadAvatar();
    } finally {
      avatarBusy = false;
    }
  }

  async function clearAvatarHistory() {
    if (avatarBusy) return;
    const extra = avatarHistory.length - 1;
    if (extra <= 0) { setAvatarMsg('没有可清理的历史头像（只剩当前这张）', ''); return; }
    if (!confirm(`清空 ${extra} 张历史头像？\n\n当前正在使用的这张会保留，前台显示不受影响。`)) return;
    avatarBusy = true;
    const btn = $('avatar-hist-clear');
    if (btn) btn.disabled = true;
    setAvatarMsg('清理中…', '');
    try {
      const keep = avatarHistory[0];
      const drop = avatarHistory.slice(1).map((h) => h.path).filter(Boolean);
      // 先删文件（失败静默跳过），再收缩 history —— 顺序保证「配置」始终指向存在的文件
      if (drop.length) await supabase.storage.from(AVATAR_BUCKET).remove(drop).catch(() => {});
      const v = await persistAvatar([keep], keep);
      applyAvatarValue(v);
      setAvatarMsg(`已清理 ${drop.length} 张历史头像 ✓ 当前头像保持不变`, 'ok');
    } catch (e) {
      setAvatarMsg('清理失败：' + (e?.message || e), 'err');
      await loadAvatar();
    } finally {
      if (btn) btn.disabled = avatarHistory.length <= 1;
      avatarBusy = false;
    }
  }

  // 选中即校验：类型 → 体积 → 可解码。任一不过就直接拒绝，不上传、不改变现状态。
  async function validateAvatarFile(file) {
    if (!file) return '没有选择文件';
    const mime = (file.type || '').toLowerCase();
    const ext = ((file.name || '').toLowerCase().match(/\.([a-z0-9]{2,5})$/) || [])[1] || '';
    if (!AVATAR_MIMES.includes(mime) || !AVATAR_EXTS.includes(ext)) {
      return `格式不支持：只接受 PNG / JPG / WebP / GIF（当前 ${mime || ext || '未知类型'}）`;
    }
    if (file.size > AVATAR_MAX_BYTES) {
      return `文件过大：${(file.size / 1024 / 1024).toFixed(1)} MB，上限 2 MB，请先压缩`;
    }
    if (file.size < 200) return '文件异常：体积过小，可能不是有效图片';
    // 真正解一次码：能拿到宽高才算合法图片（防「改了扩展名的假图片」）
    try {
      const bmp = await createImageBitmap(file);
      if (!bmp.width || !bmp.height) throw new Error('bad');
      bmp.close?.();
    } catch {
      return '文件损坏或不是有效图片，请换一张';
    }
    return '';
  }

  async function uploadAvatar(file) {
    if (avatarBusy) return;
    const err = await validateAvatarFile(file);
    if (err) {
      setAvatarMsg(err, 'err');
      $('avatar-input').value = '';
      return;
    }
    avatarBusy = true;
    const pickBtn = $('avatar-pick');
    const removeBtn = $('avatar-remove');
    pickBtn.disabled = true;
    removeBtn.disabled = true;
    $('avatar-file').textContent = `${file.name}（${(file.size / 1024).toFixed(0)} KB）`;
    setAvatarMsg('上传中…', '');
    // 先本地预览：用户立刻看到结果，不用等网络
    const localUrl = URL.createObjectURL(file);
    paintAvatarPreview(localUrl);

    const ext = ((file.name || '').toLowerCase().match(/\.([a-z0-9]{2,5})$/) || [])[1];
    const path = `avatar-${Date.now()}.${ext === 'jpeg' ? 'jpg' : ext}`;
    let uploaded = false;
    try {
      const { error: upErr } = await supabase.storage
        .from(AVATAR_BUCKET)
        .upload(path, file, { upsert: false, contentType: file.type || undefined, cacheControl: '60' });
      if (upErr) {
        // 桶不存在 / 无写权限：给出可执行的提示，而不是原始报错
        const m = String(upErr.message || upErr);
        const hint = /bucket/i.test(m)
          ? '存储桶 avatars 不存在，请先在 Supabase 执行「头像存储-迁移SQL v1.sql」'
          : /row-level|policy|permission|unauthorized|403/i.test(m)
            ? '没有上传权限：请确认已登录后台，且已执行头像存储的 RLS 策略 SQL'
            : m;
        setAvatarMsg('上传失败：' + hint, 'err');
        paintAvatarPreview(avatarState.url || AVATAR_FALLBACK_SRC);
        return;
      }
      uploaded = true;
      const publicUrl = supabase.storage.from(AVATAR_BUCKET).getPublicUrl(path).data.publicUrl;

      // 归档：新图插到最前，旧图保留；超过上限时裁掉尾部（仅删被裁掉的文件）
      const entry = {
        url: publicUrl, path, size: Number(file.size) || 0, name: file.name || '',
        uploaded_at: new Date().toISOString(),
      };
      const merged = [entry, ...avatarHistory.filter((h) => h.path !== path)];
      const keep = merged.slice(0, AVATAR_HISTORY_MAX);
      const trimmed = merged.slice(AVATAR_HISTORY_MAX);

      let setErr = null;
      try {
        await persistAvatar(keep, entry);
      } catch (e) { setErr = e; }
      if (setErr) {
        // 只回滚刚上传的新文件；旧头像与历史（avatarState/avatarHistory）保持原样
        await supabase.storage.from(AVATAR_BUCKET).remove([path]).catch(() => {});
        setAvatarMsg('保存失败：' + (setErr.message || setErr) + '（已撤销本次上传，原头像未受影响）', 'err');
        paintAvatarPreview(avatarState.url || AVATAR_FALLBACK_SRC);
        return;
      }

      // 成功：只清掉被上限挤出去的旧文件（删除失败不影响结果，只是留下无用文件）
      if (trimmed.length) {
        await supabase.storage.from(AVATAR_BUCKET).remove(trimmed.map((h) => h.path)).catch(() => {});
      }
      const v = { url: entry.url, path: entry.path, size: entry.size, name: entry.name,
                  uploaded_at: entry.uploaded_at, history: keep };
      applyAvatarValue(v);
      pickBtn.blur();
      const extra = trimmed.length ? `；已自动清理最旧的 ${trimmed.length} 张` : '';
      setAvatarMsg(`已保存 ✓ 已存入历史头像（共 ${keep.length} 张${extra}），前台刷新即生效`, 'ok');
      // 清掉表单里的 file，避免重复选中同一文件不触发 change
      $('avatar-input').value = '';
    } catch (e) {
      if (uploaded) await supabase.storage.from(AVATAR_BUCKET).remove([path]).catch(() => {});
      setAvatarMsg('上传异常：' + (e?.message || e), 'err');
      paintAvatarPreview(avatarState.url || AVATAR_FALLBACK_SRC);
    } finally {
      URL.revokeObjectURL(localUrl);
      pickBtn.disabled = false;
      removeBtn.disabled = false;
      avatarBusy = false;
    }
  }

  async function removeAvatar() {
    if (avatarBusy) return;
    if (!avatarState.url) { setAvatarMsg('当前没有自定义头像，已在使用默认图', ''); return; }
    const allFiles = Array.from(new Set([
      avatarState.path, ...avatarHistory.map((h) => h.path),
    ].filter(Boolean)));
    const tip = allFiles.length > 1
      ? `删除自定义头像？\n\n将同时清除配置项、历史记录，以及 ${allFiles.length} 个图片文件。\n删除后前台回退显示 public/avatar.png 的默认头像。`
      : '删除自定义头像？删除后前台将回退显示 public/avatar.png 的默认头像。';
    if (!confirm(tip)) return;
    avatarBusy = true;
    closeAvatarPreview();
    $('avatar-pick').disabled = true;
    $('avatar-remove').disabled = true;
    setAvatarMsg('删除中…', '');
    try {
      // 先删配置项：这一步成功，前台就已经回到默认头像；文件删除失败只留下垃圾文件
      const { error } = await supabase.from('site_settings').delete().eq('key', 'avatar');
      if (error) { setAvatarMsg('删除失败：' + error.message, 'err'); return; }
      // 历史文件一并清理（否则全部变成无人引用的孤儿文件）
      if (allFiles.length) {
        await supabase.storage.from(AVATAR_BUCKET).remove(allFiles).catch(() => {});
      }
      applyAvatarValue(null);
      setAvatarMsg('已删除 ✓ 前台已回退为默认头像（历史头像已一并清除）', 'ok');
    } catch (e) {
      setAvatarMsg('删除异常：' + (e?.message || e), 'err');
    } finally {
      $('avatar-pick').disabled = false;
      $('avatar-remove').disabled = false;
      avatarBusy = false;
    }
  }

  // AI 生成摘要：复用 /api/translate 同款鉴权（session token），只填表单不保存
  async function aiGenerateExcerpt() {
    const btn = $('ai-excerpt-btn');
    const hint = $('excerpt-hint');
    const title = $('f-title').value.trim();
    const content = $('f-content').value;
    if (!content.trim()) { hint.textContent = '请先填写正文再生成摘要'; hint.dataset.kind = 'err'; return; }
    btn.disabled = true; btn.style.opacity = '.55'; btn.style.pointerEvents = 'none';
    hint.dataset.kind = '';
    hint.textContent = 'AI 生成中，通常几秒…';
    try {
      const { data: sd } = await supabase.auth.getSession();
      const token = sd?.session?.access_token;
      if (!token) { hint.textContent = '会话已过期，请重新登录后再试'; hint.dataset.kind = 'err'; return; }
      const resp = await fetch('/api/excerpt', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
        body: JSON.stringify({
          title, content,
          lang: state.lang,
          maxLen: excerptSettings.maxLen,
          style: excerptSettings.style,
        }),
      });
      const result = await resp.json().catch(() => ({}));
      if (!resp.ok) {
        hint.textContent = result.error || `生成失败（HTTP ${resp.status()}）`;
        hint.dataset.kind = 'err';
        return;
      }
      $('f-excerpt').value = result.excerpt || '';
      saveLocalDraft();
      if (result.source === 'local') {
        // 服务端在 AI 不可用时回退到本地截取：明确告诉用户这是降级结果，
        // 不是静默塞一段看起来像 AI 输出的文字。
        hint.textContent = `⚠ AI 暂不可用（${result.reason || '服务异常'}），已按正文自动截取 ${(result.excerpt || '').length} 字，可直接使用或手动修改`;
        hint.dataset.kind = 'warn';
      } else {
        hint.textContent = `✓ 已填入（${(result.excerpt || '').length} 字），请检查后随文章一起保存`;
        hint.dataset.kind = 'ok';
      }
    } catch (e) {
      hint.textContent = '网络错误：' + (e?.message || '请求失败');
      hint.dataset.kind = 'err';
    } finally {
      btn.disabled = false; btn.style.opacity = ''; btn.style.pointerEvents = '';
    }
  }

  // ---------- 文件管理 ----------
  const fmState = { filter: 'all', query: '' };
  let allMedia = [];
  let orphanPaths = new Set();

  function fmtSize(n) {
    if (!n) return '0 B';
    if (n < 1024) return n + ' B';
    if (n < 1048576) return (n / 1024).toFixed(1) + ' KB';
    return (n / 1048576).toFixed(1) + ' MB';
  }

  async function loadMedia() {
    const ul = $('fm-list');
    if (!ul) return;
    ul.innerHTML = '<li class="wb-empty">加载中…</li>';
    // 1) 读归属记录（登录用户可见）
    const { data, error } = await supabase.from('media').select('*').order('created_at', { ascending: false });
    if (error) {
      ul.innerHTML = '<li class="wb-empty">读取失败：' + error.message +
        '<br>（若提示表不存在，请先执行 supabase/media_library.sql）</li>';
      return;
    }
    allMedia = data || [];

    // 2) 孤儿判定：以「正文 + 封面 + 附件归属」即时引用为准，不依赖 media_orphans 视图
    //    口径：
    //      · 图片/一般文件：posts.content 或 posts.cover 任一包含该 path 即非孤儿
    //      · 附件（bucket='attachments'）：不进正文/封面，靠 post_slug 归属判定，
    //        post_slug 非空即「已归属某篇文章」，不算孤儿
    //    历史教训：① 只查 content 会把「仅设为封面」的图误判（2026-10-18 修复）；
    //    ② 附件被一律误判为孤儿，一键清理直接删（2026-10-19 修复）。
    //    前端自行判定而非依赖视图：旧视图未更新也不会造成误判（media_library.sql
    //    中的视图定义已同步为同一口径）
    {
      const { data: posts } = await supabase.from('posts').select('content,cover');
      const blob = (posts || []).map((p) => (p.content || '') + '\n' + (p.cover || '')).join('\n');
      orphanPaths = new Set(
        allMedia
          .filter((m) => !(m.bucket === 'attachments' && m.post_slug)) // 已归属文章的附件：非孤儿
          .filter((m) => !blob.includes(m.path))
          .map((m) => m.path)
      );
    }
    renderMedia();
  }

  function renderMedia() {
    const ul = $('fm-list');
    ul.innerHTML = '';
    const q = fmState.query.trim().toLowerCase();
    const imgExts = IMAGE_EXTS;

    let rows = allMedia.filter((m) => {
      if (fmState.filter === 'images' && m.bucket !== 'images') return false;
      if (fmState.filter === 'attachments' && m.bucket !== 'attachments') return false;
      if (fmState.filter === 'orphan' && !orphanPaths.has(m.path)) return false;
      if (q) {
        const hay = ((m.path || '') + ' ' + (m.original_name || '') + ' ' + (m.post_slug || '')).toLowerCase();
        if (!hay.includes(q)) return false;
      }
      return true;
    });

    const totalSize = allMedia.reduce((s, m) => s + (Number(m.size_bytes) || 0), 0);
    $('fm-count').textContent =
      `${rows.length} 个文件 / 共 ${allMedia.length} 个 · 合计 ${fmtSize(totalSize)} · 孤儿 ${orphanPaths.size} 个`;

    if (!rows.length) {
      ul.innerHTML = '<li class="wb-empty">没有匹配的文件</li>';
      return;
    }

    rows.forEach((m) => {
      const li = document.createElement('li');
      li.className = 'wb-item wb-fm-item';

      const thumb = document.createElement('div');
      thumb.className = 'wb-fm-thumb';
      const ext = (m.path.match(/\.([a-z0-9]+)$/i) || [])[1] || '';
      if (m.bucket === 'images') {
        const img = document.createElement('img');
        img.loading = 'lazy';
        img.alt = m.original_name || m.path;
        img.src = supabase.storage.from('images').getPublicUrl(m.path).data.publicUrl;
        thumb.appendChild(img);
      } else {
        thumb.textContent = (ext || 'FILE').toUpperCase().slice(0, 4);
        thumb.classList.add('is-ext');
      }

      const main = document.createElement('div');
      main.className = 'wb-item-main';
      const isOrphan = orphanPaths.has(m.path);
      main.innerHTML =
        `<span class="wb-fm-name" title="${escapeHtml(m.path)}">${escapeHtml(m.original_name || m.path)}</span>
         <span class="wb-item-meta">
           <span class="wb-badge ${m.bucket === 'images' ? 'is-live' : 'is-draft'}">${m.bucket === 'images' ? '图片' : '附件'}</span>
           ${isOrphan ? '<span class="wb-badge is-trash">未被引用</span>' : ''}
           <span class="wb-date">${fmtSize(m.size_bytes)}</span>
           <span class="wb-date">${m.created_at ? new Date(m.created_at).toLocaleString('zh-CN', { month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' }) : ''}</span>
           <span class="wb-author">${m.post_slug ? escapeHtml(m.post_slug) : '未关联'}</span>
         </span>`;

      const acts = document.createElement('div');
      acts.className = 'wb-item-acts';

      const copy = document.createElement('button');
      copy.type = 'button';
      copy.className = 'wb-item-edit';
      copy.textContent = '复制链接';
      copy.onclick = async () => {
        const u = supabase.storage.from(m.bucket).getPublicUrl(m.path).data.publicUrl;
        try { await navigator.clipboard.writeText(u); copy.textContent = '已复制'; setTimeout(() => (copy.textContent = '复制链接'), 1200); }
        catch { prompt('复制此链接：', u); }
      };

      const del = document.createElement('button');
      del.type = 'button';
      del.className = 'wb-item-del';
      del.textContent = '删除';
      del.onclick = async () => {
        if (!confirm('删除文件「' + (m.original_name || m.path) + '」？\n若它仍被文章引用，文章中将出现坏链。')) return;
        del.disabled = true; del.textContent = '删除中…';
        const { error: e1 } = await supabase.storage.from(m.bucket).remove([m.path]);
        if (e1) { alert('删除失败：' + e1.message); del.disabled = false; del.textContent = '删除'; return; }
        await supabase.from('media').delete().eq('path', m.path);
        await loadMedia();
      };

      acts.append(copy, del);
      li.append(thumb, main, acts);
      ul.append(li);
    });
  }

  // 清理孤儿文件：仅删「media 有记录、正文与封面均无引用」的文件，逐个尝试，最后汇总
  async function cleanOrphans() {
    const msg = $('fm-msg');
    const list = allMedia.filter((m) => orphanPaths.has(m.path));
    if (!list.length) { msg.textContent = '没有孤儿文件 ✓'; return; }
    if (!confirm(`清理 ${list.length} 个孤儿文件？\n它们未被任何文章的正文、封面引用，也不是已归属文章的附件，删除不可恢复。`)) return;
    msg.textContent = '清理中…';
    let done = 0, fail = 0;
    for (const m of list) {
      const { error } = await supabase.storage.from(m.bucket).remove([m.path]);
      if (error) { fail++; continue; }
      await supabase.from('media').delete().eq('path', m.path);
      done++;
    }
    msg.textContent = `已清理 ${done} 个${fail ? '，失败 ' + fail + ' 个' : ''} ✓`;
    await loadMedia();
  }

  // 删除文章时清理其名下文件（供 deletePost 调用；按 base slug 精确匹配）
  async function purgeMediaForPost(slug) {
    const base = baseSlug(slug);
    const { data } = await supabase.from('media').select('path, bucket').eq('post_slug', base);
    if (!data || !data.length) return { removed: 0, failed: 0 };
    let removed = 0, failed = 0;
    for (const m of data) {
      const { error } = await supabase.storage.from(m.bucket).remove([m.path]);
      if (error) { failed++; continue; }
      await supabase.from('media').delete().eq('path', m.path);
      removed++;
    }
    return { removed, failed };
  }

  // ---------- 评论管理 ----------
  const cmState = { filter: 'all' };

  function cmStatusOf(c) {
    if (c.approved) return 'approved';
    if (c.rejected) return 'rejected';
    return 'pending';
  }
  const CM_STATUS_LABEL = { approved: '已通过', rejected: '未通过', pending: '待审核' };

  async function loadComments() {
    const ul = $('cm-list');
    if (!ul) return;
    let q = supabase.from('comments').select('*').order('created_at', { ascending: false });
    const { data, error } = await q;
    if (error) { ul.innerHTML = '<li class="wb-empty">读取失败：' + error.message + '</li>'; return; }
    const all = data || [];
    const counts = { all: all.length, pending: 0, approved: 0, rejected: 0 };
    all.forEach((c) => { counts[cmStatusOf(c)]++; });
    $('cm-count').textContent = `待审 ${counts.pending} · 通过 ${counts.approved} · 未过 ${counts.rejected}`;
    const rows = all.filter((c) => cmState.filter === 'all' || cmStatusOf(c) === cmState.filter);
    if (!rows.length) { ul.innerHTML = '<li class="wb-empty">没有匹配的评论</li>'; return; }
    ul.innerHTML = '';
    rows.forEach((c) => ul.appendChild(renderCommentItem(c)));
  }

  function renderCommentItem(c) {
    const li = document.createElement('li');
    li.className = 'wb-cm-item' + (c.parent_id ? ' wb-cm-item--reply' : '');
    const st = cmStatusOf(c);
    const d = c.created_at ? new Date(c.created_at).toLocaleString('zh-CN') : '';
    const metaExtra = [];
    if (c.is_admin) metaExtra.push('<span class="wb-cm-badge wb-cm-badge--admin">管理员</span>');
    if (c.parent_id) metaExtra.push('<span class="wb-cm-replyof">↳ 回复</span>');
    const body = document.createElement('div');
    body.className = 'wb-cm-body';
    body.innerHTML =
      `<div class="wb-cm-meta">
         <span class="wb-cm-author">${escapeHtml(c.author || '匿名')}</span>
         <span class="wb-badge wb-cm-status wb-cm-status--${st}">${CM_STATUS_LABEL[st]}</span>
         ${metaExtra.join('')}
         <span class="wb-cm-page">${escapeHtml(c.page || '')}</span>
       </div>
       <div class="wb-cm-text">${escapeHtml(c.content || '')}</div>
       <div class="wb-cm-date">${d}</div>`;
    li.appendChild(body);

    const acts = document.createElement('div');
    acts.className = 'wb-cm-acts';

    if (st !== 'approved') {
      const approve = document.createElement('button');
      approve.type = 'button';
      approve.className = 'wb-cm-act wb-cm-approve';
      approve.textContent = '通过';
      approve.onclick = () => moderate(c.id, true, false);
      acts.appendChild(approve);
    }
    if (st !== 'rejected') {
      const reject = document.createElement('button');
      reject.type = 'button';
      reject.className = 'wb-cm-act wb-cm-reject';
      reject.textContent = '驳回';
      reject.onclick = () => moderate(c.id, false, true);
      acts.appendChild(reject);
    }
    // 管理员回复入口
    const replyBtn = document.createElement('button');
    replyBtn.type = 'button';
    replyBtn.className = 'wb-cm-act wb-cm-reply';
    replyBtn.textContent = '回复';
    replyBtn.onclick = () => toggleReplyForm(c, li, replyBtn);
    acts.appendChild(replyBtn);

    const del = document.createElement('button');
    del.type = 'button';
    del.className = 'wb-cm-act wb-cm-del';
    del.textContent = '删除';
    del.onclick = async () => {
      if (!confirm('确定删除这条评论？此操作不可恢复。')) return;
      const { error } = await supabase.from('comments').delete().eq('id', c.id);
      if (error) { alert('删除失败：' + error.message); return; }
      await loadComments();
    };
    acts.appendChild(del);
    li.appendChild(acts);
    return li;
  }

  // 切换某条评论的内联回复框
  function toggleReplyForm(c, li, btn) {
    const exist = li.querySelector('.wb-cm-replybox');
    if (exist) { exist.remove(); return; }
    const box = document.createElement('div');
    box.className = 'wb-cm-replybox';
    box.innerHTML = '<textarea class="wb-cm-replytext" placeholder="以管理员身份回复，发送后即发即显"></textarea>';
    const row = document.createElement('div');
    row.className = 'wb-cm-replyrow';
    const send = document.createElement('button');
    send.type = 'button';
    send.className = 'wb-cm-act wb-cm-send';
    send.textContent = '发送回复';
    const cancel = document.createElement('button');
    cancel.type = 'button';
    cancel.className = 'wb-cm-act';
    cancel.textContent = '取消';
    cancel.onclick = () => box.remove();
    send.onclick = async () => {
      const ta = box.querySelector('.wb-cm-replytext');
      const val = (ta.value || '').trim();
      if (!val) { alert('回复内容不能为空'); return; }
      send.textContent = '发送中…'; send.disabled = true;
      const ok = await replyTo(c, val);
      if (ok) { box.remove(); await loadComments(); }
      else { send.textContent = '发送回复'; send.disabled = false; }
    };
    row.append(send, cancel);
    box.appendChild(row);
    li.appendChild(box);
    box.querySelector('.wb-cm-replytext').focus();
  }

  // 管理员回复：作为一条 is_admin=true、approved=true 的评论插入，parent_id 关联原评论
  async function replyTo(parent, content) {
    const { error } = await supabase.from('comments').insert({
      page: parent.page,
      author: (site && site.author) || '老一贯',
      email: '',
      content: content.slice(0, 1000),
      approved: true,
      rejected: false,
      parent_id: parent.id,
      is_admin: true,
    });
    if (error) { alert('回复失败：' + error.message); return false; }
    return true;
  }

  async function moderate(id, approved, rejected) {
    const { error } = await supabase
      .from('comments').update({ approved, rejected }).eq('id', id);
    if (error) { alert('操作失败：' + error.message); return; }
    await loadComments();
  }

  // ---------- 分类管理（三语名称 / 合并 / 删除 / 点开看文章） ----------
  // 展开状态：记录当前展开的分类 slug（单开，避免页面过长）
  let catExpandedSlug = '';

  async function loadCatManage() {
    const ul = $('cat-list-manage');
    if (!ul) return;
    let rows;
    try {
      const { data: posts, error } = await supabase
        .from('posts').select('category, category_slug, deleted_at');
      if (error) { ul.innerHTML = '<li class="wb-empty">读取失败：' + error.message + '</li>'; return; }
      const map = new Map();
      (posts || []).forEach((p) => {
        if (p.deleted_at) return; // 垃圾箱文章不计入分类篇数
        const name = (p.category || '').trim();
        const slug = (p.category_slug || '').trim() || slugify(name) || 'uncategorized';
        if (!name && slug === 'uncategorized') return;
        if (!map.has(slug)) map.set(slug, { name: name || slug, name_en: '', slug, count: 0 });
        map.get(slug).count++;
      });
      // 注册表（含 0 篇的新增分类），名称以注册表为准（含中英）
      try {
        const { data: reg } = await supabase.from('categories').select('name, name_en, slug');
        (reg || []).forEach((r) => {
          if (!r.slug) return;
          if (!map.has(r.slug)) map.set(r.slug, { name: r.name || r.slug, name_en: '', slug: r.slug, count: 0 });
          const row = map.get(r.slug);
          row.name = r.name || row.name;
          row.name_en = r.name_en || '';
        });
      } catch {}
      rows = [...map.values()].sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));
    } catch (e) {
      ul.innerHTML = '<li class="wb-empty">读取失败：' + (e?.message || e) + '</li>';
      return;
    }
    $('cat-count').textContent = '共 ' + rows.length + ' 个';
    if (!rows.length) { ul.innerHTML = '<li class="wb-empty">还没有分类</li>'; return; }
    ul.innerHTML = '';
    rows.forEach((c) => ul.appendChild(renderCatItem(c, rows)));
  }

  function renderCatItem(c, all) {
    const li = document.createElement('li');
    li.className = 'wb-cat-item';

    const main = document.createElement('div');
    main.className = 'wb-cat-row';

    // 分类名做成按钮：点击展开/收起该分类下的文章列表（行内手风琴，单开）
    const nameBtn = document.createElement('button');
    nameBtn.type = 'button';
    nameBtn.className = 'wb-cat-name wb-cat-name--toggle';
    nameBtn.title = '点击查看该分类下的文章';
    nameBtn.innerHTML =
      '<span class="wb-cat-toggle-icon">▸</span>' + escapeHtml(c.name) +
      (c.name_en ? `<span class="wb-cat-alt">${escapeHtml(c.name_en)}</span>` : '') +
      (!c.name_en ? '<span class="wb-cat-alt wb-cat-alt--missing">缺译文</span>' : '');
    main.appendChild(nameBtn);

    const slugEl = document.createElement('span');
    slugEl.className = 'wb-cat-slug';
    slugEl.textContent = '/' + c.slug;
    main.appendChild(slugEl);

    const countBtn = document.createElement('button');
    countBtn.type = 'button';
    countBtn.className = 'wb-cat-count wb-cat-count--toggle';
    countBtn.textContent = c.count + ' 篇';
    countBtn.title = '点击查看该分类下的文章';
    main.appendChild(countBtn);

    li.appendChild(main);

    // 展开区（懒渲染：只在展开时才生成，避免分类多时拖慢）
    const panel = document.createElement('div');
    panel.className = 'wb-cat-posts';
    panel.hidden = true;
    li.appendChild(panel);

    const toggle = () => {
      const willOpen = catExpandedSlug !== c.slug;
      catExpandedSlug = willOpen ? c.slug : '';
      // 关闭所有已展开的，再按需展开当前
      document.querySelectorAll('#cat-list-manage .wb-cat-item').forEach((node) => {
        const p = node.querySelector('.wb-cat-posts');
        const icon = node.querySelector('.wb-cat-toggle-icon');
        if (p) p.hidden = true;
        if (icon) icon.textContent = '▸';
        node.classList.remove('is-open');
      });
      if (willOpen) {
        renderCatPosts(panel, c);
        panel.hidden = false;
        li.classList.add('is-open');
        nameBtn.querySelector('.wb-cat-toggle-icon').textContent = '▾';
      }
    };
    nameBtn.onclick = toggle;
    countBtn.onclick = toggle;
    // 若刷新前正处于展开状态，保持展开
    if (catExpandedSlug === c.slug) {
      renderCatPosts(panel, c);
      panel.hidden = false;
      li.classList.add('is-open');
      nameBtn.querySelector('.wb-cat-toggle-icon').textContent = '▾';
    }

    const acts = document.createElement('div');
    acts.className = 'wb-cat-acts';

    const renameBtn = document.createElement('button');
    renameBtn.type = 'button';
    renameBtn.className = 'wb-cat-act';
    renameBtn.textContent = '重命名';
    renameBtn.onclick = () => startRename(li, c, all);

    const sel = document.createElement('select');
    sel.className = 'wb-cat-select';
    all.forEach((o) => {
      if (o.slug !== c.slug) {
        const opt = document.createElement('option');
        opt.value = o.slug; opt.textContent = o.name;
        sel.appendChild(opt);
      }
    });
    const mergeBtn = document.createElement('button');
    mergeBtn.type = 'button';
    mergeBtn.className = 'wb-cat-act';
    mergeBtn.textContent = '合并到';
    mergeBtn.title = '把该分类下的文章合并到右侧选中的分类';
    mergeBtn.onclick = async () => {
      const target = all.find((o) => o.slug === sel.value);
      if (!target) return;
      if (!confirm('把「' + c.name + '」下的 ' + c.count + ' 篇文章合并到「' + target.name + '」？')) return;
      mergeBtn.textContent = '合并中…'; mergeBtn.disabled = true;
      const ok = await mergeCategory(c, target);
      if (ok) { await loadCatManage(); }
      else { mergeBtn.textContent = '合并到'; mergeBtn.disabled = false; }
    };

    const del = document.createElement('button');
    del.type = 'button';
    del.className = 'wb-cat-act wb-cat-del';
    del.textContent = '删除';
    del.onclick = async () => {
      if (!confirm('删除分类「' + c.name + '」？其下 ' + c.count + ' 篇文章将归入「未分类」。')) return;
      del.textContent = '删除中…'; del.disabled = true;
      const ok = await deleteCategory(c);
      if (ok) { await loadCatManage(); }
      else { del.textContent = '删除'; del.disabled = false; }
    };

    // 顺序：重命名 →「合并到」+ 目标下拉 → 删除
    // （「合并到」标签在前、目标下拉在后，读起来是「合并到 [目标]」，且整体位于重命名之后）
    acts.append(renameBtn, mergeBtn, sel, del);
    li.appendChild(acts);
    return li;
  }

  // 渲染「该分类下的文章」列表（行内手风琴展开区）。
  // 数据直接取内存里的 allPosts（loadList 已 select('*') 全量加载），点击即时呈现、无需再请求。
  // 三语文章共用同一个 category_slug，故这里会同时列出各语言版本，用语言标签区分。
  function renderCatPosts(panel, c) {
    panel.innerHTML = '';
    const rows = (allPosts || [])
      .filter((p) => !p.deleted_at && (p.category_slug || 'uncategorized') === c.slug)
      .sort((a, b) => new Date(b.published_at || 0) - new Date(a.published_at || 0));

    if (!rows.length) {
      panel.innerHTML = '<p class="wb-cat-posts-empty">该分类下暂无文章</p>';
      return;
    }

    const head = document.createElement('div');
    head.className = 'wb-cat-posts-head';
    head.innerHTML = `<span>${rows.length} 篇文章</span>`;
    panel.appendChild(head);

    const ul = document.createElement('ul');
    ul.className = 'wb-cat-posts-list';
    rows.forEach((p) => {
      const li = document.createElement('li');
      li.className = 'wb-cat-posts-item';

      // 语言标签
      const langTag = document.createElement('span');
      langTag.className = 'wb-cat-posts-lang';
      langTag.textContent = LANGS[langOf(p)];
      li.appendChild(langTag);

      // 标题
      const title = document.createElement('span');
      title.className = 'wb-cat-posts-title';
      title.textContent = p.title || '(无标题)';
      title.title = p.title || '';
      li.appendChild(title);

      // 状态
      const badge = document.createElement('span');
      badge.className = 'wb-badge ' + (p.published ? 'is-live' : 'is-draft');
      badge.textContent = p.published ? '已发布' : '草稿';
      li.appendChild(badge);

      // 发布时间
      const date = document.createElement('span');
      date.className = 'wb-cat-posts-date';
      date.textContent = p.published_at
        ? new Date(p.published_at).toLocaleDateString('zh-CN')
        : '—';
      li.appendChild(date);

      // 操作：打开编辑器
      const edit = document.createElement('button');
      edit.type = 'button';
      edit.className = 'wb-cat-posts-edit';
      edit.textContent = '编辑';
      edit.onclick = () => openEditor(p);
      li.appendChild(edit);

      ul.appendChild(li);
    });
    panel.appendChild(ul);
  }

  // 进入「重命名」内联编辑态
  function startRename(li, c, all) {
    li.innerHTML = '';
    li.className = 'wb-cat-item wb-cat-item--edit';

    const nameInput = document.createElement('input');
    nameInput.className = 'wb-cat-input';
    nameInput.value = c.name;
    nameInput.placeholder = '中文名（必填）';

    const nameEnInput = document.createElement('input');
    nameEnInput.className = 'wb-cat-input';
    nameEnInput.value = c.name_en || '';
    nameEnInput.placeholder = 'English name（可选）';

    const slugInput = document.createElement('input');
    slugInput.className = 'wb-cat-input';
    slugInput.value = c.slug;
    slugInput.placeholder = 'url-slug';

    const preview = document.createElement('span');
    preview.className = 'wb-cat-slug-preview';
    const renderPreview = () => {
      const s = (slugInput.value.trim() || slugify(nameInput.value) || 'uncategorized');
      preview.textContent = '/' + s;
    };
    nameInput.addEventListener('input', renderPreview);
    slugInput.addEventListener('input', renderPreview);
    renderPreview();

    const msg = document.createElement('span');
    msg.className = 'wb-cat-rename-msg';

    const save = document.createElement('button');
    save.type = 'button';
    save.className = 'wb-cat-act';
    save.textContent = '保存';
    save.onclick = async () => {
      const newName = nameInput.value.trim();
      if (!newName) { msg.textContent = '名称不能为空'; return; }
      let newSlug = slugInput.value.trim();
      if (!newSlug) newSlug = slugify(newName);
      if (!/^[a-z0-9-]+$/.test(newSlug)) { msg.textContent = 'Slug 只能是小写字母、数字和连字符'; return; }
      if (newSlug !== c.slug && all.some((o) => o.slug === newSlug)) { msg.textContent = '该 Slug 已存在'; return; }
      save.textContent = '保存中…'; save.disabled = true;
      const ok = await renameCategory(c, newName, newSlug, nameEnInput.value.trim());
      if (ok) await loadCatManage();
      else { save.textContent = '保存'; save.disabled = false; }
    };

    const cancel = document.createElement('button');
    cancel.type = 'button';
    cancel.className = 'wb-cat-act wb-cat-cancel';
    cancel.textContent = '取消';
    cancel.onclick = () => loadCatManage();

    const row1 = document.createElement('div');
    row1.className = 'wb-cat-rename-row';
    row1.append(nameInput, nameEnInput, slugInput, preview);
    const row2 = document.createElement('div');
    row2.className = 'wb-cat-rename-row';
    row2.append(save, cancel, msg);
    li.append(row1, row2);
    nameInput.focus();
  }

  async function renameCategory(src, newName, newSlug, nameEn = '') {
    // 1) 改写该分类下所有文章的显示名与 slug
    //    注意：posts.category 只是中文名快照，英文名称以 categories 表为准，这里不动。
    const { error } = await supabase
      .from('posts').update({ category: newName, category_slug: newSlug })
      .eq('category_slug', src.slug);
    if (error) { alert('重命名失败：' + error.message); return false; }
    // 同步注册表（best-effort）。name_en 若为空字符串，写入空串（前台会回退中文）。
    try {
      const patch = { name: newName, slug: newSlug, name_en: nameEn || null };
      let { error: regErr } = await supabase
        .from('categories').update(patch).eq('slug', src.slug);
      // 数据库尚未执行迁移（无 name_en 列）时，回退为只改 name/slug，避免整体失败
      if (regErr && /name_en|column/i.test(regErr.message || '')) {
        await supabase.from('categories').update({ name: newName, slug: newSlug }).eq('slug', src.slug);
      }
    } catch {}
    try {
      // 2) 级联：原本指向旧 slug 的别名，改指向新 slug（处理 A→B→C 链路）
      await supabase.from('category_aliases').update({ new_slug: newSlug }).eq('new_slug', src.slug);
      // 3) 写入旧 slug → 新 slug 映射（若旧 slug 已有别名则覆盖）
      await supabase.from('category_aliases').upsert(
        { old_slug: src.slug, new_slug: newSlug },
        { onConflict: 'old_slug' }
      );
    } catch (e) {
      // 别名写入失败不应回滚文章改名，仅提示（重定向会缺失，但内容已就位）
      console.warn('[cat] 写入 slug 别名失败', e);
    }
    return true;
  }

  async function mergeCategory(src, dst) {
    const { error } = await supabase
      .from('posts').update({ category: dst.name, category_slug: dst.slug })
      .eq('category_slug', src.slug);
    if (error) { alert('合并失败：' + error.message); return false; }
    // 同步注册表（best-effort）：确保目标存在，删除源
    // 目标若缺译文，用源分类的英文名补上，避免合并后英文名丢失
    try {
      await supabase.from('categories').upsert(
        {
          name: dst.name,
          slug: dst.slug,
          name_en: dst.name_en || src.name_en || null,
        },
        { onConflict: 'slug' }
      );
      await supabase.from('categories').delete().eq('slug', src.slug);
    } catch {}
    return true;
  }

  async function deleteCategory(src) {
    const { error } = await supabase
      .from('posts').update({ category: '', category_slug: 'uncategorized' })
      .eq('category_slug', src.slug);
    if (error) { alert('删除失败：' + error.message); return false; }
    // 同步删除注册表条目（best-effort）
    try { await supabase.from('categories').delete().eq('slug', src.slug); } catch {}
    return true;
  }

  // ---------- 一键翻译（经 /api/translate 服务端中转调 LLM） ----------
  // 约定：中文原文用 base slug，英文译文用 base-en 后缀（posts.slug 全局唯一；保留 -ja 以兼容历史日文）。
  function baseSlug(slug) {
    return String(slug || '').replace(/-(en|ja)$/, '');
  }

  function setTrMsg(text, kind = '') {
    const el = $('tr-msg');
    if (!el) return;
    el.textContent = text;
    el.dataset.kind = kind;
    // 记录这次提示对应的版本（id + 语言）：切版本后据此判断提示是否已过期
    trMsgFor = { id: String(state.id || ''), lang: state.lang };
  }

  // 按「编辑器当前正在编辑的版本」重新生成 tr-msg 提示。
  // 存在的意义：点语言按钮 / 点译文状态按钮 / 载入历史版本都会换编辑对象，
  // 旧提示留着的语言与 URL 就都是错的（典型现象：切换了版本，提示却还停留在上一个语言）。
  // 因此凡是改变当前编辑版本的操作，末尾都要调它做一次对齐。
  function renderTrMsg() {
    const row = state.id ? allPosts.find((p) => p.id === state.id) : null;
    const label = LANGS[state.lang] || '中文';
    if (!row) {
      // 新建态（含「尚无该语言版本」转入的新建态）——说明将新建该语言版本
      setTrMsg(`当前为新${label}版草稿：发布后即创建${label}版（不影响其它语言版本）`, '');
      return;
    }
    if (row.published) {
      setTrMsg(`正在编辑${label}版（已发布，URL ${postUrl(row)}）；保存并发布后立即生效`, 'ok');
    } else {
      setTrMsg(`正在编辑${label}版（草稿，尚未发布）；发布后读者才能看到`, 'warn');
    }
  }

  // 译文状态行：显示当前文章的英文版是否已存在（按 base slug 匹配内存全量表），
  // 已存在的可点击直接载入该版本（与语言按钮同一套判定：langOf + findVersion）。
  function updateLangState() {
    const el = $('lang-state');
    if (!el) return;
    const cur = state.id ? allPosts.find((p) => p.id === state.id) : null;
    const rawSlug = cur?.slug || $('f-slug').value.trim();
    if (!rawSlug) { el.innerHTML = ''; return; }
    const base = stripLangSuffix(rawSlug);
    const parts = [];
    for (const code of ['en']) {
      const row = findVersion(base, code, state.id);
      parts.push(
        row
          ? `<button type="button" class="wb-langstate-btn has" data-lang="${code}" title="载入${LANGS[code]}版（点击）">${LANGS[code]} ✓</button>`
          : `<span class="wb-langstate-btn">${LANGS[code]} —</span>`
      );
    }
    el.innerHTML = parts.join('');
    el.querySelectorAll('button[data-lang]').forEach((b) => {
      b.onclick = () => {
        const row = findVersion(base, b.dataset.lang, state.id);
        if (row) {
          setForm(row);
          state.dirty = false;
          setMsg(`已载入《${row.title}》`);
          // 这里也是「换编辑对象」：不同步提示就会残留上一个语言的 URL
          renderTrMsg();
        }
      };
    });
    updateSlugStatusMarks();
  }

  // 语言按钮上的版本状态标记：· 未创建 / ○ 已存在（草稿） / ✓ 已发布。
  // 这样不用点进去就知道哪几种语言已经写好了，避免「点了没反应」的困惑。
  function updateSlugStatusMarks() {
    const box = $('f-lang');
    if (!box) return;
    const cur = state.id ? allPosts.find((p) => p.id === state.id) : null;
    const rawSlug = cur?.slug || $('f-slug').value.trim();
    const base = rawSlug ? stripLangSuffix(rawSlug) : '';
    box.querySelectorAll('button[data-v]').forEach((b) => {
      const code = b.dataset.v;
      const label = LANGS[code] === 'EN' ? 'EN' : '中文';
      let mark = '';
      if (base) {
        // 当前正在编辑的这一版，按编辑器里的状态算（未保存的改动也反映出来）
        if (code === state.lang) {
          mark = state.status === 'published' ? '✓' : '○';
        } else {
          const row = findVersion(base, code, state.id);
          mark = row ? (row.published ? '✓' : '○') : '·';
        }
      }
      b.innerHTML = `${label}<span class="wb-lang-mark">${mark}</span>`;
    });
  }

  async function translateTo(targetLang) {
    const title = $('f-title').value.trim();
    const excerpt = $('f-excerpt').value.trim();
    const content = $('f-content').value;
    if (!title || !content.trim()) { setTrMsg('请先填写标题和正文', 'err'); return; }
    if (content.length > 20000) { setTrMsg('正文超过 2 万字，请拆成多篇再译', 'err'); return; }

    // 是否已有该语言的译文行：有 → 载入其框架后覆盖内容（更新）；无 → 以当前文章为蓝本新建
    const cur = state.id ? allPosts.find((p) => p.id === state.id) : null;
    const base = stripLangSuffix(cur?.slug || $('f-slug').value || slugify(title));
    const existing = allPosts.find(
      (p) => p.id !== state.id && stripLangSuffix(p.slug) === base && langOf(p) === targetLang
    );
    const langName = '英文';

    if (!confirm(
      existing
        ? `已存在${langName}版文章。将载入该版本框架，用新译文覆盖其内容，发布后更新线上文章。继续？`
        : `将把当前文章译成${langName}并填入编辑器（不会自动保存）。发布时会创建新的${langName}版文章。继续？`
    )) return;

    const btns = [$('tr-en-btn')];
    btns.forEach((b) => { b.disabled = true; b.style.opacity = '.55'; b.style.pointerEvents = 'none'; });
    setTrMsg(`正在翻译成${langName}，通常 1 分钟内完成；服务繁忙时最长 3 分 20 秒，超时可重试…`, '');
    // 超时护栏：覆盖服务端 503 退避重试（最长约 166 秒）+ 模型生成的全程，避免永久转圈
    const ctrl = new AbortController();
    const timer = setTimeout(() => ctrl.abort(), 200000);
    try {
      const { data: sd } = await supabase.auth.getSession();
      const token = sd?.session?.access_token;
      if (!token) { setTrMsg('会话已过期，请重新登录后再试', 'err'); return; }

      const resp = await fetch('/api/translate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
        body: JSON.stringify({ title, excerpt, content, targetLang }),
        signal: ctrl.signal,
      });
      const result = await resp.json().catch(() => ({}));
      if (!resp.ok) {
        setTrMsg(result.error || `翻译失败（HTTP ${resp.status}）`, 'err');
        return;
      }

      if (existing) {
        setForm(existing); // 保留英文版自己的分类/封面/发布状态，只覆盖三项内容
      } else {
        // 复用统一的「切版本」入口：无该语言版本时它会转入新建态（清 id、slug 拼后缀、置草稿），
        // 发布时 INSERT 译文行，不会覆盖原文。避免与语言按钮各自维护一套切换逻辑。
        switchLangVersion(targetLang);
      }
      $('f-title').value = result.title;
      $('f-excerpt').value = result.excerpt || '';
      $('f-content').value = result.content;
      state.dirty = true;
      renderPreview();
      updateSlugHint();
      updateLangState();
      saveLocalDraft();
      setTrMsg(
        `✓ 译文已填入${result.parts > 1 ? `（长文分 ${result.parts} 段翻译，请重点检查段落衔接）` : ''}。请通读检查后点击「发布」`,
        'ok'
      );
      // setTrMsg 已把 trMsgFor 记成「当前编辑的译文版本」，后续 setForm 不会误判过期而覆盖这条提示
    } catch (e) {
      if (e?.name === 'AbortError') {
        setTrMsg('翻译超时（3 分 20 秒）。服务可能持续繁忙，稍后再点一次试试', 'err');
      } else {
        setTrMsg('网络错误：' + (e?.message || '请求失败') + '（若挂代理，试试切换节点）', 'err');
      }
    } finally {
      clearTimeout(timer);
      btns.forEach((b) => { b.disabled = false; b.style.opacity = ''; b.style.pointerEvents = ''; });
    }
  }

  // ---------- 表单 ----------
  function setForm(p = {}) {
    state.id = p.id || '';
    state.slug = p.slug || '';
    $('f-title').value = p.title || '';
    $('f-slug').value = p.slug || '';
    slugAuto = !p.slug; // 有历史 slug（已发布/已存草稿）→ 不自动派生；新建空白 → 自动
    state.catSlug = p.category_slug || (p.category ? slugify(p.category) : '');
    state.catName = p.category || '';
    renderCategorySelect(state.catSlug, state.catName);
    toggleNewCat(false);
    $('f-excerpt').value = p.excerpt || '';
    $('f-cover').value = p.cover || '';
    $('f-published-at').value = toLocalInput(p.published_at);
    $('published-at-hint').textContent = '修改已发布文章的展示与排序时间；留空则保持原时间';
    $('f-author').value = (p.author || site.author || '').trim();
    $('f-content').value = p.content || '';
    // 访问加密回显：开关与提示语可回显；密码永不回显（DB 端哈希，取了也看不出原文），
    // 留空即「不修改原密码」。wasEncrypted/passHint 记录保存前的状态，供 persist 判增量。
    $('f-encrypted').checked = !!p.is_encrypted;
    $('f-enc-pw').value = '';
    $('f-enc-hint').value = p.pass_hint || '';
    state.wasEncrypted = !!p.is_encrypted;
    state.passHint = p.pass_hint || '';
    toggleEncFields();
    state.lang = p.lang || 'zh';
    state.status = p.published === false ? 'draft' : (p.id ? 'published' : 'draft');
    syncSeg($('f-lang'), state.lang);
    syncSeg($('f-status'), state.status);
    $('delete-btn').hidden = !p.id;
    setMsg('');
    renderPreview();
    updateSlugHint();
    refreshAttachList(); // 载入文章后回填附件面板
    updateLangState();
    state.dirty = false; // 刚载入的行视为「无未保存改动」
    // 提示行与当前版本对齐：仅当它已过期（换了 id 或语言）才重算，
    // 避免冲掉「✓ 译文已填入…」这类刚生成的有效提示。
    if (String(state.id || '') !== trMsgFor.id || state.lang !== trMsgFor.lang) renderTrMsg();
    saveLocalDraft();
  }

  function syncSeg(container, value) {
    container.querySelectorAll('button').forEach((b) => b.classList.toggle('on', b.dataset.v === value));
  }

  // 加密开关 ↔ 密码/提示输入框显隐
  function toggleEncFields() {
    $('enc-fields').hidden = !$('f-encrypted').checked;
  }
  $('f-encrypted').addEventListener('change', toggleEncFields);

  // ISO 时间 → datetime-local 输入值（本地时区 "YYYY-MM-DDTHH:mm"）
  function toLocalInput(iso) {
    if (!iso) return '';
    const d = new Date(iso);
    if (isNaN(d.getTime())) return '';
    const pad = (n) => String(n).padStart(2, '0');
    return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
  }

  function collectRow() {
    const title = $('f-title').value.trim();
    const sel = $('f-category').value;
    let category = '';
    let category_slug = 'uncategorized';
    if (sel === '__new__') {
      const nm = $('new-cat-name').value.trim();
      category = nm;
      category_slug = $('new-cat-slug').value.trim() || slugify(nm) || 'uncategorized';
    } else if (sel) {
      const o = $('f-category').selectedOptions[0];
      category = (o && (o.dataset.name || o.textContent || '')).trim() || '';
      category_slug = sel;
    }
    return {
      title,
      slug: (() => {
        const raw = $('f-slug').value.trim();
        // 裸后缀（如用户切语言但还没填标题时的 "-en"）视为未填，交给 autoSlug 按标题生成
        return (raw && raw !== langSuffix(state.lang)) ? raw : autoSlug(title, state.lang);
      })(),
      lang: state.lang,
      category,
      category_slug,
      excerpt: $('f-excerpt').value.trim(),
      cover: $('f-cover').value.trim(),
      author: $('f-author').value.trim() || (site.author || ''),
      content: $('f-content').value,
      published: state.status === 'published',
      // 发布时间：填写了新时间则随保存写入（ISO/UTC）；留空时不带该键，数据库列保持原值
      published_at: $('f-published-at').value
        ? new Date($('f-published-at').value).toISOString()
        : undefined,
    };
  }

  // 自动生成 Slug。按站点约定：中文用基础名，英文加 -en 后缀，
  // 这样同一篇文章的各语言版本不会因 slug 相同而撞唯一约束。
  function autoSlug(title, lang) {
    const base = slugify(title) || 'post-' + Date.now();
    return base + langSuffix(lang);
  }

  // 语言 → slug 后缀（中文无后缀）
  function langSuffix(lang) {
    return lang === 'en' ? '-en' : '';
  }

  // 剥掉尾部语言后缀。-en（及历史 -ja）反复切换时若只剥一次会叠成 xxx-en-ja，
  // 这里循环剥到稳定（与 baseSlug 的单次剥离分开，不影响译文/媒体的既有匹配口径）
  function stripLangSuffix(slug) {
    let s = String(slug || '');
    let prev;
    do { prev = s; s = s.replace(/-(en|ja)$/, ''); } while (s !== prev);
    return s;
  }

  // 切换语言时同步 slug 后缀：
  //   1) 主体名优先取「已填 slug 剥掉旧后缀」，其次按标题生成 —— 手输内容只保留主体、不被覆盖
  //   2) 剥离后再拼当前语言后缀 —— 来回切换只换后缀，不会重复追加
  //   3) 主体名无从推导时保持空白（绝不写出孤零零的 "-en"），交给保存时 autoSlug 兜底
  function syncSlugWithLang(nextLang, baseOverride) {
    const input = $('f-slug');
    if (!input) return;
    const raw = input.value.trim();
    // 主体名优先级：传入主体 > 已填 slug 剥后缀 > 标题 slugify；三者皆空则主体为空串。
    // 中文无后缀；英文拼后缀——主体为空时即写出裸后缀（如 "-en"），
    // 满足「新建文章切到英文即填 -en、中文保持空白」的诉求。
    let base = baseOverride || stripLangSuffix(raw) || slugify($('f-title').value || '');
    const want = base + langSuffix(nextLang);
    if (input.value.trim() !== want) {
      input.value = want;
      updateSlugHint();
    }
    // 注意：这里不重置 slugAuto。
    //  - 由 switchLangVersion 命中已有版本时，setForm() 已经按该行状态重置过；
    //  - 用户手输过 slug（slugAuto=false）时，切语言只换后缀、必须保留其主体名；
    //  - 新建文章由标题输入处维护自动派生，无需在此重复判定。
  }

  // 判断一行属于哪种语言：优先信任 lang 字段；
  // 但历史数据存在 lang 未填/填错（如 error-and-debug-en 的 lang 仍是 zh），
  // 因此 lang 缺失或与 slug 后缀明显矛盾时，按 slug 后缀兜底推断，保证归组与切换不跑偏。
  // 注：-ja 判定仅为兼容历史日文文章的兜底，前台已无日语，读者侧永不触达。
  function langOf(row) {
    if (!row) return 'zh';
    const declared = row.lang || '';
    const slug = String(row.slug || '');
    if (/-en$/.test(slug)) return declared === 'en' ? 'en' : 'en';
    if (/-ja$/.test(slug)) return declared === 'ja' ? 'ja' : 'ja';
    return declared || 'zh';
  }

  // 在已加载的全量文章里，找「同一篇 + 指定语言」的那一行。
  // excludeId：排除当前正在编辑的行（避免找到自己）；返回 null 表示该语言版本尚不存在。
  // 比较时用 stripLangSuffix 而非 baseSlug：与调用方传入的 base 口径保持一致（都能剥净多重后缀）。
  function findVersion(base, lang, excludeId) {
    return allPosts.find(
      (p) => String(p.id) !== String(excludeId || '') && stripLangSuffix(p.slug) === base && langOf(p) === lang
    ) || null;
  }

  // 切换编辑器当前展示的语言版本——这是语言按钮的核心。
  //   有该语言版本 → setForm(那一行)：标题、摘要、正文、slug、id、发布状态一次性全部换过去
  //   无该语言版本 → 转「新建该语言版本」态：清 id、slug = base + 后缀、置草稿，等作者翻译或撰写
  // 这样点 EN 就真的在看英文内容，而不是只把标识改成英文（历史实现只改标识，会导致中文内容覆盖英文行）。
  function switchLangVersion(nextLang) {
    if (!LANGS[nextLang] || nextLang === state.lang) {
      syncSeg($('f-lang'), state.lang);
      return;
    }

    // 未保存保护：当前内容有改动时先存本地草稿再切，避免切走丢内容
    if (state.dirty) saveLocalDraft();

    const cur = state.id ? allPosts.find((p) => p.id === state.id) : null;
    const rawSlug = ($('f-slug').value || '').trim();
    // 主体名用 stripLangSuffix（循环剥净多重后缀）：手输 dup-en-ja 时主体应为 dup，
    // 若用只剥一层的 baseSlug 会得到 dup-en，再拼 -ja 又变回 dup-en-ja。
    const base = stripLangSuffix(cur?.slug || rawSlug || slugify($('f-title').value || ''));

    // 当前是「新建态」且还没写任何内容：直接换标识即可，不打断输入
    const isBlankNew = !state.id && !$('f-title').value.trim() && !$('f-content').value.trim();

    if (!base) {
      // 连主体名都没有（刚点新建、什么都没填）：只切标识与后缀
      state.lang = nextLang;
      syncSeg($('f-lang'), nextLang);
      syncSlugWithLang(nextLang);
      updateSlugHint();
      updateLangState();
      return;
    }

    const target = findVersion(base, nextLang, state.id);

    if (target) {
      // ① 已有该语言版本 → 整行载入（setForm 会一并换标题/摘要/正文/slug/id/发布状态）
      setForm(target);
      state.dirty = false;
      // 提示统一由 renderTrMsg 按「刚载入的这一行」生成：语言、发布状态、URL 三者
      // 一次性对齐。历史上这里先写一条通用提示、命中已发布时再覆盖一条，
      // 而其它入口（译文状态按钮、草稿恢复）切换后完全不刷新，才出现提示语错位。
      renderTrMsg();
    } else {
      // ② 尚无该语言版本 → 转新建态，slug 以原文 base 为准拼后缀（标题此刻仍是原文，不能按标题推导）
      state.id = '';
      state.lang = nextLang;
      state.status = 'draft';
      syncSeg($('f-lang'), nextLang);
      syncSeg($('f-status'), 'draft');
      $('delete-btn').hidden = true;
      syncSlugWithLang(nextLang, base);
      updateSlugStatusMarks();
      const label = nextLang === 'en' ? '英文' : '中文';
      setTrMsg(
        isBlankNew
          ? `已切到${LANGS[nextLang]}，Slug 已带后缀；该文尚无${label}版，发布将新建`
          : `该文尚无${label}版：已转入新建态（Slug 沿用主体名 + 后缀，状态为草稿）。当前内容仍是原文，请点「译成${label}」生成译文或自行改写后再发布`,
        'warn'
      );
      // 该分支提示语本身信息密度更高（含操作指引），不覆盖，但同样记下所属版本，
      // 后续再发生切换时由 renderTrMsg 接管，避免旧提示残留。

    }

    updateSlugHint();
    updateLangState();
  }

  // 实时提示最终会使用的 Slug（含完整路径，便于直观确认语言与后缀是否一致）
  function updateSlugHint() {
    const el = $('slug-hint');
    if (!el) return;
    const manual = $('f-slug').value.trim();
    const finalSlug = manual || autoSlug($('f-title').value || '（标题）', state.lang);
    const path = `${state.lang === 'zh' ? '' : '/' + state.lang}/posts/${finalSlug}/`;
    let text = (manual ? '将使用：' : '留空则自动生成：') + path;

    const suffix = langSuffix(state.lang);
    if (manual && suffix && !manual.endsWith(suffix)) {
      text += `（当前为${LANGS[state.lang]}，建议以 ${suffix} 结尾；离开输入框会自动补齐）`;
    } else if (manual && state.lang === 'zh' && /-(en|ja)$/.test(manual)) {
      text += '（当前为中文版，建议去掉 -en / -ja 后缀）';
    }
    el.textContent = text;
  }

  // 保存期间禁用按钮，防止快速连点导致两次 INSERT 同一 slug
  function setButtonsBusy(busy) {
    ['save-draft-btn', 'publish-btn', 'delete-btn', 'new-article-btn'].forEach((id) => {
      const b = $(id);
      if (!b) return;
      b.disabled = busy;
      b.style.opacity = busy ? '.55' : '';
      b.style.pointerEvents = busy ? 'none' : '';
    });
  }

  // 解析出可用的 Slug。
  // - 自动生成的：撞车就静默加 -2 / -3 … 直到可用
  // - 用户手填的：撞车就报错让用户自己改（不擅自改动用户输入）
  async function resolveSlug(base, excludeId, manual) {
    let candidate = base;
    for (let i = 0; i < 50; i++) {
      let q = supabase.from('posts').select('id').eq('slug', candidate).limit(1);
      if (excludeId) q = q.neq('id', excludeId);
      const { data, error } = await q;
      if (error) return { slug: candidate, conflict: false, changed: false };
      if (!data || data.length === 0) {
        return { slug: candidate, conflict: false, changed: candidate !== base };
      }
      if (manual) return { slug: candidate, conflict: true, changed: false };
      candidate = `${base}-${i + 2}`;
    }
    return { slug: candidate, conflict: false, changed: true };
  }

  // ---------- 保存 ----------
  async function persist() {
    const row = collectRow();
    if (!row.title) { setMsg('请先填写标题', 'err'); $('f-title').focus(); return null; }

    // 摘要兜底：留空时按设置从正文本地截取（零成本、零失败、不阻断发布）。
    // 只在为空时生成，绝不覆盖手填内容；译文文章的 excerpt 由翻译接口给出，同样不被覆盖。
    let autoExcerpt = false;
    if (!row.excerpt && row.content.trim()) {
      const gen = localExcerpt(row.content, excerptSettings.maxLen);
      if (gen) { row.excerpt = gen; autoExcerpt = true; }
    }

    // 新建分类合法性校验
    if ($('f-category').value === '__new__') {
      const nm = $('new-cat-name').value.trim();
      if (!nm) { setMsg('新建分类请填写显示名', 'err'); $('new-cat-name').focus(); return null; }
      const ns = $('new-cat-slug').value.trim() || slugify(nm);
      if (!/^[a-z0-9-]+$/.test(ns)) {
        setMsg('分类 Slug 只能是小写字母、数字和连字符', 'err'); $('new-cat-slug').focus(); return null;
      }
      if (catOpts.some((c) => c.slug === ns)) {
        setMsg('该分类 Slug 已存在', 'err'); $('new-cat-slug').focus(); return null;
      }
    }

    // 防重复提交：快速连点「发布」会出现两次 INSERT 同一 slug，后一次必撞唯一约束
    if (state.saving) return null;
    state.saving = true;
    setButtonsBusy(true);

    let error;
    try {
      // Slug 唯一性预处理（posts_slug_key 是全局唯一，不按语言区分）
      const manual = $('f-slug').value.trim() !== '';
      const resolved = await resolveSlug(row.slug, state.id || null, manual);
      if (resolved.conflict) {
        setMsg(`Slug「${resolved.slug}」已被其他文章占用，请到「更多设置」换一个`, 'err');
        $('f-slug').focus();
        return null;
      }
      row.slug = resolved.slug;
      if (resolved.changed) {
        setMsg(`Slug 已自动改为可用的：${resolved.slug}`);
        updateSlugHint();
      }

      if (state.id) {
        // P0 防数据损坏：语言归属由「行」本身决定（slug 后缀 + lang 字段），
        // 不允许通过一次 update 把已有行的语言改掉——否则在中文版上误点 EN 再保存，
        // 会把中文那行的 lang 改成 'en'，中文版就"消失"了。换语言必须走 switchLangVersion()。
        const { lang: _omitLang, ...patch } = row;
        ({ error } = await supabase.from('posts').update(patch).eq('id', state.id));
      } else {
        // 新建：作者预设了发布时间则用之，否则取当前时间。
        // is_encrypted 继承：从已加密的文章切到新语言版（新建态）时，新行随整组
        // 一同上锁（组级口径：同一把锁）。未加密文章传 undefined，键被 JSON 丢弃，
        // 不碰该列——数据库尚未执行 encryption.sql 时也不会报错。
        // .select('id')：insert 默认返回整行（含 pass_hash，已 revoke 会报权限错），
        // 显式只要 id。
        const r = await supabase.from('posts')
          .insert({ ...row, is_encrypted: state.wasEncrypted || undefined, published_at: row.published_at || new Date().toISOString() })
          .select('id');
        error = r.error;
        if (!error && r.data?.[0]) state.id = r.data[0].id;
      }
      // 附件补关联：上传时文章尚无 slug（新建首存）→ 此刻按最终 slug 回填 media.post_slug，
      // 否则附件永远挂空（post_slug=null），正文页底部附件区与后台附件列表都取不到
      if (!error) {
        const oldBase = state.slug ? baseSlug(state.slug) : '';
        const newBase = baseSlug(row.slug);
        // slug 基准名变更（用户改过 slug）：旧归属下的媒体（正文图 + 附件）迁到新 base，
        // 否则它们既不再随文章展示、删文章时也不会被清理，成为无声泄漏
        if (oldBase && oldBase !== newBase) {
          try {
            await supabase.from('media').update({ post_slug: newBase }).eq('post_slug', oldBase);
          } catch {}
        }
        if (pendingAttach.size) {
          try {
            await supabase.from('media').update({ post_slug: newBase }).in('path', [...pendingAttach]);
          } catch {}
          pendingAttach.clear();
        }
        state.slug = row.slug;
        refreshAttachList();
      }
      // 访问加密：经 SECURITY DEFINER RPC 走（密码 DB 端 bcrypt 哈希，绝不进普通 update）。
      // 三种路径：开加密+填新密码 → post_set_password（同时写提示语）；
      //           开加密+未填密码+原本已加密 → 仅更新提示语（普通 update，authenticated 有权限）；
      //           取消勾选+原本已加密 → post_clear_encryption。
      // 新建分支里 state.id 已在 insert 后回填，此处两种场景都拿得到 id。
      if (!error) {
        const encOn = $('f-encrypted').checked;
        const encPw = $('f-enc-pw').value;
        const encHint = $('f-enc-hint').value.trim();
        try {
          if (encOn && encPw) {
            if (encPw.length < 4) { setMsg('访问密码至少 4 位', 'err'); return null; }
            const { error: e2 } = await supabase.rpc('post_set_password', { p_id: state.id, p_pw: encPw, p_hint: encHint });
            if (e2) throw e2;
          } else if (encOn && state.wasEncrypted) {
            if (encHint !== (state.passHint || '')) {
              const { error: e3 } = await supabase.from('posts').update({ pass_hint: encHint }).eq('id', state.id);
              if (e3) throw e3;
            }
          } else if (encOn) {
            setMsg('请设置访问密码（至少 4 位）', 'err');
            return null;
          } else if (state.wasEncrypted) {
            const { error: e4 } = await supabase.rpc('post_clear_encryption', { p_id: state.id });
            if (e4) throw e4;
          }
        } catch (e2) {
          setMsg('加密设置保存失败：' + (e2.message || e2), 'err');
          return null;
        }
        state.wasEncrypted = encOn;
        state.passHint = encHint;
      }
      // 新建分类：同步写入注册表（best-effort，categories 表未建也不影响文章发布）
      if (!error && $('f-category').value === '__new__' && row.category) {
        try {
          await supabase.from('categories').upsert(
            { name: row.category, slug: row.category_slug },
            { onConflict: 'slug' }
          );
        } catch {}
      }
    } finally {
      state.saving = false;
      setButtonsBusy(false);
    }

    if (error) {
      // 兜底：万一预处理之后仍撞约束（并发等），给出可操作的提示
      if (/duplicate key|posts_slug_key|unique/i.test(error.message)) {
        setMsg(`保存失败：Slug「${row.slug}」已存在。请打开「更多设置」修改 Slug 后重试`, 'err');
      } else {
        setMsg('保存失败：' + error.message, 'err');
      }
      return null;
    }
    $('delete-btn').hidden = !state.id;
    row.autoExcerpt = autoExcerpt;
    return row;
  }

  async function saveDraft() {
    state.status = 'draft';
    syncSeg($('f-status'), 'draft');
    const row = await persist();
    if (!row) return;
    setMsg(row.excerpt ? '草稿已保存' + (row.autoExcerpt ? '（摘要已按正文自动生成）' : '') : '草稿已保存', 'ok');
    clearLocalDraft();
    await loadList();
  }

  async function publish() {
    state.status = 'published';
    syncSeg($('f-status'), 'published');
    const row = await persist();
    if (!row) return;
    // SSR 模式：写入 Supabase 即对全站生效，读者刷新即可看到，无需触发任何构建
    setMsg('已发布 ✓ 已即时生效，读者刷新即可看到' + (row.autoExcerpt ? '；摘要已按正文自动生成' : ''), 'ok');
    clearLocalDraft();
    await loadList();
  }

  // ---------- 文章列表 ----------
  let allPosts = [];

  // 垃圾箱保留天数（与 supabase/posts_trash.sql 的 purge_expired_posts 默认值保持一致）
  const TRASH_KEEP_DAYS = 5;

  // 剩余保留天数：null 表示不在垃圾箱；<=0 表示已过期（等待下次清理）
  function trashDaysLeft(deletedAt) {
    if (!deletedAt) return null;
    const deadline = new Date(deletedAt).getTime() + TRASH_KEEP_DAYS * 86400000;
    return Math.ceil((deadline - Date.now()) / 86400000);
  }

  function renderList() {
    const ul = $('post-list');
    ul.innerHTML = '';
    const q = state.query.trim().toLowerCase();
    const inTrash = state.filter === 'trash';

    // 按 base slug 分组：同一篇文章的各语言版本合并为一行展示。
    // 分组键同时兼容两种多语言约定：「同 slug + lang 区分」与「slug 后缀 -en（兼容历史 -ja）」。
    const groupMap = new Map();
    for (const p of allPosts) {
      const key = baseSlug(p.slug);
      if (!groupMap.has(key)) groupMap.set(key, []);
      groupMap.get(key).push(p);
    }
    const langOrder = { zh: 0, en: 1 };
    const allRows = [...groupMap.values()].map((posts) => {
      const sorted = [...posts].sort(
        (a, b) => (langOrder[langOf(a)] ?? 9) - (langOrder[langOf(b)] ?? 9)
      );
      return { rep: sorted[0], versions: sorted };
    });

    // 垃圾箱视图：只看「整组都在垃圾箱」的文章（移入以整组为单位，故组内状态一致）；
    // 常规视图：只看「整组都不在垃圾箱」的文章。两视图互斥，同一篇文章不会重复出现。
    const rows = allRows.filter(({ versions }) => {
      const groupInTrash = versions.every((p) => p.deleted_at);
      if (inTrash !== groupInTrash) return false;
      const okFilter = inTrash || state.filter === 'all'
        || versions.some((p) => (state.filter === 'published' ? p.published : !p.published));
      const okQuery = !q || versions.some((p) => (p.title || '').toLowerCase().includes(q));
      return okFilter && okQuery;
    });
    // 垃圾箱按移入时间倒序；常规列表按发布时间倒序
    if (inTrash) {
      rows.sort((a, b) => new Date(b.rep.deleted_at || 0) - new Date(a.rep.deleted_at || 0));
    } else {
      rows.sort((a, b) => new Date(b.rep.published_at || 0) - new Date(a.rep.published_at || 0));
    }

    const totalTrash = allPosts.filter((p) => p.deleted_at).length;
    $('wb-count').textContent = inTrash
      ? `${rows.length} 篇在垃圾箱（保留 ${TRASH_KEEP_DAYS} 天）`
      : `${rows.length} 篇 / 共 ${allPosts.filter((p) => !p.deleted_at).length} 版`;
    const badge = $('trash-count');
    if (badge) { badge.textContent = String(totalTrash); badge.hidden = totalTrash === 0; }

    if (!rows.length) {
      ul.innerHTML = inTrash ? '<li class="wb-empty">垃圾箱是空的</li>' : '<li class="wb-empty">没有匹配的文章</li>';
      return;
    }

    rows.forEach(({ rep, versions }) => {
      const li = document.createElement('li');
      li.className = 'wb-item' + (versions.some((p) => p.id === state.id) ? ' on' : '');

      // 主体：标题 = 前台文章链接，默认跳中文页面（代表版 zh 优先；zh 缺失时回退组内首个版本）
      const main = document.createElement('div');
      main.className = 'wb-item-main';
      const d = rep.published_at ? new Date(rep.published_at).toLocaleDateString('zh-CN') : '';
      const url = postUrl(rep);
      // 语言标签：组内每个已存在的语言一个可点击标签，点击直接载入该版本进编辑器
      const langTags = versions
        .map((v) => {
          // 用 langOf 而非裸 v.lang：历史脏数据（如 error-and-debug-en 的 lang 仍是 zh）
          // 会显示成多个「中文」，按 slug 后缀兜底才能正确标出 EN（兼容历史 ja）。
          const code = langOf(v);
          return `<button type="button" class="wb-item-lang" data-id="${v.id}" title="编辑${LANGS[code] || code}版">${LANGS[code] || code}</button>`;
        })
        .join('');
      main.innerHTML = inTrash
        ? `<span class="wb-item-title is-trash">${escapeHtml(rep.title || '(无标题)')}</span>
           <span class="wb-item-meta">
             <span class="wb-badge is-trash">垃圾箱</span>
             <span class="wb-date">移入 ${rep.deleted_at ? new Date(rep.deleted_at).toLocaleDateString('zh-CN') : '—'}</span>
             <span class="wb-trash-left" title="移入 ${TRASH_KEEP_DAYS} 天后自动彻底删除">${(() => { const L = trashDaysLeft(rep.deleted_at); return L === null ? '' : (L <= 0 ? '即将清理' : '剩 ' + L + ' 天'); })()}</span>
             <span class="wb-item-langs">${langTags}</span>
           </span>`
        : `<a class="wb-item-title" href="${escapeHtml(url)}" target="_blank" rel="noopener" title="在新标签打开前台文章页">${escapeHtml(rep.title || '(无标题)')}</a>
         <span class="wb-item-meta">
           <span class="wb-badge ${rep.published ? 'is-live' : 'is-draft'}">${rep.published ? '已发布' : '草稿'}</span>
           ${rep.is_encrypted ? '<span class="wb-badge is-enc" title="访问加密：前台需输入密码解锁；不进列表/搜索/sitemap">🔒 加密</span>' : ''}
           <span class="wb-date">${d}</span>
           <span class="wb-item-langs">${langTags}</span>
           <span class="wb-author">${escapeHtml(rep.author || site.author || '')}</span>
         </span>`;

      main.querySelectorAll('.wb-item-lang').forEach((b) => {
        b.onclick = () => {
          const v = versions.find((x) => String(x.id) === b.dataset.id);
          if (v) openEditor(v);
        };
      });

      // 右侧操作区：常规行＝编辑/移入垃圾箱；垃圾箱行＝恢复/彻底删除。均以整组（全部语言版本）为单位
      const acts = document.createElement('div');
      acts.className = 'wb-item-acts';
      const ids = versions.map((v) => v.id);

      if (inTrash) {
        const restore = document.createElement('button');
        restore.type = 'button';
        restore.className = 'wb-item-edit';
        restore.textContent = '恢复';
        restore.title = '恢复到文章列表（含全部语言版本）';
        restore.onclick = async () => {
          restore.disabled = true; restore.textContent = '恢复中…';
          const { error } = await supabase.from('posts').update({ deleted_at: null }).in('id', ids);
          if (error) { alert('恢复失败：' + error.message); restore.disabled = false; restore.textContent = '恢复'; return; }
          await loadList();
        };

        const purge = document.createElement('button');
        purge.type = 'button';
        purge.className = 'wb-item-del';
        purge.textContent = '彻底删除';
        purge.title = '立即永久删除，无法恢复';
        purge.onclick = async () => {
          if (!confirm('彻底删除《' + (rep.title || '无标题') + '》？\n含全部语言版本，此操作不可恢复。')) return;
          purge.disabled = true; purge.textContent = '删除中…';
          // 先清文件（趁 media 记录还在，按 base slug 精确定位），再删文章本体
          const fm = await purgeMediaForPost(rep.slug);
          const { error } = await supabase.from('posts').delete().in('id', ids);
          if (error) { alert('删除失败：' + error.message); purge.disabled = false; purge.textContent = '彻底删除'; return; }
          if (fm.removed || fm.failed) {
            setMsg(`已删除文章，并清理 ${fm.removed} 个关联文件${fm.failed ? '（' + fm.failed + ' 个失败）' : ''}`, 'ok');
          }
          if (versions.some((p) => p.id === state.id)) setForm({});
          await loadList();
        };

        acts.append(restore, purge);
      } else {
        const edit = document.createElement('button');
        edit.type = 'button';
        edit.className = 'wb-item-edit';
        edit.textContent = '编辑';
        // 默认打开「最近发布/更新过的那一版」，符合"刚改完哪版就继续改哪版"的直觉。
        // 注意：posts 表没有 updated_at 列（带上该列会 400），故以 published_at 为准，都没有则回退中文版。
        // 其他语言可点左侧语言标签直达。
        const recent = [...versions].sort((a, b) => {
          const ta = new Date(a.published_at || 0).getTime() || 0;
          const tb = new Date(b.published_at || 0).getTime() || 0;
          return tb - ta;
        })[0] || rep;
        edit.title = versions.length > 1
          ? `打开最近修改的${LANGS[langOf(recent)]}版；其他语言请点左侧语言标签`
          : '在编辑器中打开修改';
        edit.onclick = () => openEditor(recent);

        const del = document.createElement('button');
        del.type = 'button';
        del.className = 'wb-item-del';
        del.textContent = '删除';
        del.title = '移入垃圾箱（含全部语言版本），' + TRASH_KEEP_DAYS + ' 天后自动彻底删除';
        del.onclick = async () => {
          const tip = versions.length > 1 ? `（含 ${versions.length} 个语言版本）` : '';
          if (!confirm('将《' + (rep.title || '无标题') + '》' + tip + '移入垃圾箱？\n' + TRASH_KEEP_DAYS + ' 天内可恢复，超期自动彻底删除。')) return;
          del.disabled = true; del.textContent = '处理中…';
          const { error } = await supabase.from('posts')
            .update({ deleted_at: new Date().toISOString() }).in('id', ids);
          if (error) { alert('删除失败：' + error.message); del.disabled = false; del.textContent = '删除'; return; }
          if (versions.some((p) => p.id === state.id)) setForm({});
          await loadList();
        };

        acts.append(edit, del);
      }

      li.append(main, acts);
      ul.append(li);
    });
  }

  // 生成该文章对应的前台 URL（zh 为默认语言，无前缀）
  function postUrl(p) {
    const langPrefix = p.lang && p.lang !== 'zh' ? '/' + p.lang : '';
    return langPrefix + '/posts/' + (p.slug || '') + '/';
  }

  async function loadList() {
    // 超期自动清理：把「移入垃圾箱超过 TRASH_KEEP_DAYS 天」的文章物理删除。
    // 依赖 Supabase 侧 purge_expired_posts()（security definer，仅登录用户可调），
    // 由后台加载时触发——免费档无需 Cron/Worker，打开后台即完成清理。
    // 失败不影响列表加载（如尚未执行 posts_trash.sql 时会报函数不存在，静默忽略）。
    // 关键：先查出即将被删的文章 → 清掉它们的文件 → 再执行 DB 删除，
    //       否则文章行没了就查不到归属 slug，文件会永久残留。
    try {
      const cutoff = new Date(Date.now() - TRASH_KEEP_DAYS * 86400000).toISOString();
      const { data: expired } = await supabase.from('posts')
        .select('slug').not('deleted_at', 'is', null).lt('deleted_at', cutoff);
      if (expired && expired.length) {
        for (const p of expired) await purgeMediaForPost(p.slug);
      }
      const { data: purged } = await supabase.rpc('purge_expired_posts', { p_days: TRASH_KEEP_DAYS });
      if (purged > 0) setMsg(`已自动清理 ${purged} 篇超期文章及其关联文件`, 'ok');
    } catch (e) { /* 函数未部署或网络异常：忽略，不阻塞列表 */ }

    // 显式列清单（不含 pass_hash）：该列已对 anon/authenticated revoke，
    // select('*') 会报权限错；显式列举同时兼容缺加密列的旧库（自动回退全列）。
    const POST_COLS = 'id,title,slug,content,excerpt,cover,published,published_at,created_at,lang,category,category_slug,author,deleted_at,is_encrypted,pass_hint';
    let { data, error } = await supabase
      .from('posts').select(POST_COLS).order('published_at', { ascending: false });
    if (error && /does not exist/i.test(error.message || '')) {
      // 旧库未执行 encryption.sql：回退全列（此时也没有 pass_hash 权限收窄）
      ({ data, error } = await supabase
        .from('posts').select('*').order('published_at', { ascending: false }));
    }
    if (error) { $('post-list').innerHTML = '<li class="wb-empty">读取失败：' + error.message + '</li>'; return; }
    // pass_hash 不进入后台前端（双保险：查询层已不取该列，此处再挡一道）
    allPosts = (data || []).map(({ pass_hash, ...rest }) => rest);
    loadCategoryOptions();
    renderList();
    updateLangState();
  }

  // 加载编辑器「分类」下拉选项：注册表优先，缺表则回退文章去重分类
  let catOpts = [];
  async function loadCategoryOptions() {
    const sel = $('f-category');
    if (!sel) return;
    try {
      const { data, error } = await supabase.from('categories').select('name, slug').order('name');
      if (!error && data) catOpts = data;
    } catch { catOpts = []; }
    if (!catOpts.length) {
      catOpts = [...new Set(allPosts.map((p) => p.category_slug).filter(Boolean))]
        .map((s) => ({ name: s, slug: s }));
    }
    renderCategorySelect(state.catSlug, state.catName);
  }

  function opt(value, text, name) {
    const o = document.createElement('option');
    o.value = value;
    o.textContent = text;
    if (name != null) o.dataset.name = name;
    return o;
  }

  // 渲染分类下拉：无分类 / 已有分类 / 当前值（历史脏数据兜底）/ 新建
  function renderCategorySelect(curSlug, curName) {
    const sel = $('f-category');
    if (!sel) return;
    sel.innerHTML = '';
    sel.appendChild(opt('', '（无分类）'));
    catOpts.forEach((c) => sel.appendChild(opt(c.slug, c.name || c.slug, c.name || c.slug)));
    const inList = !curSlug || catOpts.some((c) => c.slug === curSlug);
    if (curSlug && !inList) sel.appendChild(opt(curSlug, curName || curSlug, curName || curSlug));
    sel.value = curSlug || '';
    sel.appendChild(opt('__new__', '＋ 新建分类…'));
    toggleNewCat(sel.value === '__new__');
  }

  function toggleNewCat(show) {
    const box = $('new-cat-box');
    if (box) box.hidden = !show;
    if (show) { updateNewCatPreview(); const n = $('new-cat-name'); if (n) n.focus(); }
  }

  function updateNewCatPreview() {
    const el = $('new-cat-preview');
    if (!el) return;
    const s = ($('new-cat-slug').value.trim() || slugify($('new-cat-name').value) || 'uncategorized');
    el.textContent = '/' + s;
  }

  function updateCatAddPreview() {
    const el = $('cat-add-preview');
    if (!el) return;
    const s = ($('cat-add-slug').value.trim() || slugify($('cat-add-name').value) || 'uncategorized');
    el.textContent = '/' + s;
  }

  // 分类管理：新增分类（写入注册表，0 篇也会在前台显示）
  async function addCategory() {
    const name = $('cat-add-name').value.trim();
    const nameEn = ($('cat-add-name-en')?.value || '').trim();
    const msg = $('cat-add-msg');
    if (!name) { msg.textContent = '请填写中文名'; return; }
    let slug = $('cat-add-slug').value.trim() || slugify(name);
    if (!/^[a-z0-9-]+$/.test(slug)) { msg.textContent = 'Slug 只能是小写字母、数字和连字符'; return; }
    if (catOpts.some((c) => c.slug === slug)) { msg.textContent = '该 Slug 已存在'; return; }
    const saveBtn = $('cat-add-save');
    saveBtn.disabled = true; saveBtn.textContent = '保存中…';
    // 先带中英写入；若数据库尚无 name_en 列则回退为只写 name/slug（部署顺序不受限）
    let { error } = await supabase.from('categories').insert({
      name, slug, name_en: nameEn || null,
    });
    if (error && /name_en|column/i.test(error.message || '')) {
      ({ error } = await supabase.from('categories').insert({ name, slug }));
    }
    saveBtn.disabled = false; saveBtn.textContent = '保存';
    if (error) { msg.textContent = '失败：' + error.message; return; }
    $('cat-add-box').hidden = true;
    $('cat-add-name').value = ''; $('cat-add-slug').value = ''; $('cat-add-preview').textContent = '';
    if ($('cat-add-name-en')) $('cat-add-name-en').value = '';
    await loadCatManage();
    await loadCategoryOptions();
  }

  function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  }

  // ---------- Markdown 预览 ----------
  let previewTimer;
  function renderPreview() {
    clearTimeout(previewTimer);
    previewTimer = setTimeout(() => {
      $('preview').innerHTML = marked.parse($('f-content').value || '') || '<p class="wb-hint">暂无内容</p>';
      // 与前台（renderMarkdown 服务端包裹）同规则：表格包进 .wb-table-scroll，
      // 保证预览与线上展示一致——窄表收缩留白、宽表 wrapper 内横向滚动。
      // 幂等：父节点已是 wrapper 则跳过，避免重复嵌套。
      $('preview').querySelectorAll('table').forEach((t) => {
        if (t.parentElement && t.parentElement.classList.contains('wb-table-scroll')) return;
        const wrap = document.createElement('div');
        wrap.className = 'wb-table-scroll';
        t.parentNode.insertBefore(wrap, t);
        wrap.appendChild(t);
      });
    }, 120);
  }

  // ---------- 本地自动保存 ----------
  let autosaveTimer;
  // 草稿按语言分键：切到「尚无该语言版本」的新建态时，三语的未保存内容不会互相覆盖
  function draftKey(lang = state.lang) { return `${DRAFT_KEY}:${lang || 'zh'}`; }

  function saveLocalDraft() {
    clearTimeout(autosaveTimer);
    autosaveTimer = setTimeout(() => {
      const snap = { ...collectRow(), id: state.id, _ts: Date.now() };
      if (!snap.title && !snap.content) return;
      try { localStorage.setItem(draftKey(), JSON.stringify(snap)); } catch {}
    }, 700);
  }

  function clearLocalDraft() { try { localStorage.removeItem(draftKey()); } catch {} }

  function restoreLocalDraft() {
    try {
      // 依次尝试各语言草稿键，恢复最近保存的那一份（旧版单键也兼容读取）
      const keys = [draftKey('zh'), draftKey('en'), DRAFT_KEY];
      let snap = null, bestTs = 0;
      for (const k of keys) {
        const raw = localStorage.getItem(k);
        if (!raw) continue;
        const s = JSON.parse(raw);
        const ts = Number(s._ts || 0);
        if (!snap || ts > bestTs) { snap = s; bestTs = ts; }
      }
      if (!snap) return;
      if (snap.id) return; // 只恢复「新建」场景
      openEditor(snap);
      setMsg('已恢复上次未保存的内容', 'ok');
    } catch {}
  }

  // ---------- 图片上传 ----------
  // 存储 key 走 S3 安全字符白名单（Supabase Storage 对中文/emoji/%/# 等一律 400 Invalid key）。
  // 原文件名只用于取扩展名和可读前缀：先 NFKD 归一化（é→e），再剥离一切非 [a-z0-9-] 字符，
  // 保证任何文件名（微信截图、emoji、纯符号、无扩展名）都能上传成功。
  const IMAGE_EXTS = ['png', 'jpg', 'jpeg', 'gif', 'webp', 'svg', 'avif', 'bmp'];
  function safeImagePath(name) {
    const raw = String(name || '');
    const ext = (raw.toLowerCase().match(/\.([a-z0-9]{2,5})$/) || [])[1];
    const base = raw
      .replace(/\.[a-z0-9]{2,5}$/i, '')
      .normalize('NFKD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .replace(/\s+/g, '-')
      .replace(/[^a-z0-9-]/g, '')
      .replace(/-+/g, '-')
      .replace(/^-|-$/g, '')
      .slice(0, 40);
    return `${Date.now()}-${base || 'image'}.${IMAGE_EXTS.includes(ext) ? ext : 'png'}`;
  }

  // 附件扩展名白名单（与 supabase/media_library.sql 的 allowed_mime_types 对应）
  const ATTACH_EXTS = ['pdf', 'doc', 'docx', 'ppt', 'pptx', 'xls', 'xlsx', 'csv', 'txt', 'md', 'zip'];
  // 按扩展名判定归属 bucket：图片 → images，其余白名单 → attachments
  function bucketFor(name) {
    const ext = (String(name || '').toLowerCase().match(/\.([a-z0-9]{1,8})$/) || [])[1] || '';
    if (IMAGE_EXTS.includes(ext)) return 'images';
    if (ATTACH_EXTS.includes(ext)) return 'attachments';
    return 'images'; // 未知类型按图片处理（保持旧行为）
  }

  // 生成 storage 路径：时间戳 + ASCII 安全名 + 白名单扩展名（图片与附件通用）
  // allowImageExt：目标桶为 attachments 时，图片附件也要保留原扩展名（png/jpg…），
  // 否则会被打成 .bin（下载名虽由 original_name 决定，但 URL 与内联分发都应是真实类型）
  function safeUploadPath(name, isImage, allowImageExt) {
    const raw = String(name || '');
    const ext = (raw.toLowerCase().match(/\.([a-z0-9]{1,8})$/) || [])[1] || '';
    const base = raw
      .replace(/\.[a-z0-9]{1,8}$/i, '')
      .normalize('NFKD').replace(/[\u0300-\u036f]/g, '')
      .toLowerCase().replace(/\s+/g, '-')
      .replace(/[^a-z0-9-]/g, '')
      .replace(/-+/g, '-').replace(/^-|-$/g, '')
      .slice(0, 40);
    const allow = isImage ? IMAGE_EXTS : (allowImageExt ? [...IMAGE_EXTS, ...ATTACH_EXTS] : ATTACH_EXTS);
    const safeExt = allow.includes(ext) ? ext : (isImage || allowImageExt ? 'png' : 'bin');
    return `${Date.now()}-${base || (isImage ? 'image' : 'file')}.${safeExt}`;
  }

  // 记录文件归属（写 media 表）。失败不阻断上传——文件已传成功，仅少一条索引记录。
  async function recordMedia({ path, bucket, originalName, mime, size }) {
    try {
      await supabase.from('media').upsert({
        path, bucket,
        post_slug: state.slug ? baseSlug(state.slug) : null,
        original_name: originalName || '', mime: mime || '', size_bytes: size || 0,
      }, { onConflict: 'path' });
    } catch (e) { console.warn('[admin] media 记录写入失败（不影响上传）', e); }
  }

  // 上传单个文件到指定 bucket（默认按扩展名自动分流；附件面板可强制 attachments 桶）。
  // 上传后登记 media 归属。返回 { bucket, isImg, path, publicUrl }。
  async function uploadOne(file, forceBucket) {
    const bucket = forceBucket || bucketFor(file.name);
    const isImg = bucket === 'images';
    const path = safeUploadPath(file.name, isImg, bucket === 'attachments');
    const { error } = await supabase.storage
      .from(bucket)
      .upload(path, file, { upsert: true, contentType: file.type || undefined });
    if (error) throw error;
    const publicUrl = supabase.storage.from(bucket).getPublicUrl(path).data.publicUrl;
    await recordMedia({ path, bucket, originalName: file.name, mime: file.type, size: file.size });
    if (!state.slug) pendingAttach.add(path); // 文章尚无 slug：保存成功后补关联
    return { bucket, isImg, path, publicUrl };
  }

  // 「插入文件」：图片插入正文（Markdown 图片语法）；非图片不再塞进正文，
  // 而是作为附件登记（进入正文页底部「附件」区），避免正文被下载链接污染。
  async function uploadImages(files) {
    const msg = $('upload-msg');
    const imgs = [];
    for (const file of files) {
      msg.textContent = `上传中 ${file.name}…`;
      try {
        const r = await uploadOne(file);
        if (r.isImg) imgs.push(`![](${r.publicUrl})`);
        else msg.textContent = `「${file.name}」已作为附件（显示在文章底部，不插入正文）✓`;
      } catch (e) {
        msg.textContent = '上传失败：' + e.message;
        return;
      }
    }
    if (imgs.length) {
      insertAtCursor(imgs.join('\n'));
      msg.textContent = `已插入 ${imgs.length} 张图片 ✓`;
    }
    await refreshAttachList();
  }

  // 附件面板：上传到 attachments 桶（无论图片/文档），刷新列表。不触碰正文。
  async function uploadAttachment(files) {
    const msg = $('attach-msg');
    for (const file of files) {
      msg.textContent = `上传中 ${file.name}…`;
      try {
        await uploadOne(file, 'attachments');
      } catch (e) {
        msg.textContent = '上传失败：' + e.message;
        return;
      }
    }
    msg.textContent = '已上传 ✓';
    await refreshAttachList();
  }

  // 刷新附件列表（后台用登录态读 media，非公开视图）。
  async function refreshAttachList() {
    const ul = $('attach-list');
    if (!ul) return;
    const base = state.slug ? baseSlug(state.slug) : null;
    if (!base) { ul.innerHTML = '<li class="wb-hint">保存文章后可管理附件</li>'; return; }
    const { data, error } = await supabase
      .from('media')
      .select('path, original_name, mime')
      .eq('post_slug', base)
      .eq('bucket', 'attachments')
      .order('created_at', { ascending: true });
    if (error) { ul.innerHTML = ''; return; }
    if (!data || !data.length) { ul.innerHTML = '<li class="wb-hint">暂无附件</li>'; return; }
    ul.innerHTML = '';
    for (const m of data) {
      const url = supabase.storage.from('attachments').getPublicUrl(m.path).data.publicUrl;
      const li = document.createElement('li');
      li.innerHTML = `<a href="${url}" target="_blank" rel="noopener">${escapeHtml(m.original_name || m.path)}</a>`;
      const del = document.createElement('button');
      del.type = 'button';
      del.className = 'wb-attach-del';
      del.textContent = '删除';
      del.onclick = () => removeAttachment(m.path);
      li.appendChild(del);
      ul.appendChild(li);
    }
  }

  // 删除单个附件：清 storage 对象 + media 记录，再刷新列表。
  async function removeAttachment(path) {
    if (!confirm('删除该附件？此操作不可恢复。')) return;
    await supabase.storage.from('attachments').remove([path]).catch(() => {});
    await supabase.from('media').delete().eq('path', path).catch(() => {});
    await refreshAttachList();
  }

  function insertAtCursor(text) {
    const ta = $('f-content');
    const start = ta.selectionStart ?? ta.value.length;
    const end = ta.selectionEnd ?? ta.value.length;
    const before = ta.value.slice(0, start);
    const after = ta.value.slice(end);
    const pad = (before && !before.endsWith('\n') ? '\n' : '') + text + '\n';
    ta.value = before + pad + after;
    ta.focus();
    ta.selectionStart = ta.selectionEnd = before.length + pad.length;
    renderPreview();
    saveLocalDraft();
  }

  // ---------- 未配置 Supabase ----------
  if (!SUPABASE_URL || !KEY) {
    $('cfg-note').hidden = false;
    $('login-form').querySelector('button').disabled = true;
    showLogin();
  } else {
    supabase = createClient(SUPABASE_URL, KEY, { auth: { persistSession: true, autoRefreshToken: true } });

    // 登录
    $('login-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      $('login-msg').textContent = '登录中…';
      const { error } = await supabase.auth.signInWithPassword({
        email: $('email').value, password: $('password').value,
      });
      if (error) { $('login-msg').textContent = '失败：' + error.message; return; }
      $('login-msg').textContent = '';
      restoreLocalDraft();
      await showWorkbench();
    });

    // 退出
    $('logout-btn').addEventListener('click', async () => {
      await supabase.auth.signOut();
      showLogin();
    });

    // 模块导航：文章管理 / 评论管理 / 其他功能
    $('wb-modnav').querySelectorAll('button').forEach((b) => {
      b.onclick = () => switchModule(b.dataset.mod);
    });

    // 操作按钮
    $('save-draft-btn').onclick = saveDraft;
    $('publish-btn').onclick = publish;
    $('new-article-btn').onclick = () => openEditor();
    // 关闭弹窗只能点右上角 ✕：防止误触空白处/Esc 导致未保存内容被关掉
    $('editor-close').onclick = closeEditor;
    $('cd-save').onclick = saveCountdown;
    $('ex-save').onclick = saveExcerptSettings;
    $('ai-excerpt-btn').onclick = () => aiGenerateExcerpt();

    // 站点设置 → 头像：选择文件（隐藏 input 承接）/ 上传 / 删除
    $('avatar-pick').onclick = () => $('avatar-input').click();
    $('avatar-input').onchange = (e) => {
      const f = e.target.files?.[0];
      if (!f) return;
      // 未登录直接拦下，避免走一遍必然是 401 的上传
      supabase.auth.getSession().then(({ data }) => {
        if (!data?.session) { setAvatarMsg('请先登录后台再上传头像', 'err'); $('avatar-input').value = ''; return; }
        uploadAvatar(f);
      });
    };
    $('avatar-remove').onclick = removeAvatar;
    $('avatar-hist-btn').onclick = () => {
      if (avatarHistory.length === 0) return;      // 无历史不展开空区域
      toggleAvatarHistory();
    };
    $('avatar-hist-clear').onclick = clearAvatarHistory;
    // 缩小窗口/横向滚动时若面板已展开，重算高度，避免文字换行后高度停留旧值
    window.addEventListener('resize', () => {
      if (!avatarHistOpen) return;
      const panel = $('avatar-hist-panel');
      if (panel && !panel.hidden) panel.style.height = 'auto';
    });

    // 分类管理：新增分类
    $('cat-add-btn').onclick = () => {
      const box = $('cat-add-box');
      box.hidden = !box.hidden;
      if (!box.hidden) { $('cat-add-name').focus(); updateCatAddPreview(); }
    };
    $('cat-add-save').onclick = addCategory;
    $('cat-add-cancel').onclick = () => { $('cat-add-box').hidden = true; $('cat-add-msg').textContent = ''; };
    $('cat-add-name').addEventListener('input', updateCatAddPreview);
    $('cat-add-slug').addEventListener('input', updateCatAddPreview);

    // 一键翻译
    $('tr-en-btn').onclick = () => translateTo('en');

    // 文件管理：筛选 / 搜索 / 上传 / 清理 / 刷新
    $('fm-filter').querySelectorAll('button').forEach((b) => b.onclick = () => {
      fmState.filter = b.dataset.f;
      $('fm-filter').querySelectorAll('button').forEach((x) => x.classList.toggle('on', x === b));
      renderMedia();
    });
    $('fm-search').oninput = (e) => { fmState.query = e.target.value; renderMedia(); };
    $('fm-refresh').onclick = () => loadMedia();
    $('fm-clean-orphans').onclick = () => cleanOrphans();
    $('fm-upload-input').onchange = async (e) => {
      const files = [...(e.target.files || [])];
      e.target.value = '';
      if (!files.length) return;
      const msg = $('fm-msg');
      let done = 0;
      for (const f of files) {
        msg.textContent = `上传中 ${f.name}…`;
        const bucket = bucketFor(f.name);
        const isImg = bucket === 'images';
        const path = safeUploadPath(f.name, isImg);
        const { error } = await supabase.storage.from(bucket).upload(path, f, { upsert: true, contentType: f.type || undefined });
        if (error) { msg.textContent = '上传失败：' + error.message; return; }
        await recordMedia({ path, bucket, originalName: f.name, mime: f.type, size: f.size });
        done++;
      }
      msg.textContent = `已上传 ${done} 个文件 ✓`;
      await loadMedia();
    };

    // 评论管理：状态筛选
    $('cm-filter').querySelectorAll('button').forEach((b) => b.onclick = () => {
      cmState.filter = b.dataset.f;
      $('cm-filter').querySelectorAll('button').forEach((x) => x.classList.toggle('on', x === b));
      loadComments();
    });

    // 评论管理：实时订阅（管理员侧，审核/删除后自动刷新）
    try {
      supabase
        .channel('admin-comments')
        .on('postgres_changes', { event: '*', schema: 'public', table: 'comments' }, () => loadComments())
        .subscribe();
    } catch (e) { console.warn('[admin] comments realtime 订阅失败（不影响手动刷新）', e); }
    $('delete-btn').onclick = async () => {
      if (!state.id) return;
      const { data: cur } = await supabase.from('posts').select('title').eq('id', state.id).single();
      if (!confirm('将《' + (cur?.title || '无标题') + '》移入垃圾箱？\n' + TRASH_KEEP_DAYS + ' 天内可在「垃圾箱」恢复，超期自动彻底删除。')) return;
      // 软删除：仅标记 deleted_at；前台 RLS 立即隐藏，5 天后由 purge_expired_posts 清理
      const { error } = await supabase.from('posts')
        .update({ deleted_at: new Date().toISOString() }).eq('id', state.id);
      if (error) { setMsg('删除失败：' + error.message, 'err'); return; }
      setForm({});
      setMsg('已移入垃圾箱', 'ok');
      await loadList();
      closeEditor();
    };

    // 分段控件：语言 / 状态
    // 语言切换 = 切换版本：有该语言版本则整行载入（标题/摘要/正文一起换），无则转新建态。
    // 具体逻辑见 switchLangVersion()——不再只改标识与 slug 后缀。
    $('f-lang').querySelectorAll('button').forEach((b) => b.onclick = () => {
      switchLangVersion(b.dataset.v);
    });
    $('f-status').querySelectorAll('button').forEach((b) => b.onclick = () => {
      state.status = b.dataset.v; syncSeg($('f-status'), state.status);
    });

    // 视图 Tab
    $('wb-tabs').querySelectorAll('button').forEach((b) => b.onclick = () => {
      $('wb-tabs').querySelectorAll('button').forEach((x) => x.classList.toggle('on', x === b));
      $('wb-editor').dataset.tab = b.dataset.tab;
      if (b.dataset.tab !== 'edit') renderPreview();
    });

    // 列表筛选 / 搜索
    $('wb-filter').querySelectorAll('button').forEach((b) => b.onclick = () => {
      state.filter = b.dataset.f;
      $('wb-filter').querySelectorAll('button').forEach((x) => x.classList.toggle('on', x === b));
      renderList();
    });
    $('wb-search').addEventListener('input', (e) => { state.query = e.target.value; renderList(); });

    // 正文输入：预览 + 自动保存
    $('f-content').addEventListener('input', () => { state.dirty = true; renderPreview(); saveLocalDraft(); });
    ['f-title', 'f-excerpt', 'f-cover', 'f-slug', 'f-author'].forEach((id) => {
      $(id).addEventListener('input', () => {
        if (id === 'f-title') {
          updateSlugHint();
          // 新建文章且处于自动派生模式：标题即 slug 主体，按当前语言拼后缀，让 slug 实时跟随
          if (slugAuto && !state.id) {
            $('f-slug').value = slugify($('f-title').value || '') + langSuffix(state.lang);
            updateSlugHint();
          }
        }
        if (id === 'f-slug') {
          // 用户手动改了 slug → 退出自动派生，避免被标题/语言切换覆盖
          slugAuto = false;
          updateSlugHint();
        }
        state.dirty = true;
        saveLocalDraft();
      });
    });
    // Slug 失焦时按当前语言规整一次后缀：英文补 -en，已有旧后缀（含历史 -ja）则替换而非叠加。
    // 放在 blur 而非 input 上，避免边打字边被改写；中文态不强制去后缀，只在提示里建议。
    $('f-slug').addEventListener('blur', () => {
      const suffix = langSuffix(state.lang);
      const raw = $('f-slug').value.trim();
      if (!suffix || !raw) return;
      const want = stripLangSuffix(raw) + suffix;
      if (want !== raw) {
        $('f-slug').value = want;
        updateSlugHint();
        saveLocalDraft();
      }
    });
    // 发布时间：改动即存草稿；选了晚于当前的时间时提示「无定时发布，仅影响展示/排序」
    $('f-published-at').addEventListener('change', (e) => {
      const v = e.target.value;
      const hint = $('published-at-hint');
      if (v && new Date(v).getTime() > Date.now() + 60_000) {
        hint.textContent = '该时间晚于当前：未启用定时发布，文章仍会立即上线，此时间仅影响展示与排序';
      } else {
        hint.textContent = '修改已发布文章的展示与排序时间；留空则保持原时间';
      }
      saveLocalDraft();
    });
    // 分类下拉 / 新建分类输入
    $('f-category').addEventListener('change', () => {
      toggleNewCat($('f-category').value === '__new__');
      saveLocalDraft();
    });
    ['new-cat-name', 'new-cat-slug'].forEach((id) => {
      $(id).addEventListener('input', () => { updateNewCatPreview(); saveLocalDraft(); });
    });

    // 图片上传
    $('f-image').addEventListener('change', (e) => {
      if (e.target.files?.length) uploadImages([...e.target.files]);
      e.target.value = '';
    });

    // 附件上传（独立面板，不进正文）
    $('f-attach').addEventListener('change', (e) => {
      if (e.target.files?.length) uploadAttachment([...e.target.files]);
      e.target.value = '';
    });

    // ---------- 粘贴：图片直接上传插入；网页复制的图片转 Markdown ----------
    // 纯文本粘贴走浏览器默认行为（已验证可用），这里只补齐图片场景
    $('f-content').addEventListener('paste', (e) => {
      const cd = e.clipboardData;
      if (!cd) return;

      // 1) 剪贴板中的图片文件：截图、或从文件夹复制的图片
      const files = [];
      if (cd.items) {
        for (const it of cd.items) {
          if (it.kind === 'file' && it.type.startsWith('image/')) {
            const f = it.getAsFile();
            if (f) files.push(f);
          }
        }
      }
      if (!files.length && cd.files) {
        for (const f of cd.files) if (f.type.startsWith('image/')) files.push(f);
      }
      if (files.length) {
        e.preventDefault();
        uploadImages(files);
        return;
      }

      // 2) 从网页复制的图片：text/html 中含 <img src="...">，转成 Markdown 图片语法
      const html = cd.getData('text/html');
      if (html && /<img\b[^>]*\ssrc=/i.test(html)) {
        const urls = [...html.matchAll(/<img\b[^>]*?\ssrc=["']([^"']+)["']/gi)]
          .map((m) => m[1])
          .filter((u) => /^https?:\/\//i.test(u));
        if (urls.length) {
          e.preventDefault();
          insertAtCursor(urls.map((u) => `![](${u})`).join('\n'));
          $('upload-msg').textContent = `已插入 ${urls.length} 张图片 ✓`;
        }
      }
    });

    // 已有会话直接进工作台
    supabase.auth.getSession()
      .then(({ data }) => { if (data.session) showWorkbench(); else showLogin(); })
      .catch(() => showLogin());

    // D2：会话状态监听——主动退出 / 令牌过期 / 异地登出 任一发生都自动回到登录界面
    try {
      supabase.auth.onAuthStateChange((_event, session) => {
        if (!session) showLogin();
      });
    } catch (e) { console.warn('[admin] 会话监听注册失败（不影响手动退出）', e); }
  }
</script>
