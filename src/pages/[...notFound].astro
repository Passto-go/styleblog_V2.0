---
// 兜底 404：捕获所有未匹配的路由，返回真正的 404 状态码。
//
// 为什么需要（2026-10-25 实测）：
//   Astro 5 + @astrojs/cloudflare 在 `output: 'server'` 下，未匹配到任何路由时
//   Worker 内部会抛出异常，Cloudflare 把它转成 1101 错误页，最终访客看到 HTTP 500。
//   实测 /nonexistent-page、/api/no-such-endpoint 全部返回 500 而非 404。
//
//   危害：
//     · SEO —— 搜索引擎把 500 视为「服务器故障」，会反复重试并降低整站抓取频率；
//       而 404 会被正常归档、不再浪费抓取预算。
//     · 排障 —— 500 掩盖了真实故障来源，无法区分「页面不存在」与「服务挂了」。
//     · 用户体验 —— 看到 Cloudflare 冷冰冰的 1101 页面，而不是站点自己的 404 页。
//
//   本文件用 catch-all 路由接住所有落空请求，显式返回 404 + 站点自己的 404 布局。
//   注意：不能预渲染，必须 SSR 才能在运行时接住任意路径。
import Base from '../layouts/Base.astro';

export const prerender = false;

// 显式声明 404 状态码；同时加 noindex，避免搜索引擎收录兜底页
Astro.response.status = 404;
Astro.response.headers.set('X-Robots-Tag', 'noindex');
---

<Base lang="zh" title="404" robots="noindex, nofollow">
  <section class="page" style="text-align:center; padding: 80px 0;">
    <h1 class="page-title">404</h1>
    <p class="lead">页面不存在 / Page not found</p>
    <p><a class="btn" href="/">返回首页 / Home</a></p>
  </section>
</Base>
