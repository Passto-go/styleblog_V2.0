---
import PostPage from '../../../components/pages/PostPage.astro';
import FourOhFour from '../../404.astro';
import { getPostWithVersions } from '../../../lib/posts.js';
import { verifyUnlockCookie } from '../../../lib/unlock.js';

// SSR：每请求现查 Supabase，新文章发布后即刻可访问，无需重新构建
const { slug } = Astro.params;
// getPostWithVersions：按语言级联解析正文版本（目标→英文→中文），并带回各语言可用性
const versions = (await getPostWithVersions(slug, 'zh')) || null;
if (!versions) Astro.response.status = 404;

// 加密文章解锁判定：组级口径——versions.encrypted 为真时（该文任一行设了密码），
// 校验 HMAC 签名 cookie（baseSlug 级，跨语言共享）。非加密文章默认放行（unlocked=true）。
// 未解锁则不向前端传正文/摘要，从根源避免正文进入 HTML 源码。
let unlocked = true;
let passHint = '';
if (versions && versions.encrypted) {
  unlocked = await verifyUnlockCookie(Astro.cookies.get('unlocked')?.value, versions.base, (Astro.locals as any).runtime?.env);
  passHint = versions.passHint || '';
  // 加密内容不参与公共缓存（避免未解锁 HTML 被边缘节点缓存后误吐给他人）
  Astro.response.headers.set('Cache-Control', 'private, no-store');
}

// 未解锁时剥离正文与摘要（pass_hash 已在 normalize 层剔除，此处进一步不传内容）。
// teaser 模式（versions.listVisible）例外：摘要本就设计为公开露出，锁定态也展示，
// 与「列表可见、点击输密码」的承诺一致；正文在任何解锁态下都不出 HTML。
const safePost = versions
  ? {
      ...versions.post,
      content: unlocked ? versions.post.content : '',
      excerpt: unlocked || versions.listVisible ? versions.post.excerpt : '',
    }
  : null;
---
{versions && safePost ? (
  <PostPage
    lang="zh"
    post={safePost}
    versions={versions}
    unlocked={unlocked}
    listVisible={!!versions.listVisible}
    passHint={passHint}
  />
) : (
  <FourOhFour lang="zh" />
)}
