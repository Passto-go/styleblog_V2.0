---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { useTranslations, localizePath, languages } from '../i18n/ui.js';

const {
  lang = 'zh',
  title = '',
  description = '',
  bodyClass = '',
  langHrefs = null,
  image = '',
  type = 'website',
  robots = 'index, follow',
} = Astro.props;

const t = useTranslations(lang);
const siteName = t('site.name');
const pageTitle = title ? `${title} · ${siteName}` : siteName;
const desc = description || t('site.description');

const path = Astro.url.pathname;
const canonical = Astro.site ? new URL(path, Astro.site).href : path;
// path 是当前已本地化的路径（如 /en/archive/），需先还原成默认语言基准路径，再分别本地化
const basePath = path.replace(/^\/(en)(?=\/|$)/, '') || '/';
// langHrefs（文章页传入）：目标语言对应文章的真实地址；缺省回退按基准路径本地化
const altFor = (l) => (langHrefs && langHrefs[l]) || localizePath(basePath, l);
const zhHref = altFor('zh');
const enHref = altFor('en');

// ---- 社交分享（Open Graph / Twitter Card）----
// 抓取器只认「绝对 URL」的图片地址；未指定时回退到站点默认分享图
const ogImage = image
  ? (image.startsWith('http') ? image : Astro.site ? new URL(image, Astro.site).href : image)
  : Astro.site ? new URL('/og-default.png', Astro.site).href : '/og-default.png';
---
<!doctype html>
<html lang={languages[lang].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // 昼夜自动主题：优先用用户手动选择；否则按本地时间（19:00–07:00 为夜间）
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          var theme = saved;
          if (theme !== 'light' && theme !== 'dark') {
            var h = new Date().getHours();
            theme = (h >= 19 || h < 7) ? 'dark' : 'light';
          }
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />

    <link rel="alternate" hreflang="zh-CN" href={zhHref} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="x-default" href={zhHref} />

    <link rel="alternate" type="application/rss+xml" title="RSS" href={localizePath('/rss.xml', lang)} />

    <!-- 社交分享卡片：Facebook/微博/微信(部分)/Discord 等读 og:*，Twitter 读 twitter:* -->
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body class={bodyClass}>
    <Header lang={lang} langHrefs={langHrefs} />
    <main class="container">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
